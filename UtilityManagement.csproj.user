      <SubType>XtraReport</SubType>
    </Compile>
    <Compile Update="Reports\rptDieselGeneratorCost.cs">
      <SubType>XtraReport</SubType>
    </Compile>
    <Compile Update="Reports\rptElectricityConsumption.cs">
      <SubType>XtraReport</SubType>
    </Compile>
    <Compile Update="Reports\rptNgGeneratorCost.cs">
      <SubType>XtraReport</SubType>
    </Compile>
    <Compile Update="Reports\rptRebCost.cs">
      <SubType>XtraReport</SubType>
    </Compile>
    <Compile Update="Reports\rptSolarCost.cs">
      <SubType>XtraReport</SubType>
    </Compile>
    <Compile Update="Reports\rptSteamConsumption.cs">
      <SubType>XtraReport</SubType>
