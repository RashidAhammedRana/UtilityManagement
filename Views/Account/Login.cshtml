@model UtilityManagement.ViewModels.LoginViewModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Login</title>

    <!-- CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" rel="stylesheet" />

    <!-- JS (ORDER IS IMPORTANT) -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>

    <style>

        /* =========================================================
                   BASE
                ========================================================= */

        html,
        body {
            width: 100%;
            height: 100%;
            margin: 0;
            padding: 0;
        }

        body {
            overflow: hidden;
        }


        /* =========================================================
                   LOGIN PAGE
                   SAME DESIGN - ONLY RESPONSIVE
                ========================================================= */

        .login-page {
            position: fixed;
            inset: 0;
            width: 100%;
            height: 100%;
            background-image: url('/images/UtilityManagement_BG.png');
            background-repeat: no-repeat;
            /*
                     * Keep your original background positioning
                     */
            background-position: center top;
            background-size: cover;
            display: flex;
            justify-content: center;
            align-items: center;
            /*
                     * Prevent card touching screen edge
                     */
            padding: 20px;
            overflow-y: auto;
        }


            /* =========================================================
                   DARK OVERLAY
                ========================================================= */

            .login-page::before {
                content: "";
                position: absolute;
                inset: 0;
                background: rgba(0, 0, 0, 0.55);
                z-index: 1;
                pointer-events: none;
            }


        /* =========================================================
                   LOGIN CARD
                ========================================================= */

        .login-card {
            position: relative;
            z-index: 2;
            /*
                     * Responsive width
                     */
            width: 500px;
            max-width: 100%;
            /*
                     * Keep your original padding
                     */
            padding: 35px;
            border-radius: 18px;
            background: rgba(255, 255, 255, 0.12);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.2);
            box-shadow: 0 10px 35px rgba(0, 0, 0, 0.3);
            color: white;
            /*
                     * YOUR ORIGINAL RIGHT SHIFT
                     *
                     * It will only work on desktop.
                     */
            transform: translateX(80px);
        }


        /* =========================================================
                   LOGO
                ========================================================= */

        .logo {
            display: block;
            margin: 0 auto 10px auto;
            /*
                     * Responsive logo
                     */
            width: auto;
            max-width: 180px;
            max-height: 100px;
            object-fit: contain;
        }


        /* =========================================================
                   TITLE
                ========================================================= */

        .login-title {
            font-weight: 700;
            text-align: center;
            margin: 0;
            line-height: 1.3;
        }


        /* =========================================================
                   SUBTITLE
                ========================================================= */

        .login-subtitle {
            text-align: center;
            font-size: 14px;
            margin-bottom: 20px;
            color: rgba(255, 255, 255, 0.85);
        }


        /* =========================================================
                   INPUT
                ========================================================= */

        .form-control {
            width: 100%;
            min-height: 44px;
            background: rgba(255, 255, 255, 0.15);
            border: 1px solid transparent;
            color: white;
            border-radius: 6px;
        }


            .form-control::placeholder {
                color: rgba(255, 255, 255, 0.7);
            }


            .form-control:focus {
                box-shadow: none;
                border: 1px solid #0d6efd;
                background: rgba(255, 255, 255, 0.2);
                color: white;
            }


        /* =========================================================
                   LABEL
                ========================================================= */

        label {
            color: rgba(255, 255, 255, 0.9);
            font-size: 14px;
        }


        /* =========================================================
                   LOGIN BUTTON
                ========================================================= */

        .btn-login {
            background: #0d6efd;
            border: none;
            font-weight: 600;
            min-height: 44px;
        }


            .btn-login:hover {
                background: #0b5ed7;
            }


        /* =========================================================
                   TOAST FIX
                ========================================================= */

        #toast-container {
            z-index: 999999 !important;
        }


        .toast-success {
            background-color: #28a745 !important;
            color: white !important;
            font-weight: 600;
        }


        .toast-error {
            background-color: #dc3545 !important;
            color: white !important;
            font-weight: 600;
        }


        /* =========================================================
                   LARGE DESKTOP

                   1920 x 1080
                   2560 x 1440
                   etc.
                ========================================================= */

        @@media (min-width: 1600px) {
            .login-page

        {
            padding: 30px;
        }

        .login-card {
            width: 500px;
            padding: 35px;
            /*
                         * Keep your original 80px shift
                         * on large desktop.
                         */
            transform: translateX(80px);
        }

        }


        /* =========================================================
                   NORMAL DESKTOP / LAPTOP

                   1200 - 1599
                ========================================================= */

        @@media (min-width: 1200px)
        and (max-width: 1599px) {
            .login-page

        {
            padding: 25px;
        }

        .login-card {
            width: 480px;
            padding: 32px;
            /*
                         * Smaller shift for laptop
                         */
            transform: translateX(40px);
        }

        }


        /* =========================================================
                   SMALL LAPTOP

                   992 - 1199
                ========================================================= */

        @@media (min-width: 992px)
        and (max-width: 1199px) {
            .login-page

        {
            padding: 20px;
        }

        .login-card {
            width: 450px;
            max-width: 100%;
            padding: 30px;
            /*
                         * Small shift
                         */
            transform: translateX(20px);
        }

        .logo {
            max-width: 165px;
        }

        }


        /* =========================================================
                   TABLET

                   768 - 991
                ========================================================= */

        @@media (min-width: 768px)
        and (max-width: 991px) {
            .login-page

        {
            padding: 20px;
        }

        .login-card {
            width: 440px;
            max-width: 100%;
            padding: 30px;
            /*
                         * Center card
                         */
            transform: translateX(0);
        }

        .logo {
            max-width: 160px;
        }

        }


        /* =========================================================
                   MOBILE

                   767px and below
                ========================================================= */

        @@media (max-width: 767px) {
            .login-page

        {
            /*
                         * Mobile full screen
                         */
            position: fixed;
            inset: 0;
            width: 100%;
            height: 100vh;
            height: 100dvh;
            /*
                         * Keep same background
                         */
            background-position: center center;
            background-size: cover;
            /*
                         * Center card
                         */
            display: flex;
            align-items: center;
            justify-content: center;
            /*
                         * Mobile spacing
                         */
            padding: 15px;
            /*
                         * Allow scrolling if necessary
                         */
            overflow-y: auto;
        }


        .login-card {
            /*
                         * IMPORTANT
                         *
                         * Card will NEVER exceed
                         * mobile screen width.
                         */
            width: 100%;
            max-width: 430px;
            /*
                         * Smaller padding
                         */
            padding: 28px 22px;
            border-radius: 16px;
            /*
                         * REMOVE DESKTOP SHIFT
                         */
            transform: none;
        }


        .logo {
            max-width: 150px;
            max-height: 85px;
            margin-bottom: 10px;
        }


        .login-title {
            font-size: 19px;
            line-height: 1.35;
        }


        .login-subtitle {
            font-size: 13px;
            margin-bottom: 20px;
        }


        .form-control {
            min-height: 44px;
            font-size: 14px;
        }


        label {
            font-size: 13px;
        }


        .btn-login {
            min-height: 44px;
            font-size: 14px;
        }

        }


        /* =========================================================
                   SMALL MOBILE

                   400px and below
                ========================================================= */

        @@media (max-width: 400px) {
            .login-page

        {
            padding: 10px;
        }


        .login-card {
            width: 100%;
            max-width: 100%;
            padding: 22px 17px;
            border-radius: 14px;
        }


        .logo {
            max-width: 125px;
            max-height: 70px;
            margin-bottom: 8px;
        }


        .login-title {
            font-size: 17px;
        }


        .login-subtitle {
            font-size: 12px;
            margin-bottom: 17px;
        }


        .form-control {
            min-height: 42px;
            font-size: 14px;
        }


        label {
            font-size: 12px;
        }


        .btn-login {
            min-height: 42px;
            font-size: 14px;
        }

        }


        /* =========================================================
                   MOBILE LANDSCAPE / SHORT SCREEN

                   Example:
                   812 x 375
                   896 x 414
                ========================================================= */

        @@media (max-height: 600px) {
            .login-page

        {
            align-items: flex-start;
            padding-top: 15px;
            padding-bottom: 15px;
        }


        .login-card {
            margin-top: 5px;
            margin-bottom: 5px;
        }

        }


        /* =========================================================
                   SHORT LAPTOP

                   Example:
                   1366 x 600
                ========================================================= */

        @@media (min-width: 768px)
        and (max-height: 650px) {
            .login-page

        {
            align-items: flex-start;
            padding-top: 15px;
            padding-bottom: 15px;
        }


        .login-card {
            margin-top: 10px;
            margin-bottom: 10px;
        }

        }
    </style>
</head>


<body>

    <div class="login-page">

        <div class="login-card">

            <!-- LOGO -->
            <img src="~/images/cotton_club_bd_ltd.jpg"
                 class="logo"
                 alt="Cotton Club BD Ltd" />


            <!-- TITLE -->
            <h5 class="login-title">
                Welcome to Utility Management
            </h5>


            <p class="login-subtitle">
                Please login to continue
            </p>


            <!-- FORM -->
            <form asp-action="Login"
                  method="post"
                  autocomplete="on">

                <div asp-validation-summary="ModelOnly"
                     class="text-danger small">
                </div>


                <!-- USERNAME -->
                <div class="mb-3">

                    <label>
                        Username
                    </label>

                    <input asp-for="Email"
                           class="form-control"
                           autocomplete="username"
                           placeholder="Enter username" />

                </div>


                <!-- PASSWORD -->
                <div class="mb-3">

                    <label>
                        Password
                    </label>

                    <input asp-for="Password"
                           type="password"
                           class="form-control"
                           autocomplete="current-password"
                           placeholder="Enter password" />

                </div>


                <!-- REMEMBER ME -->
                <div class="form-check mb-3">

                    <input asp-for="RememberMe"
                           class="form-check-input" />

                    <label class="form-check-label">
                        Remember Me
                    </label>

                </div>


                <!-- LOGIN -->
                <button type="submit"
                        class="btn btn-login w-100">

                    Login

                </button>

            </form>

        </div>

    </div>


    <!-- TOAST SCRIPT -->

    <script>

        $(function () {

            toastr.options = {

                closeButton: true,

                progressBar: true,

                positionClass: "toast-top-right",

                timeOut: 1000,

                newestOnTop: true,

                preventDuplicates: true
            };


            var successMessage =
                "@(TempData["SuccessMessage"] as string ?? "")";


            var errorMessage =
                "@(TempData["ErrorMessage"] as string ?? "")";


            if (successMessage.length > 0) {

                toastr.success(
                    successMessage,
                    "Success"
                );

            }


            if (errorMessage.length > 0) {

                toastr.error(
                    errorMessage,
                    "Error"
                );

            }

        });

    </script>

</body>

</html>
