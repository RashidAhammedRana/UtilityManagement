                                                   class="form-control closing-stock" readonly />
                                            <span asp-validation-for="DenimJhutClosing"
                                                  class="text-danger"></span>
                                        </div>

                                        <div class="col-md-6">
                                            <label asp-for="DenimJhutTotalCost" class="form-label">
                                                Total Cost
                                            </label>
                                            <input asp-for="DenimJhutTotalCost"
                                                   id="DenimJhutTotalCost"
                                                   type="number" step="0.01" min="0"
                                                   class="form-control" readonly />
                                            <span asp-validation-for="DenimJhutTotalCost"
                                                  class="text-danger"></span>
                                        </div>

                                    </div>
                                </div>
                            </div>

                            <div class="d-flex justify-content-between mt-4">

                                <button type="button"
                                        class="btn btn-outline-secondary prev-btn"
                                        data-prev="1">
                                    ← Previous
                                </button>

                                <button type="button"
                                        class="btn btn-primary next-btn"
                                        data-next="3">
                                    Next →
                                </button>

                            </div>
                        </div>


                        <!-- =========================================
                             STEP 3 - CHARCOAL
                        ========================================== -->

                        <div class="step-content" id="step3">

                            <div class="card border-0 shadow-sm mb-4">

                                <div class="card-header bg-light">
                                    <h6 class="mb-0">Charcoal Stock & Consumption</h6>
                                </div>

                                <div class="card-body">
                                    <div class="row g-3">

                                        <div class="col-md-6">
                                            <label asp-for="CharcoalOpening" class="form-label">
                                                Opening Stock
                                            </label>
                                            <input asp-for="CharcoalOpening"
                                                   id="CharcoalOpening"
                                                   type="number" step="0.01" min="0"
                                                   class="form-control" readonly />
                                            <span asp-validation-for="CharcoalOpening"
                                                  class="text-danger"></span>
                                        </div>

                                        <div class="col-md-6">
                                            <label asp-for="CharcoalReceive" class="form-label">
                                                Receive
                                            </label>
                                            <input asp-for="CharcoalReceive"
                                                   id="CharcoalReceive"
                                                   type="number" step="0.01" min="0"
                                                   class="form-control"/>
                                            <span asp-validation-for="CharcoalReceive"
                                                  class="text-danger"></span>
                                        </div>

                                        <div class="col-md-6">
                                            <label asp-for="CharcoalB1Cons" class="form-label">
                                                Boiler 1 Consumption
                                            </label>
                                            <input asp-for="CharcoalB1Cons"
                                                   id="CharcoalB1Cons"
                                                   type="number" step="0.01" min="0"
                                                   class="form-control"/>
                                            <span asp-validation-for="CharcoalB1Cons"
                                                  class="text-danger"></span>
                                        </div>

                                        <div class="col-md-6">
                                            <label asp-for="CharcoalB2Cons" class="form-label">
                                                Boiler 2 Consumption
                                            </label>
                                            <input asp-for="CharcoalB2Cons"
                                                   id="CharcoalB2Cons"
                                                   type="number" step="0.01" min="0"
                                                   class="form-control"/>
                                            <span asp-validation-for="CharcoalB2Cons"
                                                  class="text-danger"></span>
                                        </div>

                                        <div class="col-md-6">
                                            <label asp-for="CharcoalTotalCons" class="form-label">
                                                Total Consumption
                                            </label>
                                            <input asp-for="CharcoalTotalCons"
                                                   id="CharcoalTotalCons"
                                                   type="number" step="0.01"
                                                   class="form-control" readonly />
                                            <span asp-validation-for="CharcoalTotalCons"
                                                  class="text-danger"></span>
                                        </div>

                                        <div class="col-md-6">
                                            <label asp-for="CharcoalClosing" class="form-label">
                                                Closing Stock
                                            </label>
                                            <input asp-for="CharcoalClosing"
                                                   id="CharcoalClosing"
                                                   type="number" step="0.01"
                                                   class="form-control closing-stock" readonly />
                                            <span asp-validation-for="CharcoalClosing"
                                                  class="text-danger"></span>
                                        </div>

                                        <div class="col-md-6">
                                            <label asp-for="CharcoalTotalCost" class="form-label">
