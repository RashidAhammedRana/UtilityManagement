@model UtilityManagement.Models.TblBiomassStockConsumption

@{
    ViewData["Title"] = "Create Biomass Stock & Consumption Info.";
}

<link rel="stylesheet" href="~/css/create-responsive.css" />

<style>
    .step-content {
        display: none !important;
        width: 100%;
    }

        .step-content.active {
            display: block !important;
            animation: stepFadeIn 0.3s ease-in-out;
        }

    @@keyframes stepFadeIn {
        from {
            opacity: 0;
            transform: translateX(10px);
        }

        to {
            opacity: 1;
            transform: translateX(0);
        }
    }

    /* =========================================
               STEPPER LAYOUT - FIVE STEPS
            ========================================= */

    .stepper-wrapper {
        position: relative;
        width: 100%;
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 30px;
    }

    .stepper-line {
        position: absolute;
        top: 20px;
        left: 10%;
        right: 10%;
        height: 4px;
        background-color: #dee2e6;
        border-radius: 10px;
        z-index: 0;
        overflow: hidden;
    }

    .stepper-line-progress {
        position: absolute;
        top: 0;
        left: 0;
        width: 0%;
        height: 100%;
        background-color: #0d6efd;
        transition: width 0.4s ease;
    }

    .step {
        position: relative;
        z-index: 1;
        width: 20%;
        text-align: center;
        cursor: pointer;
    }

    .step-circle {
        width: 42px;
        height: 42px;
        line-height: 42px;
        border-radius: 50%;
        background-color: #dee2e6;
        color: #495057;
        margin: 0 auto 8px;
        font-weight: 700;
        position: relative;
        z-index: 2;
    }

    .step-title {
        font-size: 13px;
        font-weight: 600;
        color: #6c757d;
    }

    .step.active .step-circle,
    .step.completed .step-circle {
        background-color: #0d6efd;
        color: #fff;
    }

    .step.active .step-title,
    .step.completed .step-title {
        color: #0d6efd;
    }

    @@media (max-width: 576px) {
        .step-circle {
            width: 34px;
            height: 34px;
            line-height: 34px;
            font-size: 13px;
        }

        .step-title {
            font-size: 10px;
        }

        .stepper-line {
            top: 16px;
        }
    }
</style>

<div class="container create-page">
    <div class="row justify-content-center">
        <div class="col-md-10 create-wrapper">

            <div class="card shadow-lg border-0 create-card">

                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">
                        Add New Biomass Stock & Consumption Info.
                    </h5>
                </div>

                <div class="card-body p-4 create-body">

                    <form asp-action="Create"
                          method="post"
                          class="create-form"
                          id="biomassForm">

                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>

                        <!-- STEPPER -->
                        <div class="stepper-wrapper">

                            <div class="stepper-line">
                                <div class="stepper-line-progress"
                                     id="stepperProgress">
                                </div>
                            </div>

                            <div class="step active" data-step="1">
                                <div class="step-circle">1</div>
                                <div class="step-title">Sewing Biomass</div>
                            </div>

                            <div class="step" data-step="2">
                                <div class="step-circle">2</div>
                                <div class="step-title">Denim Biomass</div>
                            </div>

                            <div class="step" data-step="3">
                                <div class="step-circle">3</div>
                                <div class="step-title">Charcoal</div>
                            </div>

                            <div class="step" data-step="4">
                                <div class="step-circle">4</div>
                                <div class="step-title">Carton</div>
                            </div>

                            <div class="step" data-step="5">
                                <div class="step-circle">5</div>
                                <div class="step-title">Plastic Poly</div>
                            </div>

                        </div>

                        <!-- COMMON DATE AND COMPANY -->
                        <div class="row g-3 mb-5">

                            <div class="col-md-6">
                                <label asp-for="Trdate"
                                       class="form-label">
                                    Date <span class="text-danger">*</span>
                                </label>

                                <input asp-for="Trdate"
                                       type="date"
                                       class="form-control"
                                       required />

                                <span asp-validation-for="Trdate"
                                      class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Company"
                                       class="form-label">
                                    Company <span class="text-danger">*</span>
                                </label>

                                <select asp-for="Company"
                                        class="form-select"
                                        required>

                                    <option value="">
                                        -- Select Company --
                                    </option>

                                    @if (!string.IsNullOrEmpty(
                                                                        ViewBag.CurrentCompany as string))
                                    {
                                        <option value="@ViewBag.CurrentCompany">
                                            @ViewBag.CurrentCompany
                                        </option>
                                    }
                                </select>

                                <span asp-validation-for="Company"
                                      class="text-danger"></span>
                            </div>
                        </div>

                        <!-- STEP 1: SEWING JHUT -->
                        <div class="step-content active" id="step1">

                            <div class="card border-0 shadow-sm">

                                <div class="card-header bg-light">
                                    <h6 class="mb-0">
                                        Sewing Biomass Stock & Consumption
                                    </h6>
                                </div>

                                <div class="card-body">
                                    <div class="row g-3">

                                        <!-- Opening Stock -->
                                        <div class="col-md-6">
                                            <label asp-for="SewingJhutOpening" class="form-label">
                                                Opening Stock
                                            </label>

                                            <input asp-for="SewingJhutOpening"
                                                   id="SewingJhutOpening"
                                                   type="number"
                                                   step="0.01"
                                                   min="0"
                                                   class="form-control"
                                                   readonly />

                                            <span asp-validation-for="SewingJhutOpening"
                                                  class="text-danger"></span>
                                        </div>

                                        <!-- Receive -->
                                        <div class="col-md-6">
                                            <label asp-for="SewingJhutReceive"
                                                   class="form-label">
                                                Receive
                                            </label>

                                            <input asp-for="SewingJhutReceive"
                                                   id="SewingJhutReceive"
                                                   type="number"
                                                   step="0.01"
                                                   min="0"
                                                   class="form-control"/>

                                            <span asp-validation-for="SewingJhutReceive"
                                                  class="text-danger"></span>
                                        </div>

                                        <!-- Boiler 1 Consumption -->
                                        <div class="col-md-6">
                                            <label asp-for="SewingJhutB1Cons"
                                                   class="form-label">
                                                Boiler 1 Consumption
                                            </label>

                                            <input asp-for="SewingJhutB1Cons"
                                                   id="SewingJhutB1Cons"
                                                   type="number"
                                                   step="0.01"
                                                   min="0"
                                                   class="form-control"/>

                                            <span asp-validation-for="SewingJhutB1Cons"
                                                  class="text-danger"></span>
                                        </div>

                                        <!-- Boiler 2 Consumption -->
                                        <div class="col-md-6">
                                            <label asp-for="SewingJhutB2Cons"
                                                   class="form-label">
                                                Boiler 2 Consumption
                                            </label>

                                            <input asp-for="SewingJhutB2Cons"
                                                   id="SewingJhutB2Cons"
                                                   type="number"
                                                   step="0.01"
                                                   min="0"
                                                   class="form-control"/>

                                            <span asp-validation-for="SewingJhutB2Cons"
                                                  class="text-danger"></span>
                                        </div>

                                        <!-- Total Consumption -->
                                        <div class="col-md-6">
                                            <label asp-for="SewingJhutTotalCons"
                                                   class="form-label">
                                                Total Consumption
                                            </label>

                                            <input asp-for="SewingJhutTotalCons"
                                                   id="SewingJhutTotalCons"
                                                   type="number"
                                                   step="0.01"
                                                   class="form-control"
                                                   readonly />

                                            <span asp-validation-for="SewingJhutTotalCons"
                                                  class="text-danger"></span>
                                        </div>

                                        <!-- Closing Stock -->
                                        <div class="col-md-6">
                                            <label asp-for="SewingJhutClosing"
                                                   class="form-label">
                                                Closing Stock
                                            </label>

                                            <input asp-for="SewingJhutClosing"
                                                   id="SewingJhutClosing"
                                                   type="number"
                                                   step="0.01"
                                                   class="form-control closing-stock"
                                                   readonly />

                                            <span asp-validation-for="SewingJhutClosing"
                                                  class="text-danger"></span>
                                        </div>

                                        <!-- Total Cost -->
                                        <div class="col-md-6">
                                            <label asp-for="SewingJhutTotalCost"
                                                   class="form-label">
                                                Total Cost
                                            </label>

                                            <input asp-for="SewingJhutTotalCost"
                                                   id="SewingJhutTotalCost"
                                                   type="number"
                                                   step="0.01"
                                                   min="0"
                                                   class="form-control" readonly />

                                            <span asp-validation-for="SewingJhutTotalCost"
                                                  class="text-danger"></span>
                                        </div>

                                    </div>
                                </div>
                            </div>

                            <!-- STEP 1 BUTTONS -->
                            <div class="d-flex justify-content-between align-items-center mt-4">

                                <a asp-action="BiomassStockConsumptionList"
