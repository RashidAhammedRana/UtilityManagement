                                                   id="CartonClosing"
                                                   type="number"
                                                   step="0.01"
                                                   class="form-control closing-stock"
                                                   readonly />

                                            <span asp-validation-for="CartonClosing"
                                                  class="text-danger"></span>

                                        </div>

                                        <!-- TOTAL COST -->
                                        <div class="col-md-6">

                                            <label asp-for="CartonTotalCost"
                                                   class="form-label">
                                                Total Cost
                                            </label>

                                            <input asp-for="CartonTotalCost"
                                                   id="CartonTotalCost"
                                                   type="number"
                                                   step="0.01"
                                                   min="0"
                                                   class="form-control" readonly/>

                                            <span asp-validation-for="CartonTotalCost"
                                                  class="text-danger"></span>

                                        </div>

                                    </div>

                                </div>
                            </div>

                            <!-- NAVIGATION BUTTONS -->
                            <div class="d-flex justify-content-between mt-4">

                                <button type="button"
                                        class="btn btn-outline-secondary prev-btn"
                                        data-prev="3">
                                    ← Previous
                                </button>

                                <button type="button"
                                        class="btn btn-primary next-btn"
                                        data-next="5">
                                    Next →
                                </button>

                            </div>

                        </div>
                        <!-- =================================================
                             STEP 5 - PP
                        ================================================== -->

                        <div class="step-content" id="step5">

                            <div class="card border-0 shadow-sm mb-4">

                                <div class="card-header bg-light">
                                    <h6 class="mb-0">
                                        PP Stock & Consumption
                                    </h6>
                                </div>

                                <div class="card-body">

                                    <div class="row g-3">

                                        <!-- OPENING STOCK -->
                                        <div class="col-md-6">

                                            <label asp-for="PpOpening"
                                                   class="form-label">
                                                Opening Stock
                                            </label>

                                            <input asp-for="PpOpening"
                                                   id="PpOpening"
                                                   type="number"
                                                   step="0.01"
                                                   min="0"
                                                   class="form-control" readonly />

                                            <span asp-validation-for="PpOpening"
                                                  class="text-danger"></span>

                                        </div>

                                        <!-- RECEIVE -->
                                        <div class="col-md-6">

                                            <label asp-for="PpReceive"
                                                   class="form-label">
                                                Receive
                                            </label>

                                            <input asp-for="PpReceive"
                                                   id="PpReceive"
                                                   type="number"
                                                   step="0.01"
                                                   min="0"
                                                   class="form-control"/>

                                            <span asp-validation-for="PpReceive"
                                                  class="text-danger"></span>

                                        </div>

                                        <!-- BOILER 1 CONSUMPTION -->
                                        <div class="col-md-6">

                                            <label asp-for="PpB1Cons"
                                                   class="form-label">
                                                Boiler 1 Consumption
                                            </label>

                                            <input asp-for="PpB1Cons"
                                                   id="PpB1Cons"
                                                   type="number"
