                                                   min="0"
                                                   class="form-control"/>

                                            <span asp-validation-for="PpB1Cons"
                                                  class="text-danger"></span>

                                        </div>

                                        <!-- BOILER 2 CONSUMPTION -->
                                        <div class="col-md-6">

                                            <label asp-for="PpB2Cons"
                                                   class="form-label">
                                                Boiler 2 Consumption
                                            </label>

                                            <input asp-for="PpB2Cons"
                                                   id="PpB2Cons"
                                                   type="number"
                                                   step="0.01"
                                                   min="0"
                                                   class="form-control"/>

                                            <span asp-validation-for="PpB2Cons"
                                                  class="text-danger"></span>

                                        </div>

                                        <!-- TOTAL CONSUMPTION -->
                                        <div class="col-md-6">

                                            <label asp-for="PpTotalCons"
                                                   class="form-label">
                                                Total Consumption
                                            </label>

                                            <input asp-for="PpTotalCons"
                                                   id="PpTotalCons"
                                                   type="number"
                                                   step="0.01"
                                                   class="form-control" readonly />

                                            <span asp-validation-for="PpTotalCons"
                                                  class="text-danger"></span>

                                        </div>

                                        <!-- CLOSING STOCK -->
                                        <div class="col-md-6">

                                            <label asp-for="PpClosing"
                                                   class="form-label">
                                                Closing Stock
                                            </label>

                                            <input asp-for="PpClosing"
                                                   id="PpClosing"
                                                   type="number"
                                                   step="0.01"
                                                   class="form-control closing-stock"
                                                   readonly />

                                            <span asp-validation-for="PpClosing"
                                                  class="text-danger"></span>

                                        </div>

                                        <!-- TOTAL COST -->
                                        <div class="col-md-6">

                                            <label asp-for="PpTotalCost"
                                                   class="form-label">
                                                Total Cost
                                            </label>

                                            <input asp-for="PpTotalCost"
                                                   id="PpTotalCost"
                                                   type="number"
                                                   step="0.01"
                                                   min="0"
                                                   class="form-control"
                                                   readonly />

                                            <span asp-validation-for="PpTotalCost"
                                                  class="text-danger"></span>

                                        </div>

                                    </div>

                                </div>
                            </div>

                            <!-- FINAL BUTTONS -->
                            <div class="d-flex justify-content-between mt-4">

                                <button type="button"
                                        class="btn btn-outline-secondary prev-btn"
                                        data-prev="4">
                                    ← Previous
                                </button>

                                <div>

                                    <a asp-action="BiomassStockConsumptionList"
                                       class="btn btn-outline-secondary me-2">
                                        ← Back
                                    </a>

                                    <button type="submit"
                                            class="btn btn-primary px-4">
                                        Save
                                    </button>

                                </div>

                            </div>

                        </div>
                    </form>
                    </div>
            </div>
        </div>
    </div>
</div>
@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

                        <script>
                            $(document).ready(function () {

                                // =========================================
                                // BIOMASS RATES FROM CONTROLLER
                                // =========================================

                                const biomassRates = {
                                    SewingJhut: Number('@(ViewBag.SewingBiomassRate ?? 0)'),
                                    DenimJhut: Number('@(ViewBag.DenimBiomassRate ?? 0)'),
                                    Charcoal: Number('@(ViewBag.CharcoalRate ?? 0)'),
                                    Carton: Number('@(ViewBag.CartonRate ?? 0)'),
                                    Pp: Number('@(ViewBag.PpRate ?? 0)')
                                };


                                // =========================================
                                // STEP NAVIGATION
                                // =========================================

                                function showStep(stepNumber) {

                                    $('.step-content').removeClass('active');

                                    $('#step' + stepNumber).addClass('active');

                                    $('.step').removeClass('active completed');

                                    $('.step').each(function () {

                                        var currentStep = parseInt($(this).data('step'));

                                        if (currentStep < stepNumber) {
                                            $(this).addClass('completed');
                                        }
                                        else if (currentStep === stepNumber) {
                                            $(this).addClass('active');
                                        }

                                    });

                                    // Progress: 0%, 25%, 50%, 75%, 100%
                                    var progress = ((stepNumber - 1) / 4) * 100;

                                    $('#stepperProgress').css('width', progress + '%');

                                }


                                // =========================================
                                // NEXT BUTTON
                                // =========================================

                                $('.next-btn').on('click', function () {

                                    var nextStep = parseInt($(this).data('next'));

                                    var currentContent = $(this).closest('.step-content');

                                    var valid = true;

                                    currentContent.find(':input[required]:enabled').each(function () {

                                        if (!this.checkValidity()) {

                                            this.reportValidity();

                                            valid = false;

                                            return false;
                                        }

                                    });

                                    if (valid) {
                                        showStep(nextStep);
                                        window.scrollTo({ top: 0, behavior: 'smooth' });
                                    }

                                });


                                // =========================================
                                // PREVIOUS BUTTON
                                // =========================================

                                $('.prev-btn').on('click', function () {

                                    var previousStep = parseInt($(this).data('prev'));

                                    showStep(previousStep);

                                    window.scrollTo({ top: 0, behavior: 'smooth' });

                                });


                                // =========================================
                                // STEP INDICATOR CLICK
                                // =========================================

                                $('.step').on('click', function () {

                                    var targetStep = parseInt($(this).data('step'));

                                    var currentStep = parseInt(
                                        $('.step-content.active').attr('id').replace('step', '')
                                    );

                                    // Allow backward navigation
                                    if (targetStep <= currentStep) {
                                        showStep(targetStep);
                                        return;
                                    }

                                    // Validate intermediate steps
                                    for (var i = currentStep; i < targetStep; i++) {

                                        var valid = true;

                                        $('#step' + i)
                                            .find(':input[required]:enabled')
                                            .each(function () {

                                                if (!this.checkValidity()) {

                                                    showStep(i);

                                                    this.reportValidity();

                                                    valid = false;

                                                    return false;
                                                }

                                            });

                                        if (!valid) {
                                            return;
                                        }

                                    }

                                    showStep(targetStep);

                                    window.scrollTo({ top: 0, behavior: 'smooth' });

                                });


                                // =========================================
                                // COMMON STOCK & COST CALCULATION
                                //
                                // Total Consumption = Boiler 1 + Boiler 2
                                // Closing Stock = Opening + Receive - Consumption
                                // Total Cost = Total Consumption * Rate
                                // =========================================

                                function calculateStock(prefix) {

                                    var opening = parseFloat(
                                        $('#' + prefix + 'Opening').val()
                                    ) || 0;

                                    var receive = parseFloat(
                                        $('#' + prefix + 'Receive').val()
                                    ) || 0;

                                    var boiler1 = parseFloat(
                                        $('#' + prefix + 'B1Cons').val()
                                    ) || 0;

                                    var boiler2 = parseFloat(
                                        $('#' + prefix + 'B2Cons').val()
                                    ) || 0;

                                    // Total Consumption
                                    var totalConsumption = boiler1 + boiler2;

                                    // Closing Stock
                                    var closingStock = opening + receive - totalConsumption;

                                    // Rate loaded from Controller
                                    var rate = biomassRates[prefix] || 0;

                                    // Total Cost
                                    var totalCost = totalConsumption * rate;

                                    // Update Total Consumption
                                    $('#' + prefix + 'TotalCons').val(
                                        totalConsumption.toFixed(2)
                                    );

                                    // Update Closing Stock
                                    $('#' + prefix + 'Closing').val(
                                        closingStock.toFixed(2)
                                    );

                                    // Update Total Cost
                                    $('#' + prefix + 'TotalCost').val(
                                        totalCost.toFixed(2)
                                    );

                                }


                                // =========================================
                                // SEWING JHUT
                                // =========================================

                                $('#SewingJhutReceive, #SewingJhutB1Cons, #SewingJhutB2Cons')
                                    .on('input change', function () {
                                        calculateStock('SewingJhut');
                                    });


                                // =========================================
                                // DENIM JHUT
                                // =========================================

                                $('#DenimJhutReceive, #DenimJhutB1Cons, #DenimJhutB2Cons')
                                    .on('input change', function () {
                                        calculateStock('DenimJhut');
                                    });


                                // =========================================
                                // CHARCOAL
                                // =========================================

                                $('#CharcoalReceive, #CharcoalB1Cons, #CharcoalB2Cons')
                                    .on('input change', function () {
                                        calculateStock('Charcoal');
                                    });


                                // =========================================
                                // CARTON
                                // =========================================

                                $('#CartonReceive, #CartonB1Cons, #CartonB2Cons')
                                    .on('input change', function () {
                                        calculateStock('Carton');
                                    });


                                // =========================================
                                // PP
                                // =========================================

                                $('#PpReceive, #PpB1Cons, #PpB2Cons')
                                    .on('input change', function () {
                                        calculateStock('Pp');
                                    });


                                // =========================================
                                // INITIAL CALCULATION
                                // =========================================

                                calculateStock('SewingJhut');

                                calculateStock('DenimJhut');

                                calculateStock('Charcoal');

                                calculateStock('Carton');

                                calculateStock('Pp');


                                // =========================================
                                // FORM SUBMISSION VALIDATION
                                // =========================================

                                $('.create-form').on('submit', function (event) {

                                    var form = this;

                                    if (!form.checkValidity()) {

                                        event.preventDefault();

                                        var invalidField = form.querySelector(':invalid');

                                        if (invalidField) {

                                            var parentStep = $(invalidField)
                                                .closest('.step-content');

                                            if (parentStep.length) {

                                                var stepNumber = parseInt(
                                                    parentStep.attr('id').replace('step', '')
                                                );

                                                showStep(stepNumber);

                                                invalidField.reportValidity();

                                            }

                                        }

                                        return false;
                                    }

                                    // Recalculate all values before submission
                                    calculateStock('SewingJhut');
                                    calculateStock('DenimJhut');
                                    calculateStock('Charcoal');
                                    calculateStock('Carton');
                                    calculateStock('Pp');

                                });


                                // =========================================
                                // INITIAL STEP
                                // =========================================

                                showStep(1);

                            });
                        </script>
}
