                            <div class="card border-0 shadow-sm mb-4">

                                <div class="card-header bg-light">
                                    <h6 class="mb-0">
                                        Carton Stock & Consumption
                                    </h6>
                                </div>

                                <div class="card-body">

                                    <div class="row g-3">

                                        <!-- OPENING STOCK -->
                                        <div class="col-md-6">

                                            <label asp-for="CartonOpening"
                                                   class="form-label">
                                                Opening Stock
                                            </label>

                                            <input asp-for="CartonOpening"
                                                   id="CartonOpening"
                                                   type="number"
                                                   step="0.01"
                                                   min="0"
                                                   class="form-control" readonly/>

                                            <span asp-validation-for="CartonOpening"
                                                  class="text-danger"></span>

                                        </div>

                                        <!-- RECEIVE -->
                                        <div class="col-md-6">

                                            <label asp-for="CartonReceive"
                                                   class="form-label">
                                                Receive
                                            </label>

                                            <input asp-for="CartonReceive"
                                                   id="CartonReceive"
                                                   type="number"
                                                   step="0.01"
                                                   min="0"
                                                   class="form-control"/>

                                            <span asp-validation-for="CartonReceive"
                                                  class="text-danger"></span>

                                        </div>

                                        <!-- BOILER 1 CONSUMPTION -->
                                        <div class="col-md-6">

                                            <label asp-for="CartonB1Cons"
                                                   class="form-label">
                                                Boiler 1 Consumption
                                            </label>

                                            <input asp-for="CartonB1Cons"
                                                   id="CartonB1Cons"
                                                   type="number"
                                                   step="0.01"
                                                   min="0"
                                                   class="form-control"/>

                                            <span asp-validation-for="CartonB1Cons"
                                                  class="text-danger"></span>

                                        </div>

                                        <!-- BOILER 2 CONSUMPTION -->
                                        <div class="col-md-6">

                                            <label asp-for="CartonB2Cons"
                                                   class="form-label">
                                                Boiler 2 Consumption
                                            </label>

                                            <input asp-for="CartonB2Cons"
                                                   id="CartonB2Cons"
                                                   type="number"
                                                   step="0.01"
                                                   min="0"
                                                   class="form-control"/>

                                            <span asp-validation-for="CartonB2Cons"
                                                  class="text-danger"></span>

                                        </div>

                                        <!-- TOTAL CONSUMPTION -->
                                        <div class="col-md-6">

                                            <label asp-for="CartonTotalCons"
