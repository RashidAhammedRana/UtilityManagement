@model UtilityManagement.ViewModels.BoilerSteamGenerationViewModel

@using System.Text.Json

@{
    ViewData["Title"] = "Create Boiler Steam Generation Info";

    var currentCompany = ViewBag.CurrentCompany as string ?? "";

    var existingTimes = ViewBag.ExistingTimes as List<string>
        ?? new List<string>();

    var nextAvailableTime = ViewBag.NextAvailableTime as string ?? "";
}

<link href="~/css/boilersteamgeneration.css"
      rel="stylesheet"
      asp-append-version="true" />


<div class="row justify-content-center">

    <div class="col-md-12">

        <div class="card shadow-lg border-0 boiler-card">


            <!-- ===================================================== -->
            <!-- HEADER -->
            <!-- ===================================================== -->

            <div class="card-header bg-primary text-white">

                <h5 class="mb-0">

                    <i class="bi bi-fire me-1"></i>

                    Add Boiler Steam Generation Info

                </h5>

            </div>


            <!-- ===================================================== -->
            <!-- CARD BODY -->
            <!-- ===================================================== -->

            <div class="card-body p-5">


                <!-- ================================================= -->
                <!-- ERROR MESSAGE                                     -->
                <!-- ================================================= -->
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show"
                         role="alert">

                        <i class="bi bi-exclamation-triangle me-1"></i>

                        @TempData["ErrorMessage"]

                        <button type="button"
                                class="btn-close"
                                data-bs-dismiss="alert">
                        </button>

                    </div>
                }


                <!-- ================================================= -->
                <!-- SUCCESS MESSAGE                                   -->
                <!-- ================================================= -->
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show"
                         role="alert">

                        <i class="bi bi-check-circle me-1"></i>

                        @TempData["SuccessMessage"]

                        <button type="button"
                                class="btn-close"
                                data-bs-dismiss="alert">
                        </button>

                    </div>
                }


                <!-- ================================================= -->
                <!-- FORM                                              -->
                <!-- ================================================= -->

                <form asp-action="Create"
                      method="post"
                      id="boilerForm">

                    @Html.AntiForgeryToken()


                    <!-- ================================================= -->
                    <!-- INPUT TABLE                                      -->
                    <!-- ================================================= -->

                    <div class="input-table-wrapper">

                        <table class="table table-bordered table-sm align-middle mb-0 boiler-table">

                            <thead class="table-dark">

                                <tr>

                                    <th>Company</th>

                                    <th>Date</th>

                                    <th>Time</th>

                                    <th>Gas Pressure</th>

                                    <th>Header Steam Pressure</th>

                                    <th>Boiler-1 Steam Generation</th>

                                    <th>B1 Usage Fuel</th>

                                    <th>Boiler-2 Steam Generation</th>

                                    <th>B2 Usage Fuel</th>

                                    <th>Boiler-3 Steam Generation</th>

                                    <th>B3 Usage Fuel</th>

                                    <th>EGB Boiler Steam Generation</th>

                                    <th>Total Generation</th>

                                    <th>Add</th>

                                </tr>

                            </thead>


                            <tbody>

                                <tr id="inputRow">


                                    <!-- ================================================= -->
                                    <!-- COMPANY                                          -->
                                    <!-- ================================================= -->

                                    <td>

                                        <input type="text"
                                               id="inputCompany"
                                               class="form-control form-control-sm"
                                               value="@currentCompany"
                                               readonly />

                                    </td>


                                    <!-- ================================================= -->
                                    <!-- DATE                                             -->
                                    <!-- ================================================= -->

                                    <td>

                                        <input type="date"
                                               id="inputDate"
                                               class="form-control form-control-sm"
                                               value="@DateTime.Today.ToString("yyyy-MM-dd")" />

                                    </td>


                                    <!-- ================================================= -->
                                    <!-- TIME                                             -->
                                    <!-- ================================================= -->

                                    <td>

                                        <input type="text"
                                               id="inputTimeDisplay"
                                               class="form-control form-control-sm time-display"
                                               value=""
                                               readonly />

                                        <input type="hidden"
                                               id="inputTime"
                                               value="@nextAvailableTime" />

                                    </td>


                                    <!-- ================================================= -->
                                    <!-- GAS PRESSURE                                     -->
                                    <!-- ================================================= -->

                                    <td>

                                        <input type="number"
                                               id="inputGasPressure"
                                               step="any"
                                               class="form-control form-control-sm boiler-input"
                                               autocomplete="off" />

                                    </td>


                                    <!-- ================================================= -->
                                    <!-- HEADER STEAM PRESSURE                            -->
                                    <!-- ================================================= -->

                                    <td>

                                        <input type="number"
                                               id="inputHeaderSteamPressure"
                                               step="any"
                                               class="form-control form-control-sm boiler-input"
                                               autocomplete="off" />

                                    </td>


                                    <!-- ================================================= -->
                                    <!-- BOILER 1 STEAM GENERATION                       -->
                                    <!-- ================================================= -->

                                    <td>

                                        <input type="number"
                                               id="inputBoiler1SteamGeneration"
                                               step="any"
                                               min="0"
                                               class="form-control form-control-sm boiler-input generation-input"
                                               autocomplete="off" />

                                    </td>


                                    <!-- ================================================= -->
                                    <!-- B1 USAGE FUEL                                   -->
                                    <!-- ================================================= -->

                                    <td>

                                        <select id="inputB1UsageFuel"
                                                class="form-select form-select-sm">

                                            <option value="">
                                                Select
                                            </option>

                                            <option value="NG">
                                                NG
                                            </option>

                                            <option value="CNG">
                                                CNG
                                            </option>

                                            <option value="LPG">
                                                LPG
                                            </option>

                                            <option value="DIESEL">
                                                DIESEL
                                            </option>

                                        </select>

                                    </td>


                                    <!-- ================================================= -->
                                    <!-- BOILER 2 STEAM GENERATION                       -->
                                    <!-- ================================================= -->

                                    <td>

                                        <input type="number"
                                               id="inputBoiler2SteamGeneration"
                                               step="any"
                                               min="0"
                                               class="form-control form-control-sm boiler-input generation-input"
                                               autocomplete="off" />

                                    </td>


                                    <!-- ================================================= -->
                                    <!-- B2 USAGE FUEL                                   -->
                                    <!-- ================================================= -->

                                    <td>

                                        <select id="inputB2UsageFuel"
                                                class="form-select form-select-sm">

                                            <option value="">
                                                Select
                                            </option>

                                            <option value="NG">
                                                NG
                                            </option>

                                            <option value="CNG">
                                                CNG
                                            </option>

                                            <option value="LPG">
                                                LPG
                                            </option>

                                            <option value="DIESEL">
                                                DIESEL
                                            </option>

                                        </select>

                                    </td>


                                    <!-- ================================================= -->
                                    <!-- BOILER 3 STEAM GENERATION                       -->
                                    <!-- ================================================= -->

                                    <td>

                                        <input type="number"
                                               id="inputBoiler3SteamGeneration"
                                               step="any"
                                               min="0"
                                               class="form-control form-control-sm boiler-input generation-input"
                                               autocomplete="off" />

                                    </td>


                                    <!-- ================================================= -->
                                    <!-- B3 USAGE FUEL                                   -->
                                    <!-- ================================================= -->

                                    <td>

                                        <select id="inputB3UsageFuel"
                                                class="form-select form-select-sm">

                                            <option value="">
                                                Select
                                            </option>

                                            <option value="NG">
                                                NG
                                            </option>

                                            <option value="CNG">
                                                CNG
                                            </option>

                                            <option value="LPG">
                                                LPG
                                            </option>

                                            <option value="DIESEL">
                                                DIESEL
                                            </option>

                                        </select>

                                    </td>


                                    <!-- ================================================= -->
                                    <!-- EGB BOILER STEAM GENERATION                     -->
                                    <!-- ================================================= -->

                                    <td>

                                        <input type="number"
                                               id="inputEgbBoilerSteamGeneration"
                                               step="any"
                                               min="0"
                                               class="form-control form-control-sm boiler-input generation-input"
                                               autocomplete="off" />

                                    </td>


                                    <!-- ================================================= -->
                                    <!-- TOTAL GENERATION                                -->
                                    <!-- ================================================= -->

                                    <td>

                                        <input type="number"
                                               id="inputTotalGeneration"
                                               class="form-control form-control-sm total-generation"
                                               value="0"
                                               readonly
                                               tabindex="-1" />

                                    </td>


                                    <!-- ================================================= -->
                                    <!-- ADD BUTTON                                       -->
                                    <!-- ================================================= -->

                                    <td class="text-center">

                                        <button type="button"
                                                id="addRow"
                                                class="btn btn-success btn-sm"
                                                title="Add Reading">

                                            <i class="bi bi-plus-lg"></i>

                                        </button>

                                    </td>

                                </tr>

                            </tbody>

                        </table>

                    </div>


                    <!-- ================================================= -->
                    <!-- TIME FULL MESSAGE                                -->
                    <!-- ================================================= -->

                    <div id="timeFullMessage"
                         class="time-full-message mt-2 d-none text-danger fw-semibold">

                        <i class="bi bi-exclamation-triangle-fill me-1"></i>

                        All 24 hourly time slots for this date have already
                        been entered.

                    </div>


                    <!-- ================================================= -->
                    <!-- TEMPORARY LIST                                   -->
                    <!-- ================================================= -->

                    <div class="mt-4">

                        <h6 class="fw-bold text-primary mb-2">

                            <i class="bi bi-list-ul me-1"></i>

                            Boiler Steam Generation List

                        </h6>


                        <div class="table-responsive">

                            <table class="table table-bordered table-sm align-middle"
                                   id="temporaryTable">

                                <thead class="table-secondary">

                                    <tr>

                                        <th>SL</th>

                                        <th>Company</th>

                                        <th>Date</th>

                                        <th>Time</th>

                                        <th>Gas Pressure</th>

                                        <th>Header Steam Pressure</th>

                                        <th>Boiler-1 Steam Generation</th>

                                        <th>B1 Usage Fuel</th>

                                        <th>Boiler-2 Steam Generation</th>

                                        <th>B2 Usage Fuel</th>

                                        <th>Boiler-3 Steam Generation</th>

                                        <th>B3 Usage Fuel</th>

                                        <th>EGB Boiler Steam Generation</th>

                                        <th>Total Generation</th>

                                    </tr>

                                </thead>


                                <tbody id="temporaryBody">
                                </tbody>

                            </table>

                        </div>

                    </div>


                    <!-- ================================================= -->
                    <!-- HIDDEN POST DATA                                 -->
                    <!-- ================================================= -->

                    <div id="hiddenItemsContainer">
                    </div>


                    <!-- ================================================= -->
                    <!-- BUTTONS                                          -->
                    <!-- ================================================= -->

                    <div class="d-flex justify-content-between mt-4">

                        <a asp-action="BoilerSteamGenerationInfoList"
                           class="btn btn-outline-secondary">

                            <i class="bi bi-arrow-left me-1"></i>

                            Back

                        </a>


                        <button type="submit"
                                id="saveAllButton"
                                class="btn btn-primary px-4">

                            <i class="bi bi-save me-1"></i>

                            Save All

                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>


<!-- ============================================================= -->
<!-- SAVING OVERLAY                                                -->
<!-- ============================================================= -->

<div id="savingOverlay"
     class="saving-overlay d-none">

    <div class="saving-box text-center">

        <div class="spinner-border text-primary mb-3"
             role="status">

            <span class="visually-hidden">
                Saving...
            </span>

        </div>

        <div class="fw-bold">
            Saving readings...
        </div>

        <small class="text-muted">
            Please wait.
        </small>

    </div>

</div>


@section Scripts {

    <script>

        // =========================================================
        // CONFIGURATION
        // =========================================================

        window.boilerSteamConfig = {

            currentCompany:
                @Html.Raw(JsonSerializer.Serialize(currentCompany)),

            getAvailableTimesUrl:
                '@Url.Action("GetAvailableTimes")'

        };

    </script>


    <!-- ========================================================= -->
    <!-- TOTAL GENERATION                                         -->
    <!-- ========================================================= -->

    <script>

        document.addEventListener(
            "DOMContentLoaded",
            function () {

                const b1Input =
                    document.getElementById(
                        "inputBoiler1SteamGeneration"
                    );

                const b2Input =
                    document.getElementById(
                        "inputBoiler2SteamGeneration"
                    );

                const b3Input =
                    document.getElementById(
                        "inputBoiler3SteamGeneration"
                    );

                const egbInput =
                    document.getElementById(
                        "inputEgbBoilerSteamGeneration"
                    );

                const totalInput =
                    document.getElementById(
                        "inputTotalGeneration"
                    );


                function calculateTotalGeneration() {

                    const b1 =
                        parseFloat(b1Input.value) || 0;

                    const b2 =
                        parseFloat(b2Input.value) || 0;

                    const b3 =
                        parseFloat(b3Input.value) || 0;

                    const egb =
                        parseFloat(egbInput.value) || 0;


                    const total =
                        b1 + b2 + b3 + egb;


                    totalInput.value =
                        total.toFixed(2);

                }


                b1Input.addEventListener(
                    "input",
                    calculateTotalGeneration
                );

                b2Input.addEventListener(
                    "input",
                    calculateTotalGeneration
                );

                b3Input.addEventListener(
                    "input",
                    calculateTotalGeneration
                );

                egbInput.addEventListener(
                    "input",
                    calculateTotalGeneration
                );


                calculateTotalGeneration();

            });

    </script>


    <!-- ========================================================= -->
    <!-- MAIN BOILER JAVASCRIPT                                   -->
    <!-- ========================================================= -->

    <script src="~/js/boilersteamgeneration.js"
            asp-append-version="true">
    </script>


    <!-- ========================================================= -->
    <!-- SAVE ALL - NO FIELD VALIDATION                            -->
    <!-- ========================================================= -->

    <script>

        $(document).ready(function () {

            /*
             * IMPORTANT:
             *
             * Save All does NOT validate the input fields.
             *
             * The user can save the records that have already
             * been added to the temporary list.
             *
             * No required-field check is performed here.
             *
             * No confirmation/warning is shown here.
             */


            $("#boilerForm").on(
                "submit",
                function (e) {

                    /*
                     * If boilersteamgeneration.js has already
                     * created hidden Items[], let normal submit
                     * continue.
                     */

                    const hiddenContainer =
                        $("#hiddenItemsContainer");


                    /*
                     * If hidden items already exist, simply submit.
                     */

                    if (
                        hiddenContainer.children(
                            "input"
                        ).length > 0
                    ) {

                        $("#savingOverlay")
                            .removeClass("d-none");

                        return true;

                    }


                    /*
                     * Otherwise, check whether the temporary
                     * table contains rows.
                     *
                     * This is NOT field validation.
                     */

                    const rows =
                        $("#temporaryBody tr");


                    if (rows.length === 0) {

                        /*
                         * No warning / confirmation.
                         *
                         * Just prevent an empty submission.
                         */

                        e.preventDefault();

                        return false;

                    }


                    /*
                     * If your external JS has not generated the
                     * hidden inputs, create them from the temporary
                     * table/data if available.
                     */

                    $("#savingOverlay")
                        .removeClass("d-none");

                }

            );

        });

    </script>

}
