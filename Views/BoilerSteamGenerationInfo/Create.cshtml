@model UtilityManagement.ViewModels.BoilerSteamGenerationViewModel

@using System.Text.Json

@{
    ViewData["Title"] = "Create Boiler Steam Generation Info";

    var currentCompany = ViewBag.CurrentCompany as string ?? "";

    var existingTimes = ViewBag.ExistingTimes as List<string>
        ?? new List<string>();

    var nextAvailableTime = ViewBag.NextAvailableTime as string ?? "";
}

<div class="row justify-content-center">

    <div class="col-md-12">

        <div class="card shadow-lg border-0 boiler-card">

            <link href="~/css/boilersteamgeneration.css"
                  rel="stylesheet" />

            <!-- ===================================================== -->
            <!-- HEADER                                                -->
            <!-- ===================================================== -->

            <div class="card-header bg-primary text-white">

                <h5 class="mb-0">

                    <i class="bi bi-fire me-1"></i>

                    Add Boiler Steam Generation Info

                </h5>

            </div>


            <!-- ===================================================== -->
            <!-- CARD BODY                                             -->
            <!-- ===================================================== -->

            <div class="card-body p-5">


                <!-- ================================================= -->
                <!-- ERROR MESSAGE                                     -->
                <!-- ================================================= -->
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show"
                         role="alert">

                        <i class="bi bi-exclamation-triangle me-1"></i>

                        @TempData["ErrorMessage"]

                        <button type="button"
                                class="btn-close"
                                data-bs-dismiss="alert">
                        </button>

                    </div>
                }


                <!-- ================================================= -->
                <!-- SUCCESS MESSAGE                                   -->
                <!-- ================================================= -->
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show"
                         role="alert">

                        <i class="bi bi-check-circle me-1"></i>

                        @TempData["SuccessMessage"]

                        <button type="button"
                                class="btn-close"
                                data-bs-dismiss="alert">
                        </button>

                    </div>
                }


                <!-- ================================================= -->
                <!-- FORM                                              -->
                <!-- ================================================= -->

                <form asp-action="Create"
                      method="post"
                      id="boilerForm">

                    @Html.AntiForgeryToken()


                    <!-- ================================================= -->
                    <!-- VALIDATION                                        -->
                    <!-- ================================================= -->

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3">
                    </div>


                    <!-- ================================================= -->
                    <!-- INPUT TABLE                                      -->
                    <!-- ================================================= -->

                    <div class="input-table-wrapper">

                        <table class="table table-bordered table-sm align-middle mb-0 boiler-table">

                            <thead class="table-dark">

                                <tr>

                                    <th>Company</th>

                                    <th>Date</th>

                                    <th>Time</th>

                                    <th>Gas Pressure</th>

                                    <th>Header Steam Pressure</th>

                                    <th>Boiler-1 Steam Generation</th>

                                    <th>Boiler-2 Steam Generation</th>

                                    <th>Boiler-3 Steam Generation</th>

                                    <th>EGB Boiler Steam Generation</th>

                                    <th>B1 Usage Fuel</th>

                                    <th>B2 Usage Fuel</th>

                                    <th>B3 Usage Fuel</th>

                                    <th>Add</th>

                                </tr>

                            </thead>


                            <tbody>

                                <tr id="inputRow">


                                    <!-- COMPANY -->

                                    <td>

                                        <input type="text"
                                               id="inputCompany"
                                               class="form-control form-control-sm"
                                               value="@currentCompany"
                                               readonly />

                                    </td>


                                    <!-- DATE -->

                                    <td>

                                        <input type="date"
                                               id="inputDate"
                                               class="form-control form-control-sm"
                                               value="@DateTime.Today.ToString("yyyy-MM-dd")" />

                                    </td>


                                    <!-- TIME -->

                                    <td>

                                        <input type="text"
                                               id="inputTimeDisplay"
                                               class="form-control form-control-sm time-display"
                                               value=""
                                               readonly />

                                        <input type="hidden"
                                               id="inputTime"
                                               value="@nextAvailableTime" />

                                    </td>


                                    <!-- GAS PRESSURE -->

                                    <td>

                                        <input type="number"
                                               id="inputGasPressure"
                                               step="any"
                                               class="form-control form-control-sm boiler-input"
                                               autocomplete="off" />

                                    </td>


                                    <!-- HEADER STEAM PRESSURE -->

                                    <td>

                                        <input type="number"
                                               id="inputHeaderSteamPressure"
                                               step="any"
                                               class="form-control form-control-sm boiler-input"
                                               autocomplete="off" />

                                    </td>


                                    <!-- BOILER 1 -->

                                    <td>

                                        <input type="number"
                                               id="inputBoiler1SteamGeneration"
                                               step="any"
                                               class="form-control form-control-sm boiler-input"
                                               autocomplete="off" />

                                    </td>


                                    <!-- BOILER 2 -->

                                    <td>

                                        <input type="number"
                                               id="inputBoiler2SteamGeneration"
                                               step="any"
                                               class="form-control form-control-sm boiler-input"
                                               autocomplete="off" />

                                    </td>


                                    <!-- BOILER 3 -->

                                    <td>

                                        <input type="number"
                                               id="inputBoiler3SteamGeneration"
                                               step="any"
                                               class="form-control form-control-sm boiler-input"
                                               autocomplete="off" />

                                    </td>


                                    <!-- EGB BOILER -->

                                    <td>

                                        <input type="number"
                                               id="inputEgbBoilerSteamGeneration"
                                               step="any"
                                               class="form-control form-control-sm boiler-input"
                                               autocomplete="off" />

                                    </td>


                                    <!-- B1 FUEL -->

                                    <td>

                                        <select id="inputB1UsageFuel"
                                                class="form-select form-select-sm">

                                            <option value="">
                                                -- Select Fuel --
                                            </option>

                                            <option value="NG">
                                                NG
                                            </option>

                                            <option value="CNG">
                                                CNG
                                            </option>

                                            <option value="LPG">
                                                LPG
                                            </option>

                                            <option value="DIESEL">
                                                DIESEL
                                            </option>

                                        </select>

                                    </td>


                                    <!-- B2 FUEL -->

                                    <td>

                                        <select id="inputB2UsageFuel"
                                                class="form-select form-select-sm">

                                            <option value="">
                                                -- Select Fuel --
                                            </option>

                                            <option value="NG">
                                                NG
                                            </option>

                                            <option value="CNG">
                                                CNG
                                            </option>

                                            <option value="LPG">
                                                LPG
                                            </option>

                                            <option value="DIESEL">
                                                DIESEL
                                            </option>

                                        </select>

                                    </td>


                                    <!-- B3 FUEL -->

                                    <td>

                                        <select id="inputB3UsageFuel"
                                                class="form-select form-select-sm">

                                            <option value="">
                                                -- Select Fuel --
                                            </option>

                                            <option value="NG">
                                                NG
                                            </option>

                                            <option value="CNG">
                                                CNG
                                            </option>

                                            <option value="LPG">
                                                LPG
                                            </option>

                                            <option value="DIESEL">
                                                DIESEL
                                            </option>

                                        </select>

                                    </td>


                                    <!-- ADD -->

                                    <td class="text-center">

                                        <button type="button"
                                                id="addRow"
                                                class="btn btn-success btn-sm"
                                                title="Add Reading">

                                            <i class="bi bi-plus-lg"></i>

                                        </button>

                                    </td>

                                </tr>

                            </tbody>

                        </table>

                    </div>


                    <!-- ================================================= -->
                    <!-- TIME FULL MESSAGE                                -->
                    <!-- ================================================= -->

                    <div id="timeFullMessage"
                         class="time-full-message mt-2 d-none">

                        <i class="bi bi-exclamation-circle me-1"></i>

                        All 24 hourly slots for this date have already
                        been entered.

                    </div>


                    <!-- ================================================= -->
                    <!-- TEMPORARY LIST                                   -->
                    <!-- ================================================= -->

                    <div class="mt-4">

                        <h6 class="fw-bold text-primary mb-2">

                            <i class="bi bi-list-ul me-1"></i>

                            Boiler Steam Generation List

                        </h6>


                        <div class="table-responsive">

                            <table class="table table-bordered table-sm align-middle"
                                   id="temporaryTable">

                                <thead class="table-secondary">

                                    <tr>

                                        <th>SL</th>

                                        <th>Company</th>

                                        <th>Date</th>

                                        <th>Time</th>

                                        <th>Gas Pressure</th>

                                        <th>Header Steam Pressure</th>

                                        <th>Boiler-1 Steam Generation</th>

                                        <th>Boiler-2 Steam Generation</th>

                                        <th>Boiler-3 Steam Generation</th>

                                        <th>EGB Boiler Steam Generation</th>

                                        <th>B1 Usage Fuel</th>

                                        <th>B2 Usage Fuel</th>

                                        <th>B3 Usage Fuel</th>

                                    </tr>

                                </thead>


                                <tbody id="temporaryBody">
                                </tbody>

                            </table>

                        </div>

                    </div>


                    <!-- ================================================= -->
                    <!-- HIDDEN POST DATA                                 -->
                    <!-- ================================================= -->

                    <div id="hiddenItemsContainer">
                    </div>


                    <!-- ================================================= -->
                    <!-- BUTTONS                                          -->
                    <!-- ================================================= -->

                    <div class="d-flex justify-content-between mt-4">

                        <a asp-action="BoilerSteamGenerationList"
                           class="btn btn-outline-secondary">

                            <i class="bi bi-arrow-left me-1"></i>

                            Back

                        </a>


                        <button type="submit"
                                id="saveAllButton"
                                class="btn btn-primary px-4">

                            <i class="bi bi-save me-1"></i>

                            Save All

                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>


<!-- ============================================================= -->
<!-- SAVING OVERLAY                                                -->
<!-- ============================================================= -->

<div id="savingOverlay"
     class="saving-overlay d-none">

    <div class="saving-box text-center">

        <div class="spinner-border text-primary mb-3"
             role="status">

            <span class="visually-hidden">
                Saving...
            </span>

        </div>

        <div class="fw-bold">
            Saving readings...
        </div>

        <small class="text-muted">
            Please wait.
        </small>

    </div>

</div>


@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>

        window.boilerSteamConfig = {

            currentCompany:
                @Html.Raw(JsonSerializer.Serialize(currentCompany)),

            getAvailableTimesUrl:
                '@Url.Action("GetAvailableTimes")'

        };

    </script>


    <script src="~/js/boilersteamgeneration.js"
            asp-append-version="true">
    </script>

}
