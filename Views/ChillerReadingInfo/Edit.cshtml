                            </div>
                            <!-- SparePartsCost -->
                            <div class="col-lg-3 col-md-4 col-sm-6">
                                <label asp-for="SparePartsCost" class="form-label">
                                    Spare Parts Cost <span class="text-danger">*</span>
                                </label>
                                <input asp-for="SparePartsCost" class="form-control" />
                                <span asp-validation-for="SparePartsCost" class="text-danger"></span>
                            </div>
                            <!-- TotalCost -->
                            <div class="col-lg-3 col-md-4 col-sm-6">
                                <label asp-for="TotalCost" class="form-label">
                                    Total Cost <span class="text-danger">*</span>
                                </label>
                                <input asp-for="TotalCost" class="form-control" readonly />
                                <span asp-validation-for="TotalCost" class="text-danger"></span>
                            </div>
                            <!-- TotalCoolingWater -->
                            <div class="col-lg-3 col-md-4 col-sm-6">
                                <label asp-for="TotalCoolingWater" class="form-label">
                                    Total Cooling Water<span class="text-danger">*</span>
                                </label>
                                <input asp-for="TotalCoolingWater" class="form-control" />
                                <span asp-validation-for="TotalCoolingWater" class="text-danger"></span>
                            </div>
                            <!-- CoolingCost -->
                            <div class="col-lg-3 col-md-4 col-sm-6">
                                <label asp-for="CoolingCost" class="form-label">
                                    Cooling Cost/m³<span class="text-danger">*</span>
                                </label>
                                <input asp-for="CoolingCost" class="form-control" />
                                <span asp-validation-for="CoolingCost" class="text-danger"></span>
                            </div>

                        </div>

                        <div class="d-flex justify-content-between mt-4">

                            <a asp-action="ChillerReadingInfoList"
                               class="btn btn-outline-secondary">
                                ← Back
                            </a>

                            <button type="submit"
                                    class="btn btn-success">
                                <i class="bi bi-check-circle"></i>
                                Update Reading
                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>
    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>

        // Chemical Rates from Backend
        const c114Rate = @ViewBag.C114Rate;
        const c2100bRate = @ViewBag.C2100bRate;
        const c2150Rate = @ViewBag.C2150Rate;
        const c317Rate = @ViewBag.C317Rate;
        const c615Rate = @ViewBag.C615Rate;


        $(document).ready(function () {


            function getValue(selector) {
                return parseFloat($(selector).val()) || 0;
            }


            function setCost(consumptionSelector, costSelector, rate) {

                let consumption = getValue(consumptionSelector);
                let cost = consumption * rate;

                $(costSelector).val(cost.toFixed(2));
            }



            function calculate() {


                // ============================
                // Steam Calculation
                // Cost = Consumption × User Rate
                // ============================

                let steamRate = getValue("#SteamRate");

                setCost(
                    "#SteamCons",
                    "#SteamCost",
                    steamRate
                );



                // ============================
                // Chemical Calculation
                // Cost = Consumption × Backend Rate
                // ============================

                setCost("#ChC114Cons", "#ChC114Cost", c114Rate);

                setCost("#ChC2100bCons", "#ChC2100bCost", c2100bRate);

                setCost("#ChC2150Cons", "#ChC2150Cost", c2150Rate);

                setCost("#ChC317Cons", "#ChC317Cost", c317Rate);

                setCost("#ChC615Cons", "#ChC615Cost", c615Rate);



                // ============================
                // Total Cost Calculation
                // ============================

                let totalCost =
                    getValue("#SteamCost") +
                    getValue("#ChC114Cost") +
                    getValue("#ChC2100bCost") +
                    getValue("#ChC2150Cost") +
                    getValue("#ChC317Cost") +
                    getValue("#ChC615Cost") +
                    getValue("#ServiceCharge") +
                    getValue("#MaintenanceCost") +
                    getValue("#SparePartsCost");


                $("#TotalCost").val(totalCost.toFixed(2));



                // ============================
                // Cooling Cost Calculation
                // Cooling Cost = TotalCost / Water
                // ============================

                let totalCoolingWater = getValue("#TotalCoolingWater");


                let coolingCost = 0;

                if (totalCoolingWater > 0) {
                    coolingCost = totalCost / totalCoolingWater;
                }


                $("#CoolingCost").val(coolingCost.toFixed(2));

            }



            // Recalculate on input change

            $(
                "#SteamRate," +
                "#SteamCons," +
                "#ChC114Cons," +
                "#ChC2100bCons," +
                "#ChC2150Cons," +
                "#ChC317Cons," +
                "#ChC615Cons," +
                "#ServiceCharge," +
                "#MaintenanceCost," +
                "#SparePartsCost," +
                "#TotalCoolingWater"
            )
            .on("input", calculate);



            // Initial calculation
            calculate();


        });

    </script>
}