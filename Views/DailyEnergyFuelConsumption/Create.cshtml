@model UtilityManagement.ViewModels.DailyEnergyFuelConsumptionCreateViewModel

@using System.Text.Json

@{
    ViewData["Title"] = "Create Daily Energy & Fuel Consumption Info";

    var currentCompany = ViewBag.CurrentCompany as string ?? "";

    var existingTimes = ViewBag.ExistingTimes as List<string>
        ?? new List<string>();

    var nextAvailableTime = ViewBag.NextAvailableTime as string ?? "";
}

<div class="row justify-content-center">

    <div class="col-md-12">

        <div class="card shadow-lg border-0 energy-card">

            <link href="~/css/dailyenergyfuelconsumption.css" rel="stylesheet" />
            <!-- ===================================================== -->
            <!-- HEADER                                                -->
            <!-- ===================================================== -->

            <div class="card-header bg-primary text-white">

                <h5 class="mb-0">

                    <i class="bi bi-lightning-charge me-1"></i>

                    Add Daily Energy & Fuel Consumption Info

                </h5>

            </div>


            <!-- ===================================================== -->
            <!-- CARD BODY                                              -->
            <!-- ===================================================== -->

            <div class="card-body p-5">


                <!-- ================================================= -->
                <!-- MESSAGES                                          -->
                <!-- ================================================= -->
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show"
                         role="alert">

                        <i class="bi bi-exclamation-triangle me-1"></i>

                        @TempData["ErrorMessage"]

                        <button type="button"
                                class="btn-close"
                                data-bs-dismiss="alert">
                        </button>

                    </div>
                }


                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show"
                         role="alert">

                        <i class="bi bi-check-circle me-1"></i>

                        @TempData["SuccessMessage"]

                        <button type="button"
                                class="btn-close"
                                data-bs-dismiss="alert">
                        </button>

                    </div>
                }


                <!-- ================================================= -->
                <!-- FORM                                               -->
                <!-- ================================================= -->

                <form asp-action="Create"
                      method="post"
                      id="consumptionForm">

                    @Html.AntiForgeryToken()


                    <!-- ================================================= -->
                    <!-- MODEL VALIDATION                                  -->
                    <!-- ================================================= -->

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3">
                    </div>


                    <!-- ================================================= -->
                    <!-- INPUT TABLE                                       -->
                    <!-- ================================================= -->

                    <div class="input-table-wrapper">

                        <table class="table table-bordered table-sm align-middle mb-0 energy-table">

                            <thead class="table-dark">

                                <tr>

                                    <th>
                                        Company
                                    </th>

                                    <th>
                                        Date
                                    </th>

                                    <th>
                                        Time
                                    </th>

                                    <th>
                                        REB
                                    </th>

                                    <th>
                                        GG-1
                                    </th>

                                    <th>
                                        GG-2
                                    </th>

                                    <th>
                                        GG-3
                                    </th>

                                    <th>
                                        GG-4
                                    </th>

                                    <th>
                                        DG-1
                                    </th>

                                    <th>
                                        DG-2
                                    </th>

                                    <th>
                                        DG-3
                                    </th>

                                    <th>
                                        DG-4
                                    </th>

                                    <th>
                                        Solar
                                    </th>

                                    <th>
                                        Total
                                    </th>

                                    <th>
                                        Captive Gen.
                                    </th>

                                    <th>
                                        Ind. Boiler
                                    </th>

                                    <th>
                                        Add
                                    </th>

                                </tr>

                            </thead>


                            <tbody>

                                <tr id="inputRow">


                                    <!-- COMPANY -->

                                    <td>

                                        <input type="text"
                                               id="inputCompany"
                                               class="form-control form-control-sm"
                                               value="@currentCompany"
                                               readonly />

                                    </td>


                                    <!-- DATE -->

                                    <td>

                                        <input type="date"
                                               id="inputDate"
                                               class="form-control form-control-sm"
                                               value="@DateTime.Today.ToString("yyyy-MM-dd")"
                                               required />

                                    </td>


                                    <!-- TIME -->

                                    <td>

                                        <input type="text"
                                               id="inputTimeDisplay"
                                               class="form-control form-control-sm time-display"
                                               value=""
                                               readonly />

                                        <input type="hidden"
                                               id="inputTime"
                                               value="@nextAvailableTime" />

                                    </td>


                                    <!-- REB -->

                                    <td>

                                        <input type="number"
                                               id="inputReb"
                                               step="any"
                                               class="form-control form-control-sm energy-input"
                                               autocomplete="off" />

                                    </td>


                                    <!-- GG1 -->

                                    <td>

                                        <input type="number"
                                               id="inputGg1"
                                               step="any"
                                               class="form-control form-control-sm energy-input"
                                               autocomplete="off" />

                                    </td>


                                    <!-- GG2 -->

                                    <td>

                                        <input type="number"
                                               id="inputGg2"
                                               step="any"
                                               class="form-control form-control-sm energy-input"
                                               autocomplete="off" />

                                    </td>


                                    <!-- GG3 -->

                                    <td>

                                        <input type="number"
                                               id="inputGg3"
                                               step="any"
                                               class="form-control form-control-sm energy-input"
                                               autocomplete="off" />

                                    </td>


                                    <!-- GG4 -->

                                    <td>

                                        <input type="number"
                                               id="inputGg4"
                                               step="any"
                                               class="form-control form-control-sm energy-input"
                                               autocomplete="off" />

                                    </td>


                                    <!-- DG1 -->

                                    <td>

                                        <input type="number"
                                               id="inputDg1"
                                               step="any"
                                               class="form-control form-control-sm energy-input"
                                               autocomplete="off" />

                                    </td>


                                    <!-- DG2 -->

                                    <td>

                                        <input type="number"
                                               id="inputDg2"
                                               step="any"
                                               class="form-control form-control-sm energy-input"
                                               autocomplete="off" />

                                    </td>


                                    <!-- DG3 -->

                                    <td>

                                        <input type="number"
                                               id="inputDg3"
                                               step="any"
                                               class="form-control form-control-sm energy-input"
                                               autocomplete="off" />

                                    </td>


                                    <!-- DG4 -->

                                    <td>

                                        <input type="number"
                                               id="inputDg4"
                                               step="any"
                                               class="form-control form-control-sm energy-input"
                                               autocomplete="off" />

                                    </td>


                                    <!-- SOLAR -->

                                    <td>

                                        <input type="number"
                                               id="inputSolar"
                                               step="any"
                                               class="form-control form-control-sm energy-input"
                                               autocomplete="off" />

                                    </td>


                                    <!-- TOTAL -->

                                    <td>

                                        <input type="number"
                                               id="inputTotal"
                                               class="form-control form-control-sm total-display"
                                               value="0.00"
                                               readonly />

                                    </td>


                                    <!-- CAPTIVE GENERATOR -->

                                    <td>

                                        <input type="number"
                                               id="inputCaptiveGenerator"
                                               step="any"
                                               class="form-control form-control-sm required-consumption-field"
                                               autocomplete="off" />

                                    </td>


                                    <!-- INDUSTRIAL BOILER -->

                                    <td>

                                        <input type="number"
                                               id="inputIndustrialBoiler"
                                               step="any"
                                               class="form-control form-control-sm required-consumption-field"
                                               autocomplete="off" />

                                    </td>


                                    <!-- ADD BUTTON -->

                                    <td class="text-center">

                                        <button type="button"
                                                id="addRow"
                                                class="btn btn-success btn-sm"
                                                title="Add Reading">

                                            <i class="bi bi-plus-lg"></i>

                                        </button>

                                    </td>

                                </tr>

                            </tbody>

                        </table>

                    </div>


                    <!-- ================================================= -->
                    <!-- TIME FULL MESSAGE                                 -->
                    <!-- ================================================= -->

                    <div id="timeFullMessage"
                         class="time-full-message mt-2 d-none">

                        <i class="bi bi-exclamation-circle me-1"></i>

                        All 24 hourly slots for this date have already
                        been entered.

                    </div>


                    <!-- ================================================= -->
                    <!-- CONSUMPTION LIST                                  -->
                    <!-- ================================================= -->

                    <div class="mt-4">

                        <h6 class="fw-bold text-primary mb-2">

                            <i class="bi bi-list-ul me-1"></i>

                            Consumption List

                        </h6>


                        <div class="table-responsive">

                            <table class="table table-bordered table-sm align-middle"
                                   id="temporaryTable">

                                <thead class="table-secondary">

                                    <tr>

                                        <th>Company</th>

                                        <th>Date</th>

                                        <th>Time</th>

                                        <th>REB</th>

                                        <th>GG-1</th>

                                        <th>GG-2</th>

                                        <th>GG-3</th>

                                        <th>GG-4</th>

                                        <th>DG-1</th>

                                        <th>DG-2</th>

                                        <th>DG-3</th>

                                        <th>DG-4</th>

                                        <th>Solar</th>

                                        <th>Total</th>

                                        <th>Captive Gen.</th>

                                        <th>Ind. Boiler</th>

                                    </tr>

                                </thead>


                                <tbody id="temporaryBody">
                                </tbody>


                                <tfoot id="temporaryFooter"
                                       class="table-light d-none">

                                    <tr>

                                        <th colspan="13"
                                            class="text-end">

                                            Grand Total

                                        </th>

                                        <th id="grandTotal"
                                            class="text-primary">

                                            0.00

                                        </th>

                                        <th colspan="2">
                                        </th>

                                    </tr>

                                </tfoot>

                            </table>

                        </div>

                    </div>


                    <!-- ================================================= -->
                    <!-- HIDDEN POST DATA                                  -->
                    <!-- ================================================= -->

                    <div id="hiddenItemsContainer">
                    </div>


                    <!-- ================================================= -->
                    <!-- BUTTONS                                           -->
                    <!-- ================================================= -->

                    <div class="d-flex justify-content-between mt-4">

                        <a asp-action="DailyEnergyFuelConsumptionList"
                           class="btn btn-outline-secondary">

                            <i class="bi bi-arrow-left me-1"></i>

                            Back

                        </a>


                        <button type="submit"
                                id="saveAllButton"
                                class="btn btn-primary px-4">

                            <i class="bi bi-save me-1"></i>

                            Save All

                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>


<!-- ============================================================= -->
<!-- SAVING OVERLAY                                                -->
<!-- ============================================================= -->

<div id="savingOverlay"
     class="saving-overlay">

    <div class="saving-box">

        <div class="spinner-border text-primary mb-3"
             role="status">

            <span class="visually-hidden">
                Saving...
            </span>

        </div>

        <div class="fw-bold">
            Saving readings...
        </div>

        <small class="text-muted">
            Please wait.
        </small>

    </div>

</div>


@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        window.dailyEnergyConfig = {
            currentCompany: @Html.Raw(JsonSerializer.Serialize(currentCompany)),
            getAvailableTimesUrl: '@Url.Action("GetAvailableTimes")'
        };
    </script>

    <script src="~/js/dailyenergyfuelconsumption.js"
            asp-append-version="true"></script>
}