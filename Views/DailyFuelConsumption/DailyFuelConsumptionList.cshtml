@model IEnumerable<UtilityManagement.Models.TblDailyFuelConsumption>

@{
    ViewData["Title"] = "Daily Fuel Consumption List";

    int currentPage = ViewBag.CurrentPage;
    int totalPages = ViewBag.TotalPages;

    int pageSize = 15;
    int sl = (currentPage - 1) * pageSize;

    int startPage = Math.Max(1, currentPage - 2);
    int endPage = Math.Min(totalPages, currentPage + 2);

    bool canCreate = ViewBag.CanCreate ?? false;
    bool canEdit = ViewBag.CanEdit ?? false;
    bool canDelete = ViewBag.CanDelete ?? false;

    string search = ViewBag.SearchString ?? "";
}

<h2 class="text-center">Daily Fuel Consumption List</h2>
<!-- =====================================================
     SEARCH & ACTION BUTTONS
====================================================== -->

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">

    <!-- SEARCH -->

    <form method="get"
          asp-action="DailyStockConsumptionList"
          class="d-flex gap-2 align-items-center"
          id="searchForm">

        <input type="text"
               name="searchString"
               id="searchBox"
               value="@ViewBag.SearchString"
               class="form-control"
               placeholder="Search here..."
               autocomplete="off"
               style="width: 300px;" />

    </form>


    <!-- ACTION BUTTONS -->

    <div class="d-flex gap-2">

        @if (canCreate)
        {
            <a asp-action="Create"
               class="btn btn-primary">
                + Create
            </a>
        }

        <button type="button"
                class="btn btn-secondary"
                onclick="window.history.back();">
            Back
        </button>

    </div>

</div>



<!-- =====================================================
     TABLE
====================================================== -->

<div class="table-responsive">

    <table class="table table-bordered table-hover stock-table">

        <!-- =====================================================
             TABLE HEADER
        ====================================================== -->

        <thead>

            <!-- =================================================
                 MAIN GROUP HEADER
            ================================================== -->

            <tr class="text-center align-middle">

                <!-- SL -->

                <th rowspan="2"
                    class="sl-header">
                    SL
                </th>


                <!-- DATE -->

                <th rowspan="2"
                    class="date-header">
                    Date
                </th>


                <!-- COMPANY -->

                <th rowspan="2"
                    class="company-header">
                    Company
                </th>


                <!-- NG -->

                <th colspan="5"
                    class="ng-header">
                    NATURAL GAS (NG)
                </th>


                <!-- DIESEL -->

                <th colspan="5"
                    class="diesel-header">
                    DIESEL
                </th>


                <!-- CNG -->

                <th colspan="5"
                    class="cng-header">
                    CNG
                </th>


                <!-- LPG -->

                <th colspan="3"
                    class="lpg-header">
                    LPG
                </th>


                <!-- ACTIONS -->

                <th rowspan="2"
                    class="actions-header">
                    Actions
                </th>

            </tr>


            <!-- =================================================
                 SUB HEADER
            ================================================== -->

            <tr class="text-center align-middle">

                <!-- ==========================
                     NG
                =========================== -->

                <th class="ng-sub">
                    Generator
                </th>

                <th class="ng-sub">
                    Boiler
                </th>

                <th class="ng-sub">
                    Dye.Fin.
                </th>

                <th class="ng-sub thermal-sub">
                    Thermal H.
                </th>

                <th class="ng-total-sub total-sub">
                    Total
                </th>


                <!-- ==========================
                     DIESEL
                =========================== -->

                <th class="diesel-sub">
                    Generator
                </th>

                <th class="diesel-sub">
                    Boiler
                </th>

                <th class="diesel-sub">
                    F.Lift
                </th>

                <th class="diesel-sub thermal-sub">
                    Thermal H.
                </th>

                <th class="diesel-total-sub total-sub">
                    Total
                </th>


                <!-- ==========================
                     CNG
                =========================== -->

                <th class="cng-sub">
                    Generator
                </th>

                <th class="cng-sub">
                    Boiler
                </th>

                <th class="cng-sub">
                    Dye.Fin.
                </th>

                <th class="cng-sub thermal-sub">
                    Thermal H.
                </th>

                <th class="cng-total-sub total-sub">
                    Total
                </th>


                <!-- ==========================
                     LPG
                =========================== -->

                <th class="lpg-sub">
                    Boiler
                </th>

                <th class="lpg-sub thermal-sub">
                    Thermal H.
                </th>

                <th class="lpg-total-sub total-sub">
                    Total
                </th>

            </tr>

        </thead>



        <!-- =====================================================
             TABLE BODY
        ====================================================== -->

        <tbody>

            @foreach (var item in Model)
            {
                sl++;

                <tr class="align-middle text-center">

                    <!-- ==========================
                         SL
                    =========================== -->

                    <td class="text-center fw-semibold">
                        @sl
                    </td>


                    <!-- ==========================
                         DATE
                    =========================== -->

                    <td class="text-center date-cell">
                        @item.Trdate?.ToString("dd-MM-yyyy")
                    </td>


                    <!-- ==========================
                         COMPANY
                    =========================== -->

                    <td class="text-center company-cell">
                        @item.Company
                    </td>



                    <!-- =================================================
                         NG
                    ================================================== -->

                    <td class="text-center ng-cell">
                        @item.NgGenerator?.ToString("0")
                    </td>

                    <td class="text-center ng-cell">
                        @item.NgBoiler?.ToString("0")
                    </td>

                    <td class="text-center ng-cell">
                        @item.NgDfma?.ToString("0")
                    </td>

                    <td class="text-center ng-cell thermal-cell">
                        @item.NgThermalHeater?.ToString("0")
                    </td>

                    <td class="text-center ng-total total-cell">
                        @item.NgTotal?.ToString("0")
                    </td>



                    <!-- =================================================
                         DIESEL
                    ================================================== -->

                    <td class="text-center diesel-cell">
                        @item.DieselGenerator?.ToString("0")
                    </td>

                    <td class="text-center diesel-cell">
                        @item.DieselBoiler?.ToString("0")
                    </td>

                    <td class="text-center diesel-cell">
                        @item.DieselFl?.ToString("0")
                    </td>

                    <td class="text-center diesel-cell thermal-cell">
                        @item.DieselThermalHeater?.ToString("0")
                    </td>

                    <td class="text-center diesel-total total-cell">
                        @item.DieselTotal?.ToString("0")
                    </td>



                    <!-- =================================================
                         CNG
                    ================================================== -->

                    <td class="text-center cng-cell">
                        @item.CngGenerator?.ToString("0")
                    </td>

                    <td class="text-center cng-cell">
                        @item.CngBoiler?.ToString("0")
                    </td>

                    <td class="text-center cng-cell">
                        @item.CngDfma?.ToString("0")
                    </td>

                    <td class="text-center cng-cell thermal-cell">
                        @item.CngThermalHeater?.ToString("0")
                    </td>

                    <td class="text-center cng-total total-cell">
                        @item.CngTotal?.ToString("0")
                    </td>



                    <!-- =================================================
                         LPG
                    ================================================== -->

                    <td class="text-center lpg-cell">
                        @item.LpgBoiler?.ToString("0")
                    </td>

                    <td class="text-center lpg-cell thermal-cell">
                        @item.LpgThermalHeater?.ToString("0")
                    </td>

                    <td class="text-center lpg-total total-cell">
                        @item.LpgTotal?.ToString("0")
                    </td>



                    <!-- =================================================
                         ACTIONS
                    ================================================== -->

                    <td class="text-center">

                        <div class="d-flex justify-content-center align-items-center gap-2">

                            @if (canEdit)
                            {
                                <a asp-action="Edit"
                                   asp-route-id="@item.Trid"
                                   class="btn btn-success btn-sm">
                                    Edit
                                </a>
                            }


                            @if (canDelete)
                            {
                                <a asp-action="Delete"
                                   asp-route-id="@item.Trid"
                                   class="btn btn-danger btn-sm">
                                    Delete
                                </a>
                            }

                        </div>

                    </td>

                </tr>
            }

        </tbody>

    </table>

</div>



<!-- =====================================================
     PAGINATION
====================================================== -->

<ul class="pagination justify-content-center flex-wrap">

    <!-- PREVIOUS -->

    <li class="page-item @(currentPage == 1 ? "disabled" : "")">

        <a class="page-link"
           href="@Url.Action(
                                "DailyStockConsumptionList",
                                new
                                {
                                    page = currentPage - 1,
                                    searchString = search
                                })">
            Prev
        </a>

    </li>



    <!-- PAGE NUMBERS -->
    @for (int i = startPage; i <= endPage; i++)
    {
        <li class="page-item @(i == currentPage ? "active" : "")">

            <a class="page-link"
               href="@Url.Action(
                                        "DailyStockConsumptionList",
                                        new
                                        {
                                            page = i,
                                            searchString = search
                                        })">

            @i

            </a>

        </li>
        }



    <!-- NEXT -->

    <li class="page-item @(currentPage == totalPages ? "disabled" : "")">

        <a class="page-link"
           href="@Url.Action(
                                "DailyStockConsumptionList",
                                new
                                {
                                    page = currentPage + 1,
                                    searchString = search
                                })">
            Next
        </a>

    </li>

</ul>



