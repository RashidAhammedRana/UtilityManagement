@model UtilityManagement.ViewModels.DailyGasPressureRecordViewModel

@using System.Text.Json

@{
    ViewData["Title"] = "Create Daily Gas Pressure Record";

    var currentCompany = ViewBag.CurrentCompany as string ?? "";

    var existingTimes = ViewBag.ExistingTimes as List<string>
        ?? new List<string>();

    var nextAvailableTime = ViewBag.NextAvailableTime as string ?? "";
}

<link href="~/css/dailygaspressure.css" rel="stylesheet" />
<div class="row justify-content-center">

    <div class="col-md-12">

        <div class="card shadow-lg border-0 energy-card">

            <!-- ===================================================== -->
            <!-- HEADER                                                -->
            <!-- ===================================================== -->

            <div class="card-header bg-primary text-white">

                <h5 class="mb-0">

                    <i class="bi bi-speedometer2 me-1"></i>

                    Add Daily Gas Pressure Record

                </h5>

            </div>


            <!-- ===================================================== -->
            <!-- CARD BODY                                              -->
            <!-- ===================================================== -->

            <div class="card-body p-5">


                <!-- ================================================= -->
                <!-- MESSAGES                                          -->
                <!-- ================================================= -->
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show"
                         role="alert">

                        <i class="bi bi-exclamation-triangle me-1"></i>

                        @TempData["ErrorMessage"]

                        <button type="button"
                                class="btn-close"
                                data-bs-dismiss="alert">
                        </button>

                    </div>
                }


                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show"
                         role="alert">

                        <i class="bi bi-check-circle me-1"></i>

                        @TempData["SuccessMessage"]

                        <button type="button"
                                class="btn-close"
                                data-bs-dismiss="alert">
                        </button>

                    </div>
                }


                <!-- ================================================= -->
                <!-- FORM                                               -->
                <!-- ================================================= -->

                <form asp-action="Create"
                      method="post"
                      id="gasPressureForm">

                    @Html.AntiForgeryToken()


                    <!-- ================================================= -->
                    <!-- MODEL VALIDATION                                  -->
                    <!-- ================================================= -->

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3">
                    </div>


                    <!-- ================================================= -->
                    <!-- INPUT TABLE                                       -->
                    <!-- ================================================= -->

                    <div class="input-table-wrapper">

                        <table class="table table-bordered table-sm align-middle mb-0 energy-table">

                            <thead class="table-dark">

                                <tr>

                                    <th>
                                        Company
                                    </th>

                                    <th>
                                        Date
                                    </th>

                                    <th>
                                        Time
                                    </th>

                                    <th>
                                        Gas Pressure RMS Room Before Gas Regulator(PSI)
                                    </th>

                                    <th>
                                        Gas Pressure Industrial Run(PSI)
                                    </th>

                                    <th>
                                        Gas Pressure Captive Run(PSI)
                                    </th>

                                    <th>
                                        Remarks
                                    </th>

                                    <th>
                                        Add
                                    </th>

                                </tr>

                            </thead>


                            <tbody>

                                <tr id="inputRow">


                                    <!-- ================================================= -->
                                    <!-- COMPANY                                         -->
                                    <!-- ================================================= -->

                                    <td>

                                        <input type="text"
                                               id="inputCompany"
                                               class="form-control form-control-sm"
                                               value="@currentCompany"
                                               readonly />

                                    </td>


                                    <!-- ================================================= -->
                                    <!-- DATE                                            -->
                                    <!-- ================================================= -->

                                    <td>

                                        <input type="date"
                                               id="inputDate"
                                               class="form-control form-control-sm"
                                               value="@DateTime.Today.ToString("yyyy-MM-dd")"
                                               required />

                                    </td>


                                    <!-- ================================================= -->
                                    <!-- TIME                                            -->
                                    <!-- ================================================= -->

                                    <td>

                                        <input type="text"
                                               id="inputTimeDisplay"
                                               class="form-control form-control-sm time-display"
                                               value=""
                                               readonly />

                                        <input type="hidden"
                                               id="inputTime"
                                               value="@nextAvailableTime" />

                                    </td>


                                    <!-- ================================================= -->
                                    <!-- GP BEFORE                                       -->
                                    <!-- ================================================= -->

                                    <td>

                                        <input type="number"
                                               id="inputGpBefore"
                                               step="any"
                                               class="form-control form-control-sm pressure-input"
                                               autocomplete="off" />

                                    </td>


                                    <!-- ================================================= -->
                                    <!-- GP IR                                            -->
                                    <!-- ================================================= -->

                                    <td>

                                        <input type="number"
                                               id="inputGpIr"
                                               step="any"
                                               class="form-control form-control-sm pressure-input"
                                               autocomplete="off" />

                                    </td>


                                    <!-- ================================================= -->
                                    <!-- GP CR                                            -->
                                    <!-- ================================================= -->

                                    <td>

                                        <input type="number"
                                               id="inputGpCr"
                                               step="any"
                                               class="form-control form-control-sm pressure-input"
                                               autocomplete="off" />

                                    </td>


                                    <!-- ================================================= -->
                                    <!-- REMARKS                                         -->
                                    <!-- ================================================= -->

                                    <td>

                                        <input type="text"
                                               id="inputRemarks"
                                               class="form-control form-control-sm"
                                               autocomplete="off" />

                                    </td>


                                    <!-- ================================================= -->
                                    <!-- ADD BUTTON                                      -->
                                    <!-- ================================================= -->

                                    <td class="text-center">

                                        <button type="button"
                                                id="addRow"
                                                class="btn btn-primary btn-sm"
                                                title="Add Gas Pressure Reading">

                                            <i class="bi bi-plus-lg"></i>

                                        </button>

                                    </td>

                                </tr>

                            </tbody>

                        </table>

                    </div>


                    <!-- ================================================= -->
                    <!-- TIME FULL MESSAGE                                 -->
                    <!-- ================================================= -->

                    <div id="timeFullMessage"
                         class="time-full-message mt-2 d-none">

                        <i class="bi bi-exclamation-circle me-1"></i>

                        All 24 hourly slots for this date have already
                        been entered.

                    </div>


                    <!-- ================================================= -->
                    <!-- GAS PRESSURE LIST                                 -->
                    <!-- ================================================= -->

                    <div class="mt-4">

                        <h6 class="fw-bold text-primary mb-2">

                            <i class="bi bi-list-ul me-1"></i>

                            Gas Pressure List

                        </h6>


                        <div class="table-responsive">

                            <table class="table table-bordered table-sm align-middle"
                                   id="temporaryTable">

                                <thead class="table-secondary">

                                    <tr>

                                        <th>
                                            Company
                                        </th>

                                        <th>
                                            Date
                                        </th>

                                        <th>
                                            Time
                                        </th>

                                        <th>
                                            Gas Pressure RMS Room Before Gas Regulator(PSI)
                                        </th>

                                        <th>
                                            Gas Pressure Industrial Run(PSI)
                                        </th>

                                        <th>
                                            Gas Pressure Captive Run(PSI)
                                        </th>

                                        <th>
                                            Remarks
                                        </th>

                                    </tr>

                                </thead>


                                <tbody id="temporaryBody">
                                </tbody>

                            </table>

                        </div>

                    </div>


                    <!-- ================================================= -->
                    <!-- HIDDEN POST DATA                                  -->
                    <!-- ================================================= -->

                    <div id="hiddenItemsContainer">
                    </div>


                    <!-- ================================================= -->
                    <!-- BUTTONS                                           -->
                    <!-- ================================================= -->

                    <div class="d-flex justify-content-between mt-4">

                        <a asp-action="DailyGasPressureRecordList"
                           class="btn btn-outline-secondary">

                            <i class="bi bi-arrow-left me-1"></i>

                            Back

                        </a>


                        <button type="submit"
                                id="saveAllButton"
                                class="btn btn-primary px-4">

                            <i class="bi bi-save me-1"></i>

                            Save All

                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>


<!-- ============================================================= -->
<!-- SAVING OVERLAY                                                -->
<!-- ============================================================= -->



<div id="savingOverlay">

    <div class="saving-card">

        <div class="saving-spinner"></div>

        <div class="saving-title">
            Saving Data
        </div>

        <div class="saving-message">
            Please wait while your readings are being saved...
        </div>

    </div>

</div>



@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        window.gasPressureConfig = {
            currentCompany:
                @Html.Raw(
                    JsonSerializer.Serialize(currentCompany)
                        ),

        getAvailableTimesUrl:
            '@Url.Action("GetAvailableTimes")'
    };
</script>

<script src="~/js/dailygaspressure.js" asp-append-version="true"></script>
}
