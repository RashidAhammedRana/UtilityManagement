@model UtilityManagement.Models.TblDailyGasPressureRecord

@{
    ViewData["Title"] = "Edit Daily Gas Pressure Record";
}


<!-- =============================================================
     DAILY GAS PRESSURE EDIT PAGE
============================================================== -->

<div class="daily-gas-page">

    <div class="gas-card">

        <!-- =====================================================
             HEADER
        ====================================================== -->

        <div class="gas-card-header">

            <div class="gas-header-title">

                <i class="bi bi-pencil-square"></i>

                <span>Edit Daily Gas Pressure Record</span>

            </div>

        </div>


        <!-- =====================================================
             BODY
        ====================================================== -->

        <div class="gas-card-body">

            <form asp-action="Edit"
                  method="post"
                  id="editDailyGasPressureForm">

                @Html.AntiForgeryToken()


                <!-- =================================================
                     HIDDEN ID
                ================================================== -->

                <input type="hidden"
                       asp-for="Trid" />


                <!-- =================================================
                     VALIDATION
                ================================================== -->

                <div asp-validation-summary="ModelOnly"
                     class="text-danger gas-validation-summary">
                </div>


                <!-- =================================================
                     MAIN INPUT GRID
                ================================================== -->

                <div class="gas-edit-grid">


                    <!-- =================================================
                         COMPANY
                    ================================================== -->

                    <div class="gas-field company-field">

                        <label asp-for="Company">
                            Company
                        </label>

                        <input asp-for="Company"
                               class="form-control"
                               readonly />

                        <span asp-validation-for="Company"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- =================================================
                         DATE
                    ================================================== -->

                    <div class="gas-field date-field">

                        <label asp-for="Trdate">
                            Date
                        </label>

                        <input asp-for="Trdate"
                               type="date"
                               class="form-control" />

                        <span asp-validation-for="Trdate"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- =================================================
                         TIME
                    ================================================== -->

                    <div class="gas-field time-field">

                        <label asp-for="Time">
                            Time
                        </label>

                        <input asp-for="Time"
                               type="time"
                               class="form-control" />

                        <span asp-validation-for="Time"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- =================================================
                         GP BEFORE
                    ================================================== -->

                    <div class="gas-field pressure-field">

                        <label asp-for="GpBefore">
                            <span>
                                Gas Pressure RMS Room
                            </span>
                            <span>
                                Before Gas Regulator
                            </span>
                            <span class="psi">
                                (PSI)
                            </span>
                        </label>

                        <input asp-for="GpBefore"
                               type="number"
                               step="any"
                               class="form-control" />

                        <span asp-validation-for="GpBefore"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- =================================================
                         GP INDUSTRIAL RUN
                    ================================================== -->

                    <div class="gas-field pressure-field run-field">

                        <label asp-for="GpIr">
                            <span>
                                Industrial
                            </span>
                            <span>
                                Run
                            </span>
                            <span class="psi">
                                (PSI)
                            </span>
                        </label>

                        <input asp-for="GpIr"
                               type="number"
                               step="any"
                               class="form-control" />

                        <span asp-validation-for="GpIr"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- =================================================
                         GP CAPTIVE RUN
                    ================================================== -->

                    <div class="gas-field pressure-field run-field">

                        <label asp-for="GpCr">
                            <span>
                                Captive
                            </span>
                            <span>
                                Run
                            </span>
                            <span class="psi">
                                (PSI)
                            </span>
                        </label>

                        <input asp-for="GpCr"
                               type="number"
                               step="any"
                               class="form-control" />

                        <span asp-validation-for="GpCr"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- =================================================
                         REMARKS
                    ================================================== -->

                    <div class="gas-field remarks-field">

                        <label asp-for="Remarks">
                            Remarks
                        </label>

                        <input asp-for="Remarks"
                               type="text"
                               class="form-control" />

                        <span asp-validation-for="Remarks"
                              class="text-danger">
                        </span>

                    </div>

                </div>


                <!-- =================================================
                     BUTTONS
                ================================================== -->

                <div class="gas-form-buttons">

                    <a asp-action="DailyGasPressureRecordList"
                       class="btn btn-secondary">

                        <i class="bi bi-arrow-left me-1"></i>

                        Back

                    </a>


                    <button type="submit"
                            class="btn btn-success">

                        <i class="bi bi-check-circle me-1"></i>

                        Update

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>

<style>

    /* =========================================================
               GLOBAL PAGE
            ========================================================== */

    .daily-gas-page {
        width: 100%;
        max-width: 100%;
        min-width: 0;
        padding-top: 38px;
        padding-right: 0;
        padding-bottom: 20px;
        padding-left: 0;
        overflow-x: hidden;
    }


    /* =========================================================
               CARD
            ========================================================== */

    .gas-card {
        width: 100%;
        max-width: 100%;
        min-width: 0;
        background: #ffffff;
        border: 1px solid #e1e5e9;
        border-radius: 15px;
        overflow: hidden;
        box-shadow: 0 4px 18px rgba(0, 0, 0, .10);
    }


    /* =========================================================
               HEADER
            ========================================================== */

    .gas-card-header {
        width: 100%;
        min-height: 52px;
        display: flex;
        align-items: center;
        padding: 10px 18px;
        color: #ffffff;
        background: linear-gradient( 135deg, #198754, #157347 );
        border-radius: 15px 15px 0 0;
    }


    .gas-header-title {
        display: flex;
        align-items: center;
        gap: 7px;
        font-size: 17px;
        font-weight: 600;
        line-height: 1.2;
        min-width: 0;
    }


        .gas-header-title i {
            flex-shrink: 0;
        }


    /* =========================================================
               BODY
            ========================================================== */

    .gas-card-body {
        width: 100%;
        min-width: 0;
        padding: 20px;
    }


    /* =========================================================
               VALIDATION SUMMARY
            ========================================================== */

    .gas-validation-summary {
        font-size: 11px;
        margin-bottom: 8px;
    }


    /* =========================================================
               MAIN GRID

               COMPANY = LARGE
               DATE    = LARGE
               TIME    = MEDIUM/LARGE

               PRESSURE 3 = SMALL

               REMARKS = MEDIUM
            ========================================================== */

    .gas-edit-grid {
        display: grid;
        width: 100%;
        min-width: 0;
        /*
                    Company
                    Date
                    Time
                    GP Before
                    GP Industrial
                    GP Captive
                    Remarks
                */

        grid-template-columns: 1.35fr 1.15fr 0.95fr 0.72fr 0.62fr 0.62fr 1.00fr;
        column-gap: 8px;
        row-gap: 0;
        align-items: start;
    }


    /* =========================================================
               FIELD
            ========================================================== */

    .gas-field {
        min-width: 0;
        width: 100%;
        position: relative;
    }


        /* =========================================================
               LABEL
            ========================================================== */

        .gas-field label {
            display: flex;
            align-items: flex-start;
            flex-wrap: wrap;
            width: 100%;
            min-width: 0;
            min-height: 30px;
            margin-bottom: 4px;
            color: #374151;
            font-size: 11px;
            font-weight: 600;
            line-height: 1.15;
            white-space: normal;
            overflow: hidden;
        }


    /* =========================================================
               PRESSURE LABEL

               Label can use 2 lines.
               PSI stays beside the label.
            ========================================================== */

    .pressure-field label {
        display: block;
        min-height: 30px;
        font-size: 10px;
        line-height: 1.12;
        overflow: hidden;
    }


        .pressure-field label span:not(.psi) {
            display: inline;
        }


    /* =========================================================
               PSI

               NOT inside input
               ONLY beside label
            ========================================================== */

    .pressure-field .psi {
        display: inline;
        margin-left: 2px;
        color: #6b7280;
        font-size: 9px;
        font-weight: 700;
        white-space: nowrap;
    }


    /* =========================================================
               INPUT
            ========================================================== */

    .gas-field .form-control {
        width: 100%;
        min-width: 0;
        height: 36px;
        padding: 5px 7px;
        font-size: 12px;
        line-height: 1.2;
        border-radius: 5px;
        border: 1px solid #ced4da;
        box-shadow: none;
    }


    /* =========================================================
               COMPANY
            ========================================================== */

    .company-field .form-control {
        font-size: 11px;
        font-weight: 500;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }


    .company-field input[readonly] {
        background-color: #edf0f3 !important;
        color: #495057 !important;
        border-color: #ced4da !important;
        cursor: not-allowed;
    }


    /* =========================================================
               DATE
            ========================================================== */

    .date-field .form-control {
        font-size: 11px;
    }


    /* =========================================================
               TIME
            ========================================================== */

    .time-field .form-control {
        font-size: 12px;
        min-width: 0;
    }


    /* =========================================================
               PRESSURE INPUT

               Smaller than Company / Date / Time
            ========================================================== */

    .pressure-field .form-control {
        height: 36px;
        padding: 5px 4px;
        font-size: 11px;
        text-align: center;
    }


    /* =========================================================
               REMARKS
            ========================================================== */

    .remarks-field .form-control {
        font-size: 11px;
    }


    /* =========================================================
               REMOVE NUMBER SPINNER
            ========================================================== */

    input[type="number"]::-webkit-inner-spin-button,
    input[type="number"]::-webkit-outer-spin-button {
        -webkit-appearance: none;
        margin: 0;
    }


    input[type="number"] {
        -moz-appearance: textfield;
        appearance: textfield;
    }


    /* =========================================================
               VALIDATION
            ========================================================== */

    .gas-field .text-danger {
        display: block;
        width: 100%;
        font-size: 9px;
        line-height: 1.05;
        margin-top: 2px;
        overflow: hidden;
    }


    /* =========================================================
               BUTTONS
            ========================================================== */

    .gas-form-buttons {
        display: flex;
        justify-content: space-between;
        align-items: center;
        width: 100%;
        margin-top: 18px;
    }


        .gas-form-buttons .btn {
            min-height: 36px;
            white-space: nowrap;
        }


    /* =========================================================
               FOCUS
            ========================================================== */

    .gas-field .form-control:focus {
        border-color: #198754;
        box-shadow: 0 0 0 .15rem rgba(25, 135, 84, .12);
    }


    /* =========================================================
               MOBILE PORTRAIT

               KEEP ALL 7 FIELDS IN ONE ROW
            ========================================================== */

    @@media (max-width: 768px) {

        .daily-gas-page {
            width: 100%;
            padding-top: 48px;
            padding-left: 1px;
            padding-right: 1px;
            padding-bottom: 10px;
        }


        .gas-card {
            width: 100%;
            border-radius: 12px;
        }
        /* -----------------------------------------------------
                   HEADER
                ------------------------------------------------------ */

        .gas-card-header {
            min-height: 43px;
            padding: 7px 10px;
            border-radius: 12px 12px 0 0;
        }


        .gas-header-title {
            font-size: 13px;
            gap: 5px;
        }
        /* -----------------------------------------------------
                   BODY
                ------------------------------------------------------ */

        .gas-card-body {
            padding: 9px 3px;
        }
        /* -----------------------------------------------------
                   IMPORTANT:
                   ALL FIELDS STAY IN ONE ROW
                ------------------------------------------------------ */

        .gas-edit-grid {
            grid-template-columns: 1.40fr /* Company */
            1.18fr /* Date */
            1.00fr /* Time */
            0.62fr /* GP Before */
            0.56fr /* GP IR */
            0.56fr /* GP CR */
            0.92fr; /* Remarks */

            column-gap: 3px;
            width: 100%;
        }
        /* -----------------------------------------------------
                   LABEL
                ------------------------------------------------------ */

        .gas-field label {
            min-height: 25px;
            height: 25px;
            margin-bottom: 2px;
            font-size: 7.5px;
            line-height: 1.05;
            overflow: hidden;
        }
        /* -----------------------------------------------------
                   PRESSURE LABEL

                   2 lines allowed
                ------------------------------------------------------ */

        .pressure-field label {
            min-height: 26px;
            height: 26px;
            margin-bottom: 2px;
            font-size: 6.8px;
            line-height: 1.04;
            overflow: hidden;
        }
        /* -----------------------------------------------------
                   PSI BESIDE LABEL
                ------------------------------------------------------ */

        .pressure-field .psi {
            margin-left: 1px;
            font-size: 6px;
            font-weight: 700;
            white-space: nowrap;
        }
        /* -----------------------------------------------------
                   GENERAL INPUT
                ------------------------------------------------------ */

        .gas-field .form-control {
            height: 29px;
            padding: 2px 3px;
            font-size: 9px;
            border-radius: 3px;
        }
        /* -----------------------------------------------------
                   COMPANY

                   Larger than pressure fields
                ------------------------------------------------------ */

        .company-field .form-control {
            font-size: 7.7px;
            padding-left: 3px;
            padding-right: 3px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }
        /* -----------------------------------------------------
                   DATE

                   Larger than pressure fields
                ------------------------------------------------------ */

        .date-field .form-control {
            font-size: 7.8px;
            padding-left: 2px;
            padding-right: 2px;
        }
        /* -----------------------------------------------------
                   TIME

                   Slightly larger
                ------------------------------------------------------ */

        .time-field .form-control {
            font-size: 8.5px;
            padding-left: 2px;
            padding-right: 2px;
        }
        /* -----------------------------------------------------
                   PRESSURE

                   SMALL
                ------------------------------------------------------ */

        .pressure-field .form-control {
            height: 28px;
            padding: 2px;
            font-size: 8px;
            text-align: center;
        }
        /* -----------------------------------------------------
                   REMARKS
                ------------------------------------------------------ */

        .remarks-field .form-control {
            font-size: 8px;
            padding-left: 3px;
            padding-right: 3px;
        }
        /* -----------------------------------------------------
                   VALIDATION
                ------------------------------------------------------ */

        .gas-field .text-danger {
            font-size: 7px;
            line-height: 1;
            margin-top: 1px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }
        /* -----------------------------------------------------
                   BUTTONS
                ------------------------------------------------------ */

        .gas-form-buttons {
            margin-top: 11px;
        }


            .gas-form-buttons .btn {
                min-height: 29px;
                padding: 4px 8px;
                font-size: 10px;
            }
    }


    /* =========================================================
               SMALL PORTRAIT

               320px - 420px
            ========================================================== */

    @@media (max-width: 420px) {

        .daily-gas-page {
            padding-top: 45px;
            padding-left: 0;
            padding-right: 0;
        }


        .gas-card {
            border-radius: 11px;
        }


        .gas-card-header {
            min-height: 41px;
            padding: 6px 8px;
            border-radius: 11px 11px 0 0;
        }


        .gas-header-title {
            font-size: 12px;
            gap: 4px;
        }


        .gas-card-body {
            padding: 7px 2px;
        }
        /* -----------------------------------------------------
                   ONE ROW - VERY TIGHT
                ------------------------------------------------------ */

        .gas-edit-grid {
            grid-template-columns: 1.42fr 1.18fr 1.00fr 0.60fr 0.54fr 0.54fr 0.90fr;
            column-gap: 2px;
        }
        /* -----------------------------------------------------
                   LABEL
                ------------------------------------------------------ */

        .gas-field label {
            height: 26px;
            min-height: 26px;
            font-size: 6.7px;
            line-height: 1.02;
            margin-bottom: 2px;
        }


        .pressure-field label {
            height: 27px;
            min-height: 27px;
            font-size: 6.2px;
            line-height: 1.01;
        }


        .pressure-field .psi {
            font-size: 5.7px;
            margin-left: 1px;
        }
        /* -----------------------------------------------------
                   INPUT
                ------------------------------------------------------ */

        .gas-field .form-control {
            height: 27px;
            padding: 2px;
            font-size: 8px;
            border-radius: 3px;
        }
        /* -----------------------------------------------------
                   COMPANY
                ------------------------------------------------------ */

        .company-field .form-control {
            font-size: 6.7px;
            padding-left: 2px;
            padding-right: 2px;
        }
        /* -----------------------------------------------------
                   DATE
                ------------------------------------------------------ */

        .date-field .form-control {
            font-size: 6.8px;
            padding-left: 1px;
            padding-right: 1px;
        }
        /* -----------------------------------------------------
                   TIME
                ------------------------------------------------------ */

        .time-field .form-control {
            font-size: 7.5px;
            padding-left: 1px;
            padding-right: 1px;
        }
        /* -----------------------------------------------------
                   PRESSURE
                ------------------------------------------------------ */

        .pressure-field .form-control {
            height: 26px;
            font-size: 7.4px;
            padding: 1px;
        }
        /* -----------------------------------------------------
                   REMARKS
                ------------------------------------------------------ */

        .remarks-field .form-control {
            font-size: 7px;
            padding: 2px;
        }
        /* -----------------------------------------------------
                   BUTTONS
                ------------------------------------------------------ */

        .gas-form-buttons {
            margin-top: 9px;
        }


            .gas-form-buttons .btn {
                min-height: 26px;
                padding: 3px 6px;
                font-size: 9px;
            }
    }


    /* =========================================================
               VERY SMALL PORTRAIT

               <= 350px
            ========================================================== */

    @@media (max-width: 350px) {

        .daily-gas-page {
            padding-top: 43px;
        }


        .gas-card-body {
            padding: 6px 1px;
        }


        .gas-edit-grid {
            grid-template-columns: 1.40fr 1.16fr 0.98fr 0.58fr 0.52fr 0.52fr 0.84fr;
            column-gap: 1.5px;
        }


        .gas-field label {
            font-size: 6.2px;
            height: 27px;
            min-height: 27px;
        }


        .pressure-field label {
            font-size: 5.9px;
            height: 28px;
            min-height: 28px;
        }


        .pressure-field .psi {
            font-size: 5.4px;
        }


        .gas-field .form-control {
            height: 26px;
            font-size: 7.5px;
            padding: 1px 2px;
        }


        .company-field .form-control {
            font-size: 6px;
        }


        .date-field .form-control {
            font-size: 6.2px;
        }


        .time-field .form-control {
            font-size: 6.8px;
        }


        .pressure-field .form-control {
            height: 25px;
            font-size: 7px;
        }


        .remarks-field .form-control {
            font-size: 6.5px;
        }


        .gas-form-buttons .btn {
            min-height: 25px;
            font-size: 8.5px;
            padding: 3px 5px;
        }
    }


    /* =========================================================
               MOBILE LANDSCAPE

               <= 900px
            ========================================================== */

    @@media (max-width: 900px) and (orientation: landscape) {

        .daily-gas-page {
            padding-top: 28px;
            padding-left: 3px;
            padding-right: 3px;
            padding-bottom: 10px;
        }


        .gas-card-body {
            padding: 10px 6px;
        }
        /* -----------------------------------------------------
                   ONE ROW
                ------------------------------------------------------ */

        .gas-edit-grid {
            grid-template-columns: 1.38fr 1.18fr 1.00fr 0.64fr 0.57fr 0.57fr 0.92fr;
            column-gap: 4px;
        }


        .gas-field label {
            height: 21px;
            min-height: 21px;
            font-size: 7.5px;
            line-height: 1.04;
        }


        .pressure-field label {
            height: 22px;
            min-height: 22px;
            font-size: 7px;
        }


        .pressure-field .psi {
            font-size: 6.5px;
        }


        .gas-field .form-control {
            height: 29px;
            font-size: 9px;
            padding: 3px 4px;
        }


        .company-field .form-control {
            font-size: 8px;
        }


        .date-field .form-control {
            font-size: 8px;
        }


        .time-field .form-control {
            font-size: 8.5px;
        }


        .pressure-field .form-control {
            height: 28px;
            font-size: 8px;
            padding: 2px;
            text-align: center;
        }


        .remarks-field .form-control {
            font-size: 8px;
        }


        .gas-form-buttons {
            margin-top: 11px;
        }
    }


    /* =========================================================
               LANDSCAPE - SHORT SCREEN

               Prevent excessive vertical spacing
            ========================================================== */

    @@media (max-height: 500px) and (orientation: landscape) {

        .daily-gas-page {
            padding-top: 20px;
        }


        .gas-card-header {
            min-height: 40px;
            padding: 6px 12px;
        }


        .gas-card-body {
            padding: 8px;
        }


        .gas-form-buttons {
            margin-top: 8px;
        }
    }

</style>

<!-- =============================================================
     RESPONSIVE CSS
============================================================== -->




@section Scripts {

    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial"
        );
    }

}
