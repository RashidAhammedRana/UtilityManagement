@model UtilityManagement.Models.TblElectricityInterruptionInfo

@{
    ViewData["Title"] = "Edit Utility Interruption Reading";
}

<style>
    /* =========================================================
       UTILITY INTERRUPTION EDIT FORM
       REDUCE LEFT / RIGHT SPACE
       ========================================================= */

    /* Main page container */
    .container {
        max-width: 100% !important;
        padding-left: 8px !important;
        padding-right: 8px !important;
    }

        /* Main row */
        .container > .row {
            margin-left: 0 !important;
            margin-right: 0 !important;
        }

            /* Main column */
            .container > .row > .col-md-12 {
                padding-left: 0 !important;
                padding-right: 0 !important;
            }

    /* =========================================================
       CARD
       ========================================================= */

    .card {
        width: 100%;
        margin-left: 0 !important;
        margin-right: 0 !important;
    }

    /* Card body */
    .card-body {
        padding-left: 12px !important;
        padding-right: 12px !important;
    }

        /* =========================================================
       FORM ROW
       ========================================================= */

        .card-body form .row {
            margin-left: -4px !important;
            margin-right: -4px !important;
        }

            /* Form columns */
            .card-body form .row > [class*="col-"] {
                padding-left: 4px !important;
                padding-right: 4px !important;
            }

        /* =========================================================
       INPUT / SELECT
       ========================================================= */

        .card-body .form-control,
        .card-body .form-select {
            width: 100%;
            box-sizing: border-box;
        }

        /* =========================================================
       BUTTON AREA
       ========================================================= */

        .card-body form > .d-flex {
            margin-left: 0 !important;
            margin-right: 0 !important;
        }

    /* =========================================================
       MOBILE
       ========================================================= */

    @@media screen and (max-width: 767.98px) {
        .container

    {
        width: 100% !important;
        max-width: 100% !important;
        padding-left: 4px !important;
        padding-right: 4px !important;
        margin-left: 0 !important;
        margin-right: 0 !important;
    }

    .card-body {
        padding-left: 8px !important;
        padding-right: 8px !important;
    }

        .card-body form .row {
            margin-left: -3px !important;
            margin-right: -3px !important;
        }

            .card-body form .row > [class*="col-"] {
                padding-left: 3px !important;
                padding-right: 3px !important;
            }

            /* Smaller vertical gap too */
            .card-body form .row.g-3 {
                row-gap: 8px !important;
            }

        .card-body form > .d-flex {
            margin-top: 12px !important;
        }

    }

    /* =========================================================
       CARD HEADER - ROUNDED / CURVED
       ========================================================= */

    .card .card-header {
        border-radius: 10px 10px 0 0 !important;
        overflow: hidden;
    }

    /* Optional: slightly more rounded */
    .card {
        border-radius: 10px !important;
        overflow: hidden;
    }



    /* =========================================================
       VERY SMALL MOBILE
       ========================================================= */

    @@media screen and (max-width: 400px) {
        .container

    {
        padding-left: 2px !important;
        padding-right: 2px !important;
    }

    .card-body {
        padding-left: 6px !important;
        padding-right: 6px !important;
    }

        .card-body form .row > [class*="col-"] {
            padding-left: 2px !important;
            padding-right: 2px !important;
        }

    }
</style>

<div class="container mt-4">

    <div class="row justify-content-center">
        <div class="col-md-12">

            <div class="card shadow-lg border-0">

                <div class="card-header bg-success text-white">
                    <h5 class="mb-0">Edit Utility Interruption Reading</h5>
                </div>

                <div class="card-body">

                    <form asp-action="Edit" method="post">
                        <input asp-for="Eiid" hidden />
                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>

                        <div class="row g-3">
                            <!-- Company -->
                            <div class="col-lg-4 col-md-4 col-sm-6">
                                <label asp-for="Comid" class="form-label">
                                    Company <span class="text-danger">*</span>
                                </label>
                                <select asp-for="Comid" asp-items="ViewBag.CompanyList" class="form-select">
                                    <option value="">-- Select Company --</option>
                                </select>
                                <span asp-validation-for="Comid" class="text-danger"></span>
                            </div>
                            <!-- Date -->
                            <div class="col-lg-4 col-md-3 col-sm-6">
                                <label asp-for="Date" id="Date" class="form-label">
                                    Date <span class="text-danger">*</span>
                                </label>
                                <input asp-for="Date" type="date" class="form-control" />
                                <span asp-validation-for="Date" class="text-danger"></span>
                            </div>
                            <!-- Department -->
                            <div class="col-lg-4 col-md-4 col-sm-6">
                                <label asp-for="Depid" class="form-label">
                                    Department 
                                    @* <span class="text-danger">*</span> *@
                                </label>
                                <select asp-for="Depid" asp-items="ViewBag.DepartmentList" class="form-select">
                                    <option value="">-- Select Department --</option>
                                </select>
                                @* <span asp-validation-for="Depid" class="text-danger"></span> *@
                            </div>
                            <!-- PowerOffTime -->
                            <div class="col-lg-4 col-md-4 col-sm-6">
                                <label asp-for="PowerOffTime" class="form-label">
                                    Power Off Time <span class="text-danger">*</span>
                                </label>
                                <input asp-for="PowerOffTime" id="PowerOffTime" type="datetime-local" class="form-control" />
                            </div>
                            <!-- PowerOnTime -->
                            <div class="col-lg-4 col-md-4 col-sm-6">
                                <label asp-for="PowerOnTime" class="form-label">
                                    Power On Time <span class="text-danger">*</span>
                                </label>
                                <input asp-for="PowerOnTime" id="PowerOnTime" type="datetime-local" class="form-control" />
                            </div>
                            <!-- DurationMin -->
                            <div class="col-lg-4 col-md-4 col-sm-6">
                                <label asp-for="DurationMin" class="form-label">
                                    Duration (Min) <span class="text-danger">*</span>
                                </label>
                                <input asp-for="DurationMin" id="DurationMin" class="form-control" readonly />
                            </div>
                            <!-- Interruption Type -->
                            <div class="col-lg-4 col-md-4 col-sm-6">
                                <label asp-for="Itid" class="form-label">
                                    Interruption Type <span class="text-danger">*</span>
                                </label>
                                <select asp-for="Itid"
                                        asp-items="ViewBag.InterruptiotypeList"
                                        id="InterruptionType"
                                        class="form-select">
                                    <option value="">-- Select type --</option>
                                </select>
                                <span asp-validation-for="Itid" class="text-danger"></span>
                            </div>
                            <!-- Reason -->
                            <div class="col-lg-4 col-md-4 col-sm-6">
                                <label asp-for="Rid" class="form-label">
                                    Reason <span class="text-danger">*</span>
                                </label>
                                <select asp-for="Rid"
                                        asp-items="ViewBag.ReasonList"
                                        id="Reason"
                                        class="form-select">
                                    <option value="">-- Select Reason --</option>
                                </select>
                            </div>
                            <!-- Remarks -->
                            <div class="col-lg-4 col-md-4 col-sm-6">
                                <label asp-for="Remarks" class="form-label">
                                    Remarks
                                </label>
                                <input asp-for="Remarks" class="form-control" />
                            </div>

                        </div>

                        <div class="d-flex justify-content-between mt-4">

                            <a asp-action="ElectricityInterruptionInfoList"
                               class="btn btn-secondary">
                                ← Back
                            </a>

                            <button type="submit"
                                    class="btn btn-success px-4">
                                Update
                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>
    </div>

</div>
<script>

    function loadReasons(itid) {

        $("#Reason").empty();
        $("#Reason").append('<option value="">-- Select Reason --</option>');

        if (itid) {

            $.getJSON('/ElectricityInterruptionInfo/GetReasonsByType',
                { itid: itid },
                function (data) {

                    $.each(data, function (i, item) {

                        $("#Reason").append(
                            $('<option></option>')
                                .val(item.value)
                                .text(item.text)
                        );

                    });

                    // keep existing selected reason in edit
                    var selectedReason = '@Model.Rid';

                    if (selectedReason) {
                        $("#Reason").val(selectedReason);
                    }

                });
        }
    }


    $("#InterruptionType").change(function () {

        loadReasons($(this).val());

    });


    // Edit page load
    $(document).ready(function () {

        var currentType = $("#InterruptionType").val();

        if (currentType) {
            loadReasons(currentType);
        }

    });


    // Duration Calculation
    $(function () {

        function calculateDuration() {

            let start = $("#PowerOffTime").val();
            let end = $("#PowerOnTime").val();

            if (start && end) {

                let startTime = new Date(start);
                let endTime = new Date(end);

                let diff = (endTime - startTime) / 60000;

                if (diff >= 0)
                    $("#DurationMin").val(diff);
                else
                    $("#DurationMin").val("");
            }
        }

        $("#PowerOffTime,#PowerOnTime").on("change", calculateDuration);

    });

</script>
