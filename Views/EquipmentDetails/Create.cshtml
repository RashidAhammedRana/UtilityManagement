@model UtilityManagement.Models.TblEquipmentDetail

@{
    ViewData["Title"] = "Create Equipment Details";
    bool isAdmin = ViewBag.IsAdmin ?? false;
}

<div class="container mt-4">

    <div class="row justify-content-center">
        <div class="col-md-10">

            <div class="card shadow-lg border-0">

                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Add New Equipment</h5>
                </div>

                <div class="card-body p-4">

                    <form asp-action="Create" method="post">

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>

                        <div class="row g-3">

                            <div class="col-lg-4 col-md-4 col-sm-6">
                                <label class="form-label">
                                    Equipment Name <span class="text-danger">*</span>
                                </label>
                                <input asp-for="EquipmentName" class="form-control required-field" readonly="@(!isAdmin)" />
                                <span asp-validation-for="EquipmentName" class="text-danger"></span>
                            </div>

                            <div class="col-lg-2 col-md-4 col-sm-6">
                                <label class="form-label">
                                    Capacity <span class="text-danger">*</span>
                                </label>
                                <input asp-for="Capacity" class="form-control required-field" readonly="@(!isAdmin)" />
                                <span asp-validation-for="Capacity" class="text-danger"></span>
                            </div>

                            <div class="col-lg-3 col-md-4 col-sm-6">
                                <label class="form-label">
                                    Brand <span class="text-danger">*</span>
                                </label>
                                <input asp-for="Brand" class="form-control required-field" readonly="@(!isAdmin)" />
                                <span asp-validation-for="Brand" class="text-danger"></span>
                            </div>

                            <div class="col-lg-3 col-md-4 col-sm-6">
                                <label class="form-label">
                                    Model <span class="text-danger">*</span>
                                </label>
                                <input asp-for="Model" class="form-control required-field" readonly="@(!isAdmin)" />
                                <span asp-validation-for="Model" class="text-danger"></span>
                            </div>

                            <div class="col-lg-3 col-md-4 col-sm-6">
                                <label class="form-label">
                                    SL No <span class="text-danger">*</span>
                                </label>
                                <input asp-for="Slno" class="form-control required-field" readonly="@(!isAdmin)" />
                                <span asp-validation-for="Slno" class="text-danger"></span>
                            </div>
                            <!-- Install Date -->
                            <div class="col-lg-3 col-md-4 col-sm-6">
                                <label asp-for="InstallDate" class="form-label">
                                    Installation Date <span class="text-danger">*</span>
                                </label>
                                <input asp-for="InstallDate" type="date" class="form-control required-field" readonly="@(!isAdmin)" />
                                <span asp-validation-for="InstallDate" class="text-danger"></span>
                            </div>
                            <!-- CurrentLocation -->
                            <div class="col-lg-3 col-md-4 col-sm-6">
                                <label asp-for="CurrentLocation" class="form-label">
                                    Current Location <span class="text-danger">*</span>
                                </label>

                                <select asp-for="CurrentLocation"
                                        asp-items="ViewBag.CompanyList"
                                        class="form-select"
                                        disabled="@(!isAdmin)">
                                    <option value="">-- Select Company --</option>
                                </select>

                                @if (!isAdmin)
                                {
                                    <input type="hidden" asp-for="CurrentLocation" />
                                }

                                <span asp-validation-for="CurrentLocation" class="text-danger"></span>
                            </div>
                            <!-- Status -->
                            <div class="col-lg-3 col-md-4 col-sm-6">
                                <label asp-for="Status" class="form-label">
                                    Status <span class="text-danger">*</span>
                                </label>

                                <select asp-for="Status" id="Status" class="form-select">
                                    <option value="">-- Select Status --</option>
                                    <option value="Active">Active</option>
                                    <option value="Inactive">Inactive</option>
                                </select>

                                <span asp-validation-for="Status" class="text-danger"></span>
                            </div>

                            <!-- Remarks -->
                            <div id="remarksDiv" class="col-lg-6 col-lg-3 col-md-4 col-sm-6 col-sm-6" style="display:none;">
                                <label asp-for="Remarks" class="form-label">
                                    Reason <span id="remarksRequired" class="text-danger">*</span>
                                </label>

                                <input asp-for="Remarks" id="Remarks" class="form-control" />

                                <span asp-validation-for="Remarks" class="text-danger"></span>
                                <span id="remarksError" class="text-danger"></span>
                            </div>

                        </div>

                        <div class="d-flex justify-content-between mt-4">

                            <a asp-action="EquipmentDetailsList"
                               class="btn btn-outline-secondary">
                                ← Back
                            </a>

                            <button type="submit"
                                    class="btn btn-success px-4">
                                Save Equipment
                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>
    </div>

</div>
<script>
    document.addEventListener("DOMContentLoaded", function () {

        const status = document.getElementById("Status");
        const remarksDiv = document.getElementById("remarksDiv");
        const remarks = document.getElementById("Remarks");
        const remarksError = document.getElementById("remarksError");

        if (!status) return;


        function toggleRemarks() {

            if (status.value === "Inactive") {

                remarksDiv.style.display = "block";

            } else {

                remarksDiv.style.display = "none";
                remarks.value = "";
                remarksError.textContent = "";

            }
        }


        // page load
        toggleRemarks();


        // status change
        status.addEventListener("change", function () {
            toggleRemarks();
        });



        // form submit validation
        const form = document.querySelector("form");

        form.addEventListener("submit", function (e) {

            if (status.value === "Inactive" &&
                remarks.value.trim() === "") {

                e.preventDefault();

                remarksDiv.style.display = "block";

                remarksError.textContent =
                    "Remarks is required when Status is Inactive.";

                remarks.focus();

                return false;
            }

        });



        // clear error while typing
        remarks.addEventListener("input", function () {

            if (remarks.value.trim() !== "") {
                remarksError.textContent = "";
            }

        });

    });
</script>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
