@{
    ViewData["Title"] = User.IsInRole("Admin") ? "Admin Dashboard"
                    : User.IsInRole("User") ? "User Dashboard"
                    : "Home Page";

    var userName = User.Identity?.Name ?? "Guest";

    var hour = DateTime.Now.Hour;

    var greeting = hour < 12
        ? "Good Morning"
        : hour < 18
            ? "Good Afternoon"
            : "Good Evening";
}

<style>

    /* =========================================================
           GLOBAL
        ========================================================== */

    *,
    *::before,
    *::after {
        box-sizing: border-box;
    }

    html,
    body {
        width: 100%;
        min-height: 100%;
        margin: 0;
        padding: 0;
    }

    body {
        background: #f2f4f8;
        overflow-x: hidden;
    }


    /* =========================================================
           HERO
        ========================================================== */

    .hero {
        width: 100%;
        /*
             * Navbar-এর জন্য space
             */
        margin-top: 70px;
        background: linear-gradient( 135deg, #6f42c1, #0dcaf0 );
        color: white;
        padding: 55px 20px;
        border-radius: 0 0 30px 30px;
        box-shadow: 0 6px 20px rgba(0, 0, 0, 0.1);
        text-align: center;
        overflow: hidden;
    }


        .hero h3 {
            font-size: 24px;
            line-height: 1.3;
            margin-bottom: 8px;
        }


        .hero h1 {
            font-size: 38px;
            line-height: 1.2;
            margin: 0;
            word-break: break-word;
        }


        .hero p {
            font-size: 16px;
            line-height: 1.5;
            margin-bottom: 0;
        }


    /* =========================================================
           DASHBOARD CONTAINER
        ========================================================== */

    .dashboard-container {
        width: 100%;
        max-width: 1400px;
        margin: 0 auto;
        padding: 45px 25px;
    }


    /* =========================================================
           SECTION TITLE
        ========================================================== */

    .section-title {
        font-weight: 600;
        margin-bottom: 18px;
        color: #495057;
        font-size: 22px;
    }


    /* =========================================================
           DASHBOARD CARD
        ========================================================== */

    .dash-card {
        border: none;
        border-radius: 18px;
        padding: 22px;
        color: white;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        min-height: 125px;
        height: 100%;
        display: flex;
        flex-direction: column;
        justify-content: center;
        overflow: hidden;
    }


        .dash-card:hover {
            transform: translateY(-7px);
            box-shadow: 0 15px 25px rgba(0, 0, 0, 0.15);
        }


        .dash-card .title {
            font-weight: 600;
            font-size: 19px;
            line-height: 1.3;
            margin-bottom: 7px;
        }


        .dash-card p {
            margin: 0;
            font-size: 14px;
            line-height: 1.4;
        }


    /* =========================================================
           GRADIENTS
        ========================================================== */

    .c1 {
        background: linear-gradient( 135deg, #4facfe, #00f2fe );
    }


    .c2 {
        background: linear-gradient( 135deg, #667eea, #764ba2 );
    }


    .c3 {
        background: linear-gradient( 135deg, #f093fb, #f5576c );
    }


    .c4 {
        background: linear-gradient( 135deg, #ff9a9e, #fad0c4 );
        color: #333;
    }


    .c5 {
        background: linear-gradient( 135deg, #f6d365, #fda085 );
        color: #333;
    }


    .c6 {
        background: linear-gradient( 135deg, #43e97b, #38f9d7 );
        color: #333;
    }


    /* =========================================================
           INFO BOX
        ========================================================== */

    .login-info {
        width: 100%;
        margin-top: 45px;
        padding: 24px;
        background: white;
        border-radius: 18px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.06);
        text-align: center;
    }


        .login-info h5 {
            font-size: 18px;
            margin-bottom: 8px;
        }


        .login-info p {
            margin: 0;
            font-size: 15px;
            word-break: break-word;
        }


    /* =========================================================
           LARGE SCREEN
           1600px+
        ========================================================== */

    @@media screen and (min-width: 1600px) {

        .hero {
            padding: 65px 30px;
        }


            .hero h3 {
                font-size: 27px;
            }


            .hero h1 {
                font-size: 44px;
            }


            .hero p {
                font-size: 18px;
            }


        .dashboard-container {
            max-width: 1500px;
            padding: 55px 35px;
        }


        .dash-card {
            min-height: 140px;
            padding: 28px;
        }


            .dash-card .title {
                font-size: 21px;
            }


            .dash-card p {
                font-size: 15px;
            }
    }


    /* =========================================================
           LAPTOP
           992px - 1199px
        ========================================================== */

    @@media screen and (min-width: 992px) and (max-width: 1199px) {

        .hero {
            margin-top: 65px;
            padding: 45px 20px;
        }


            .hero h1 {
                font-size: 34px;
            }


            .hero h3 {
                font-size: 22px;
            }


        .dashboard-container {
            padding: 35px 20px;
        }


        .dash-card {
            min-height: 115px;
            padding: 20px;
        }
    }


    /* =========================================================
           TABLET
           768px - 991px
        ========================================================== */

    @@media screen and (min-width: 768px) and (max-width: 991px) {

        .hero {
            margin-top: 65px;
            padding: 40px 18px;
            border-radius: 0 0 25px 25px;
        }


            .hero h3 {
                font-size: 21px;
            }


            .hero h1 {
                font-size: 31px;
            }


            .hero p {
                font-size: 15px;
            }


        .dashboard-container {
            padding: 32px 18px;
        }


        .section-title {
            font-size: 21px;
        }


        .dash-card {
            min-height: 110px;
            padding: 18px;
        }


            .dash-card .title {
                font-size: 17px;
            }


            .dash-card p {
                font-size: 13px;
            }


        .login-info {
            margin-top: 35px;
        }
    }


    /* =========================================================
           MOBILE
           767px and below
        ========================================================== */

    @@media screen and (max-width: 767px) {

        .hero {
            margin-top: 60px;
            padding: 35px 15px;
            border-radius: 0 0 20px 20px;
        }


            .hero h3 {
                font-size: 18px;
                margin-bottom: 6px;
            }


            .hero h1 {
                font-size: 27px;
                line-height: 1.25;
                padding: 0 5px;
            }


            .hero p {
                font-size: 13px;
                line-height: 1.45;
                margin-top: 10px !important;
            }


        .dashboard-container {
            width: 100%;
            padding: 25px 15px;
        }


        .section-title {
            font-size: 19px;
            margin-bottom: 14px;
        }
        /*
             * Bootstrap row-এর negative margin
             * mobile-এ avoid করার জন্য
             */
        .dashboard-container .row {
            --bs-gutter-x: 0.9rem;
            --bs-gutter-y: 0.9rem;
        }
        /*
             * Mobile-এ এক card per row
             */
        .dashboard-container .col-md-4 {
            width: 100%;
        }


        .dash-card {
            width: 100%;
            min-height: 105px;
            padding: 18px;
            border-radius: 15px;
        }


            .dash-card:hover {
                /*
                 * Mobile touch device-এ excessive movement avoid
                 */
                transform: none;
            }


            .dash-card .title {
                font-size: 17px;
            }


            .dash-card p {
                font-size: 13px;
            }


        .login-info {
            margin-top: 30px;
            padding: 20px 15px;
            border-radius: 15px;
        }


            .login-info h5 {
                font-size: 17px;
            }


            .login-info p {
                font-size: 13px;
                line-height: 1.5;
            }
    }


    /* =========================================================
           SMALL MOBILE
           400px and below
        ========================================================== */

    @@media screen and (max-width: 400px) {

        .hero {
            margin-top: 58px;
            padding: 28px 12px;
            border-radius: 0 0 18px 18px;
        }


            .hero h3 {
                font-size: 16px;
            }


            .hero h1 {
                font-size: 23px;
            }


            .hero p {
                font-size: 12px;
            }


        .dashboard-container {
            padding: 22px 12px;
        }


        .section-title {
            font-size: 18px;
        }


        .dash-card {
            min-height: 95px;
            padding: 16px;
            border-radius: 14px;
        }


            .dash-card .title {
                font-size: 16px;
            }


            .dash-card p {
                font-size: 12px;
            }


        .login-info {
            margin-top: 25px;
            padding: 17px 12px;
        }
    }


    /* =========================================================
           MOBILE LANDSCAPE

           Example:
           812 x 375
           896 x 414
        ========================================================== */

    @@media screen and (max-width: 767px) and (orientation: landscape) {

        .hero {
            margin-top: 55px;
            padding: 20px 15px;
            border-radius: 0 0 18px 18px;
        }


            .hero h3 {
                font-size: 15px;
                margin-bottom: 3px;
            }


            .hero h1 {
                font-size: 22px;
                line-height: 1.15;
            }


            .hero p {
                font-size: 11px;
                margin-top: 5px !important;
            }


        .dashboard-container {
            padding: 20px 15px;
        }


        .section-title {
            font-size: 17px;
            margin-bottom: 12px;
        }
        /*
             * Landscape mobile:
             * 2 cards per row
             */
        .dashboard-container .col-md-4 {
            width: 50%;
        }


        .dash-card {
            min-height: 90px;
            padding: 15px;
            border-radius: 13px;
        }


            .dash-card .title {
                font-size: 15px;
            }


            .dash-card p {
                font-size: 11px;
            }


        .login-info {
            margin-top: 25px;
            padding: 16px;
        }


            .login-info h5 {
                font-size: 16px;
            }


            .login-info p {
                font-size: 12px;
            }


        .dash-card:hover {
            transform: none;
        }
    }


    /* =========================================================
           VERY SHORT LANDSCAPE

           Example:
           667 x 320
           740 x 320
        ========================================================== */

    @@media screen and (max-width: 767px) and (orientation: landscape) and (max-height: 380px) {

        .hero {
            margin-top: 50px;
            padding: 14px 12px;
        }


            .hero h3 {
                font-size: 13px;
            }


            .hero h1 {
                font-size: 19px;
            }


            .hero p {
                font-size: 9px;
                margin-top: 3px !important;
            }


        .dashboard-container {
            padding: 16px 12px;
        }


        .section-title {
            font-size: 15px;
            margin-bottom: 9px;
        }


        .dashboard-container .row {
            --bs-gutter-x: 0.6rem;
            --bs-gutter-y: 0.6rem;
        }


        .dash-card {
            min-height: 75px;
            padding: 11px;
            border-radius: 11px;
        }


            .dash-card .title {
                font-size: 13px;
                margin-bottom: 4px;
            }


            .dash-card p {
                font-size: 9px;
            }


        .login-info {
            margin-top: 18px;
            padding: 12px;
        }


            .login-info h5 {
                font-size: 14px;
            }


            .login-info p {
                font-size: 10px;
            }
    }

</style>


<!-- =========================================================
     HERO
========================================================== -->

<div class="hero text-center">

    <h3 class="fw-light">
        @greeting
    </h3>


    <h1 class="fw-bold">
        Mr. @userName
    </h1>


    <p class="mt-2">

        @if (User.IsInRole("Admin") || User.IsInRole("User"))
        {
            <text>
                Welcome to
                <strong>Utility Management System</strong>
            </text>
        }
        else if (User.IsInRole("SpecialAccess"))
        {
            <text>
                Welcome to
                <strong>Carton Sticker Solution</strong>
            </text>
        }
        else
        {
            <text>
                Welcome Guest
            </text>
        }

    </p>

</div>


<!-- =========================================================
     DASHBOARD
========================================================== -->

<div class="dashboard-container">


    <h4 class="section-title">
        Quick Access
    </h4>


    <div class="row g-4">


        <!-- DASHBOARD -->

        <div class="col-md-4">

            <a href="@Url.Action("Index", "Home")"
               class="text-decoration-none">

                <div class="dash-card c1">

                    <h5 class="title">
                        Dashboard
                    </h5>

                    <p>
                        System overview
                    </p>

                </div>

            </a>

        </div>


        <!-- MACHINE COST -->

        <div class="col-md-4">

            <a href="@Url.Action("Index", "Home")"
               class="text-decoration-none">

                <div class="dash-card c2">

                    <h5 class="title">
                        Machine Cost
                    </h5>

                    <p>
                        Manage cost data
                    </p>

                </div>

            </a>

        </div>


        <!-- EMPLOYEES -->

        <div class="col-md-4">

            <a href="@Url.Action("Index", "Home")"
               class="text-decoration-none">

                <div class="dash-card c3">

                    <h5 class="title">
                        Employees
                    </h5>

                    <p>
                        Employee management
                    </p>

                </div>

            </a>

        </div>


        <!-- COST TYPE -->

        <div class="col-md-4">

            <a href="@Url.Action("Index", "Home")"
               class="text-decoration-none">

                <div class="dash-card c4">

                    <h5 class="title">
                        Cost Type
                    </h5>

                    <p>
                        Category setup
                    </p>

                </div>

            </a>

        </div>


        <!-- REPORTS -->

        <div class="col-md-4">

            <a href="#"
               class="text-decoration-none">

                <div class="dash-card c5">

                    <h5 class="title">
                        Reports
                    </h5>

                    <p>
                        Analytics view
                    </p>

                </div>

            </a>

        </div>


        <!-- SETTINGS -->

        <div class="col-md-4">

            <a href="#"
               class="text-decoration-none">

                <div class="dash-card c6">

                    <h5 class="title">
                        Settings
                    </h5>

                    <p>
                        System configuration
                    </p>

                </div>

            </a>

        </div>

    </div>


    <!-- =====================================================
         INFO BOX
    ====================================================== -->

    <div class="login-info">


        <h5 class="mb-2 text-secondary">
            Login Info
        </h5>


        @if (User.Identity?.Name != null)
        {
            <p>

                Logged in as
                <strong>
                    Mr. @userName
                </strong>

            </p>
        }
        else
        {
            <p class="text-danger">

                Please login to continue

            </p>
        }

    </div>

</div>
