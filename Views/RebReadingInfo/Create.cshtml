@model UtilityManagement.Models.TblRebReadingInfo

@{
    ViewData["Title"] = "Create REB Reading";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/create-responsive.css"
          asp-append-version="true" />
}

<div class="create-page">

    <div class="row justify-content-center">
        <div class="col-md-10 create-wrapper">
            <div class="card shadow-lg border-0 create-card">
                <div class="card-header bg-primary text-white">
                    <h5>Add REB Reading</h5>
                </div>
                <div class="card-body p-4 create-body">
                <form asp-action="Create"method="post" class="create-form">
                    <!-- VALIDATION -->
                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3">
                    </div>

                    <div class="row g-3">


                        <!-- =================================================
                             DATE
                        ================================================== -->

                        <div class="col-lg-3 col-md-6 col-sm-12">

                            <label asp-for="Trdate"
                                   class="form-label">

                                Date
                                <span class="text-danger">*</span>

                            </label>


                            <input asp-for="Trdate"
                                   type="date"
                                   class="form-control" />


                            <span asp-validation-for="Trdate"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- =================================================
                             EQUIPMENT
                        ================================================== -->

                        <div class="col-lg-3 col-md-6 col-sm-12">

                            <label asp-for="Eqid"
                                   class="form-label">

                                Equipment
                                <span class="text-danger">*</span>

                            </label>


                            <select asp-for="Eqid"
                                    asp-items="ViewBag.EquipmentList"
                                    class="form-select">

                                <option value="">
                                    -- Select Equipment --
                                </option>

                            </select>


                            <span asp-validation-for="Eqid"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- =================================================
                             ELECTRICITY GENERATION
                        ================================================== -->

                        <div class="col-lg-3 col-md-6 col-sm-12">

                            <label asp-for="ElecGen"
                                   class="form-label">

                                Electricity Generation(Kwh)
                                <span class="text-danger">*</span>

                            </label>


                            <input asp-for="ElecGen"
                                   class="form-control" />


                            <span asp-validation-for="ElecGen"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- =================================================
                             RUNNING HR
                        ================================================== -->

                        <div class="col-lg-3 col-md-6 col-sm-12">

                            <label asp-for="RunHr"
                                   class="form-label">

                                Running Hr
                                <span class="text-danger">*</span>

                            </label>


                            <input asp-for="RunHr"
                                   class="form-control" />


                            <span asp-validation-for="RunHr"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- =================================================
                             BDT/KWH
                        ================================================== -->

                        <div class="col-lg-3 col-md-6 col-sm-12">

                            <label asp-for="BdtKwh"
                                   class="form-label">

                                BDT(tk/kwh)
                                <span class="text-danger">*</span>

                            </label>


                            <input asp-for="BdtKwh"
                                   class="form-control" />


                            <span asp-validation-for="BdtKwh"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- =================================================
                             OTHER CONSUMABLE
                        ================================================== -->

                        <div class="col-lg-3 col-md-6 col-sm-12">

                            <label asp-for="OtConsumable"
                                   class="form-label">

                                Others Consumable(TK)
                                <span class="text-danger">*</span>

                            </label>


                            <input asp-for="OtConsumable"
                                   class="form-control" />


                            <span asp-validation-for="OtConsumable"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- =================================================
                             TROUBLESHOOTING
                        ================================================== -->

                        <div class="col-lg-3 col-md-6 col-sm-12">

                            <label asp-for="Troubleshoot"
                                   class="form-label">

                                Troubleshooting(Tk)
                                <span class="text-danger">*</span>

                            </label>


                            <input asp-for="Troubleshoot"
                                   class="form-control" />


                            <span asp-validation-for="Troubleshoot"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- =================================================
                             SERVICE CHARGE
                        ================================================== -->

                        <div class="col-lg-3 col-md-6 col-sm-12">

                            <label asp-for="ServiceCharge"
                                   class="form-label">

                                Service Charge
                                <span class="text-danger">*</span>

                            </label>


                            <input asp-for="ServiceCharge"
                                   class="form-control" />


                            <span asp-validation-for="ServiceCharge"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- =================================================
                             REPAIR CHARGE
                        ================================================== -->

                        <div class="col-lg-3 col-md-6 col-sm-12">

                            <label asp-for="RepairCharge"
                                   class="form-label">

                                Repair Charge
                                <span class="text-danger">*</span>

                            </label>


                            <input asp-for="RepairCharge"
                                   class="form-control" />


                            <span asp-validation-for="RepairCharge"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- =================================================
                             TOTAL
                        ================================================== -->

                        <div class="col-lg-3 col-md-6 col-sm-12">

                            <label asp-for="Total"
                                   class="form-label">

                                Total
                                <span class="text-danger">*</span>

                            </label>


                            <input asp-for="Total"
                                   class="form-control"
                                   readonly />


                            <span asp-validation-for="Total"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- =================================================
                             TK/KWH
                        ================================================== -->

                        <div class="col-lg-3 col-md-6 col-sm-12">

                            <label asp-for="TkKwh"
                                   class="form-label">

                                Tk/Kwh
                                <span class="text-danger">*</span>

                            </label>


                            <input asp-for="TkKwh"
                                   class="form-control" />


                            <span asp-validation-for="TkKwh"
                                  class="text-danger">
                            </span>

                        </div>

                    </div>


                    <!-- =================================================
                         BUTTONS
                    ================================================== -->

@*                         <div class="d-flex justify-content-between align-items-center w-100 pt-4">

                            <a asp-action="RebReadingInfoList"
                               class="btn btn-secondary daily-back-btn">
                                <i class="bi bi-arrow-left me-1"></i>
                                Back
                            </a>

                            <button type="submit"
                                    class="btn btn-primary px-4 daily-save-btn">
                                <i class="bi bi-save me-1"></i>
                                Save
                            </button>

                        </div> *@

                        <div class="create-form-buttons">

                            <a asp-action="RebReadingInfoList"
                               class="btn btn-secondary">
                                <i class="bi bi-arrow-left"></i>&nbsp; Back
                            </a>

                            <button type="submit"
                                    class="btn btn-success px-4">
                                <i class="bi bi-save me-1"></i>&nbsp; Save
                            </button>

                        </div>

                </form>

            </div>

        </div>

    </div>

</div>


<!-- =========================================================
     CALCULATION SCRIPT
========================================================== -->

<script>

    document.addEventListener("DOMContentLoaded", function () {

        const elecGen =
            document.getElementById("ElecGen");

        const bdtKwh =
            document.getElementById("BdtKwh");

        const otConsumable =
            document.getElementById("OtConsumable");

        const troubleshoot =
            document.getElementById("Troubleshoot");

        const serviceCharge =
            document.getElementById("ServiceCharge");

        const repairCharge =
            document.getElementById("RepairCharge");

        const total =
            document.getElementById("Total");

        const tkKwh =
            document.getElementById("TkKwh");


        function calculateValues() {

            let totalValue =
                (parseFloat(bdtKwh?.value) || 0) +
                (parseFloat(otConsumable?.value) || 0) +
                (parseFloat(troubleshoot?.value) || 0) +
                (parseFloat(serviceCharge?.value) || 0) +
                (parseFloat(repairCharge?.value) || 0);


            // TOTAL
            if (total) {
                total.value = totalValue.toFixed(2);
            }


            // GENERATION
            let generation =
                parseFloat(elecGen?.value) || 0;


            // TK/KWH
            if (tkKwh) {

                tkKwh.value =
                    generation > 0
                        ? (totalValue / generation).toFixed(2)
                        : "0.00";

            }

        }


        // ==========================================
        // CHANGE EVENT ONLY
        // ==========================================

        [
            elecGen,
            bdtKwh,
            otConsumable,
            troubleshoot,
            serviceCharge,
            repairCharge
        ]
        .filter(x => x !== null)
        .forEach(function (input) {

            input.addEventListener(
                "change",
                calculateValues
            );

        });


        // ❌ NO INITIAL CALCULATION
        // calculateValues();

    });

</script>



@section Scripts {

    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial"
        );
    }

}
