<!-- =========================================================
     CALCULATION SCRIPT
========================================================== -->

<script>

    document.addEventListener("DOMContentLoaded", function () {

        const elecGen =
            document.getElementById("ElecGen");

        const bdtKwh =
            document.getElementById("BdtKwh");

        const otConsumable =
            document.getElementById("OtConsumable");

        const troubleshoot =
            document.getElementById("Troubleshoot");

        const serviceCharge =
            document.getElementById("ServiceCharge");

        const repairCharge =
            document.getElementById("RepairCharge");


        const total =
            document.getElementById("Total");

        const tkKwh =
            document.getElementById("TkKwh");


        function calculateValues() {

            let totalValue =
                (parseFloat(bdtKwh?.value) || 0) +
                (parseFloat(otConsumable?.value) || 0) +
                (parseFloat(troubleshoot?.value) || 0) +
                (parseFloat(serviceCharge?.value) || 0) +
                (parseFloat(repairCharge?.value) || 0);


            if (total) {

                total.value =
                    totalValue.toFixed(2);
            }


            let generation =
                parseFloat(elecGen?.value) || 0;


            if (tkKwh) {

                tkKwh.value =
                    generation > 0
                        ? (totalValue / generation).toFixed(2)
                        : "0.00";
            }

        }


        [
            elecGen,
            bdtKwh,
            otConsumable,
            troubleshoot,
            serviceCharge,
            repairCharge
        ]
        .filter(x => x !== null)
        .forEach(function (input) {

            input.addEventListener(
                "input",
                calculateValues
            );

        });


        calculateValues();

    });

</script>


@section Scripts {

    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial"
        );
    }

}
