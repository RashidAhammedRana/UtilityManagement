@model UtilityManagement.Models.TblRebReadingInfo

@{
    ViewData["Title"] = "Delete Reading";
}

<style>

    /* =========================================================
           GLOBAL
        ========================================================== */

    *,
    *::before,
    *::after {
        box-sizing: border-box;
    }

    html,
    body {
        width: 100%;
        max-width: 100%;
        margin: 0;
        padding: 0;
        overflow-x: hidden;
    }


    /* =========================================================
           MAIN PAGE
        ========================================================== */

    .reb-delete-page {
        width: 100%;
        max-width: 100%;
        padding: 25px 20px 40px 20px;
        margin: 0;
    }

    .reb-delete-wrapper {
        width: 100%;
        max-width: 1000px;
        margin: 0 auto;
        padding: 0;
    }


    /* =========================================================
           CARD
        ========================================================== */

    .reb-delete-card {
        width: 100%;
        max-width: 700px;
        margin: 0 auto;
        padding: 0;
        border: none;
        border-radius: 14px;
        overflow: hidden;
    }


        /* =========================================================
           HEADER
        ========================================================== */

        .reb-delete-card .card-header {
            padding: 16px 20px;
            margin: 0;
        }

            .reb-delete-card .card-header h5 {
                margin: 0;
                padding: 0;
                font-size: 20px;
                font-weight: 600;
                line-height: 1.3;
            }


        /* =========================================================
           BODY
        ========================================================== */

        .reb-delete-card .card-body {
            padding: 30px !important;
            margin: 0 !important;
        }


    /* =========================================================
           WARNING
        ========================================================== */

    .reb-delete-warning {
        width: 100%;
        text-align: center;
        padding: 15px 10px;
        margin: 0;
    }

        .reb-delete-warning .warning-icon {
            display: inline-block;
            font-size: 3rem;
            line-height: 1;
            margin: 0;
            padding: 0;
        }

        .reb-delete-warning h5 {
            margin: 18px 0 0 0;
            padding: 0;
            font-size: 18px;
            line-height: 1.4;
            font-weight: 600;
        }


    /* =========================================================
           FORM
        ========================================================== */

    .reb-delete-card form {
        width: 100%;
        margin: 0;
        padding: 0;
    }


    /* =========================================================
           BUTTON AREA
        ========================================================== */

    .reb-delete-actions {
        width: 100%;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
        margin: 25px 0 0 0;
        padding: 0;
    }

        .reb-delete-actions .btn {
            min-height: 42px;
            border-radius: 6px;
            font-size: 14px;
            font-weight: 500;
            padding: 8px 20px;
            margin: 0;
        }

    .reb-delete-no-btn,
    .reb-delete-yes-btn {
        min-width: 100px;
    }


    /* =========================================================
           LARGE DESKTOP
        ========================================================== */

    @@media screen and (min-width: 1600px) {

        .reb-delete-page {
            padding: 35px 30px 50px 30px;
        }

        .reb-delete-wrapper {
            max-width: 1050px;
        }

        .reb-delete-card {
            max-width: 720px;
        }

            .reb-delete-card .card-header {
                padding: 18px 25px;
            }

                .reb-delete-card .card-header h5 {
                    font-size: 21px;
                }

            .reb-delete-card .card-body {
                padding: 35px !important;
            }

        .reb-delete-warning .warning-icon {
            font-size: 3.2rem;
        }

        .reb-delete-warning h5 {
            font-size: 19px;
        }
    }


    /* =========================================================
           LAPTOP
        ========================================================== */

    @@media screen and (min-width: 1200px) and (max-width: 1599px) {

        .reb-delete-page {
            padding: 25px 25px 40px 25px;
        }

        .reb-delete-wrapper {
            max-width: 1000px;
        }

        .reb-delete-card {
            max-width: 700px;
        }

            .reb-delete-card .card-body {
                padding: 28px !important;
            }
    }


    /* =========================================================
           SMALL LAPTOP / TABLET
        ========================================================== */

    @@media screen and (min-width: 992px) and (max-width: 1199px) {

        .reb-delete-page {
            padding: 20px 18px 35px 18px;
        }

        .reb-delete-wrapper {
            max-width: 900px;
        }

        .reb-delete-card {
            max-width: 650px;
        }

            .reb-delete-card .card-header {
                padding: 15px 18px;
            }

                .reb-delete-card .card-header h5 {
                    font-size: 18px;
                }

            .reb-delete-card .card-body {
                padding: 25px !important;
            }

        .reb-delete-warning {
            padding: 12px 8px;
        }

            .reb-delete-warning .warning-icon {
                font-size: 2.8rem;
            }

            .reb-delete-warning h5 {
                margin-top: 15px;
                font-size: 17px;
            }

        .reb-delete-actions {
            margin-top: 22px;
        }
    }


    /* =========================================================
           TABLET
        ========================================================== */

    @@media screen and (min-width: 768px) and (max-width: 991px) {

        .reb-delete-page {
            padding: 18px 15px 30px 15px;
        }

        .reb-delete-wrapper {
            max-width: 750px;
        }

        .reb-delete-card {
            max-width: 600px;
            border-radius: 12px;
        }

            .reb-delete-card .card-header {
                padding: 14px 18px;
            }

                .reb-delete-card .card-header h5 {
                    font-size: 18px;
                }

            .reb-delete-card .card-body {
                padding: 22px !important;
            }

        .reb-delete-warning {
            padding: 12px 8px;
        }

            .reb-delete-warning .warning-icon {
                font-size: 2.8rem;
            }

            .reb-delete-warning h5 {
                margin-top: 15px;
                font-size: 16px;
            }

        .reb-delete-actions {
            margin-top: 22px;
        }
    }


    /* =========================================================
           MOBILE PORTRAIT
        ========================================================== */

    @@media screen and (max-width: 767px) {

        .reb-delete-page {
            width: 100%;
            padding: 10px 8px 20px 8px;
            margin: 0;
        }

        .reb-delete-wrapper {
            width: 100%;
            margin: 0 auto;
            padding: 0;
        }

        .reb-delete-card {
            width: 100%;
            max-width: 100%;
            border-radius: 10px;
            margin: 0 auto;
        }
            /* HEADER */

            .reb-delete-card .card-header {
                padding: 10px 13px;
            }

                .reb-delete-card .card-header h5 {
                    font-size: 16px;
                    line-height: 1.2;
                }
            /* BODY */

            .reb-delete-card .card-body {
                padding: 15px 12px !important;
            }
        /* WARNING */

        .reb-delete-warning {
            padding: 7px 4px;
        }

            .reb-delete-warning .warning-icon {
                font-size: 2.2rem;
            }

            .reb-delete-warning h5 {
                margin-top: 10px;
                font-size: 14px;
                line-height: 1.3;
            }
        /* BUTTONS */

        .reb-delete-actions {
            flex-direction: column;
            align-items: stretch;
            gap: 8px;
            margin-top: 16px;
        }

            .reb-delete-actions .btn {
                width: 100%;
                min-width: 0;
                min-height: 40px;
                font-size: 12px;
                padding: 7px 10px;
            }
    }


    /* =========================================================
           MOBILE LANDSCAPE
           VERY COMPACT
        ========================================================== */

    @@media screen and (max-width: 767px) and (orientation: landscape) {
        /*
               IMPORTANT:
               Remove page top space
            */

        html,
        body {
            margin: 0 !important;
            padding: 0 !important;
            overflow-x: hidden !important;
            overflow-y: hidden !important;
        }
        /* =====================================================
               PAGE
               TOP = ZERO
            ====================================================== */

        .reb-delete-page {
            width: 100%;
            max-width: 100%;
            margin: 0 !important;
            padding: 0 !important;
            min-height: 0 !important;
            height: auto !important;
        }
        /* =====================================================
               WRAPPER
               TOP = ZERO
            ====================================================== */

        .reb-delete-wrapper {
            width: 100%;
            max-width: 100%;
            margin: 0 !important;
            padding: 0 !important;
            min-height: 0 !important;
        }
        /* =====================================================
               CARD
            ====================================================== */

        .reb-delete-card {
            width: 100%;
            max-width: 520px;
            margin: 0 auto !important;
            padding: 0 !important;
            border-radius: 5px;
            min-height: 0 !important;
            height: auto !important;
        }
            /* =====================================================
               HEADER
            ====================================================== */

            .reb-delete-card .card-header {
                margin: 0 !important;
                padding: 2px 8px !important;
                min-height: 0 !important;
                height: auto !important;
            }

                .reb-delete-card .card-header h5 {
                    margin: 0 !important;
                    padding: 0 !important;
                    font-size: 10px;
                    line-height: 1;
                }
            /* =====================================================
               BODY
            ====================================================== */

            .reb-delete-card .card-body {
                margin: 0 !important;
                padding: 2px 8px 3px 8px !important;
                min-height: 0 !important;
                height: auto !important;
            }
        /* =====================================================
               WARNING
            ====================================================== */

        .reb-delete-warning {
            width: 100%;
            margin: 0 !important;
            padding: 0 !important;
            text-align: center;
            line-height: 1;
        }

            .reb-delete-warning .warning-icon {
                display: block;
                width: fit-content;
                margin: 0 auto !important;
                padding: 0 !important;
                font-size: 1rem;
                line-height: 1;
            }

            .reb-delete-warning h5 {
                margin: 1px 0 0 0 !important;
                padding: 0 !important;
                font-size: 8px;
                line-height: 1;
                font-weight: 600;
            }
        /* =====================================================
               FORM
               NO TOP SPACE
            ====================================================== */

        .reb-delete-card form {
            width: 100%;
            margin: 0 !important;
            padding: 0 !important;
        }
        /* =====================================================
               BUTTON AREA
               DIRECTLY UNDER FORM
            ====================================================== */

        .reb-delete-actions {
            width: 100%;
            display: flex;
            flex-direction: row;
            justify-content: space-between;
            align-items: center;
            gap: 3px;
            margin: 0 !important;
            padding: 0 !important;
            line-height: 1;
        }
            /* =====================================================
               BUTTONS
            ====================================================== */

            .reb-delete-actions .btn {
                width: 62px;
                min-width: 62px;
                height: 20px;
                min-height: 20px;
                margin: 0 !important;
                padding: 1px 5px !important;
                font-size: 7px;
                line-height: 1;
                border-radius: 3px;
            }

        .reb-delete-no-btn,
        .reb-delete-yes-btn {
            width: 62px;
            min-width: 62px;
            height: 20px;
            min-height: 20px;
            margin: 0 !important;
        }
    }


    /* =========================================================
           SHORT LANDSCAPE
           max-height: 380px
        ========================================================== */

    @@media screen and (max-width: 767px) and (orientation: landscape) and (max-height: 380px) {
        /*
               Remove ALL top spacing
            */

        html,
        body {
            margin: 0 !important;
            padding: 0 !important;
        }

        .reb-delete-page {
            padding: 0 !important;
            margin: 0 !important;
        }

        .reb-delete-wrapper {
            margin: 0 !important;
            padding: 0 !important;
        }
        /* CARD */

        .reb-delete-card {
            max-width: 460px;
            margin: 0 auto !important;
            padding: 0 !important;
            border-radius: 4px;
        }
            /* HEADER */

            .reb-delete-card .card-header {
                padding: 1px 6px !important;
                margin: 0 !important;
            }

                .reb-delete-card .card-header h5 {
                    font-size: 9px;
                    line-height: 1;
                }
            /* BODY */

            .reb-delete-card .card-body {
                padding: 1px 6px 1px 6px !important;
                margin: 0 !important;
            }
        /* WARNING */

        .reb-delete-warning {
            padding: 0 !important;
            margin: 0 !important;
        }

            .reb-delete-warning .warning-icon {
                font-size: 0.85rem;
            }

            .reb-delete-warning h5 {
                margin: 0 !important;
                font-size: 6.5px;
                line-height: 1;
            }
        /* FORM */

        .reb-delete-card form {
            margin: 0 !important;
            padding: 0 !important;
        }
        /* BUTTONS */

        .reb-delete-actions {
            margin: 0 !important;
            padding: 0 !important;
            gap: 2px;
        }

            .reb-delete-actions .btn {
                width: 52px;
                min-width: 52px;
                height: 18px;
                min-height: 18px;
                padding: 1px 4px !important;
                font-size: 6px;
                line-height: 1;
                border-radius: 2px;
            }

        .reb-delete-no-btn,
        .reb-delete-yes-btn {
            width: 52px;
            min-width: 52px;
            height: 18px;
            min-height: 18px;
        }
    }


    /* =========================================================
           EXTRA SHORT LANDSCAPE
           max-height: 320px
        ========================================================== */

    @@media screen and (max-width: 767px) and (orientation: landscape) and (max-height: 320px) {

        html,
        body {
            margin: 0 !important;
            padding: 0 !important;
        }

        .reb-delete-page {
            margin: 0 !important;
            padding: 0 !important;
        }

        .reb-delete-wrapper {
            margin: 0 !important;
            padding: 0 !important;
        }
        /* CARD */

        .reb-delete-card {
            max-width: 440px;
            margin: 0 auto !important;
            border-radius: 3px;
        }
            /* HEADER */

            .reb-delete-card .card-header {
                padding: 0 5px !important;
                margin: 0 !important;
            }

                .reb-delete-card .card-header h5 {
                    font-size: 8px;
                    line-height: 1;
                }
            /* BODY */

            .reb-delete-card .card-body {
                padding: 0 5px 1px 5px !important;
                margin: 0 !important;
            }
        /* WARNING */

        .reb-delete-warning {
            padding: 0 !important;
            margin: 0 !important;
        }

            .reb-delete-warning .warning-icon {
                font-size: 0.75rem;
            }

            .reb-delete-warning h5 {
                margin: 0 !important;
                padding: 0 !important;
                font-size: 5.5px;
                line-height: 1;
            }
        /* FORM */

        .reb-delete-card form {
            margin: 0 !important;
            padding: 0 !important;
        }
        /* ACTION */

        .reb-delete-actions {
            margin: 0 !important;
            padding: 0 !important;
            gap: 2px;
        }
            /* BUTTON */

            .reb-delete-actions .btn {
                width: 48px;
                min-width: 48px;
                height: 16px;
                min-height: 16px;
                margin: 0 !important;
                padding: 1px 3px !important;
                font-size: 5.5px;
                line-height: 1;
                border-radius: 2px;
            }

        .reb-delete-no-btn,
        .reb-delete-yes-btn {
            width: 48px;
            min-width: 48px;
            height: 16px;
            min-height: 16px;
        }
    }


    /* =========================================================
           TOUCH DEVICE
        ========================================================== */

    @@media screen and (pointer: coarse) and (hover: none) {

        .reb-delete-actions .btn {
            touch-action: manipulation;
        }
    }


    /* =========================================================
           SAFE AREA
        ========================================================== */

    @@media screen and (max-width: 768px) {

        .reb-delete-page {
            padding-top: max(0px, env(safe-area-inset-top)) !important;
        }
    }


    /* =========================================================
           FINAL OVERFLOW PROTECTION
        ========================================================== */

    .reb-delete-page,
    .reb-delete-wrapper,
    .reb-delete-card,
    .reb-delete-card .card-body,
    .reb-delete-card form {
        max-width: 100%;
        box-sizing: border-box;
    }

</style>


<!-- =========================================================
     DELETE PAGE
========================================================== -->

<div class="reb-delete-page">

    <div class="reb-delete-wrapper">

        <div class="card shadow border-danger reb-delete-card">

            <!-- HEADER -->

            <div class="card-header bg-danger text-white">

                <h5>
                    Delete Confirmation
                </h5>

            </div>


            <!-- BODY -->

            <div class="card-body">

                <!-- WARNING -->

                <div class="reb-delete-warning">

                    <i class="bi bi-exclamation-triangle-fill
                              text-danger
                              warning-icon">
                    </i>

                    <h5 class="text-danger">
                        Are you sure you want to delete this record?
                    </h5>

                </div>


                <!-- FORM -->

                <form asp-action="Delete"
                      method="post">

                    <input type="hidden"
                           asp-for="Trid" />


                    <!-- ACTION BUTTONS -->

                    <div class="reb-delete-actions">

                        <a asp-action="RebReadingInfoList"
                           class="btn btn-secondary reb-delete-no-btn">
                            No
                        </a>

                        <button type="submit"
                                class="btn btn-danger reb-delete-yes-btn">
                            Yes
                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>
