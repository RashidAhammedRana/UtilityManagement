@model UtilityManagement.Models.TblRebReadingInfo

@{
    ViewData["Title"] = "Delete Reading";
}

<style>

    /* =========================================================
           GLOBAL
        ========================================================== */

    *,
    *::before,
    *::after {
        box-sizing: border-box;
    }

    .reb-delete-page,
    .reb-delete-wrapper,
    .reb-delete-card {
        box-sizing: border-box;
    }


    /* =========================================================
           DELETE PAGE
        ========================================================== */

    .reb-delete-page {
        width: 100%;
        max-width: 100%;
        margin: 0;
        padding: 20px 15px 30px 15px;
    }

    .reb-delete-wrapper {
        width: 100%;
        max-width: 900px;
        margin: 0 auto;
        padding: 0;
    }


    /* =========================================================
           CARD
        ========================================================== */

    .reb-delete-card {
        width: 100%;
        max-width: 650px;
        margin: 0 auto;
        padding: 0;
        border: none;
        border-radius: 10px;
        overflow: hidden;
    }


        /* =========================================================
           HEADER
        ========================================================== */

        .reb-delete-card .card-header {
            margin: 0;
            padding: 12px 16px;
        }

            .reb-delete-card .card-header h5 {
                margin: 0;
                padding: 0;
                font-size: 18px;
                font-weight: 600;
                line-height: 1.2;
            }


        /* =========================================================
           BODY
        ========================================================== */

        .reb-delete-card .card-body {
            margin: 0 !important;
            padding: 20px !important;
        }


    /* =========================================================
           WARNING
        ========================================================== */

    .reb-delete-warning {
        width: 100%;
        margin: 0;
        padding: 6px 5px;
        text-align: center;
    }

        .reb-delete-warning .warning-icon {
            display: block;
            width: fit-content;
            margin: 0 auto;
            padding: 0;
            font-size: 2.5rem;
            line-height: 1;
        }

        .reb-delete-warning h5 {
            margin: 9px 0 0 0;
            padding: 0;
            font-size: 16px;
            font-weight: 600;
            line-height: 1.25;
        }


    /* =========================================================
           FORM
        ========================================================== */

    .reb-delete-card form {
        width: 100%;
        margin: 0 !important;
        padding: 0 !important;
    }


    /* =========================================================
           BUTTON AREA
        ========================================================== */

    .reb-delete-actions {
        width: 100%;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 10px;
        margin: 14px 0 0 0;
        padding: 0;
    }


        /* =========================================================
           BUTTONS
        ========================================================== */

        .reb-delete-actions .btn {
            display: inline-flex;
            justify-content: center;
            align-items: center;
            text-align: center;
            min-width: 90px;
            min-height: 38px;
            margin: 0;
            padding: 6px 15px;
            border-radius: 5px;
            font-size: 13px;
            font-weight: 500;
            line-height: 1;
        }

    .reb-delete-no-btn,
    .reb-delete-yes-btn {
        min-width: 90px;
    }


    /* =========================================================
           MOBILE PORTRAIT
        ========================================================== */

    @@media screen and (max-width: 767px) {

        .reb-delete-page {
            width: 100%;
            max-width: 100%;
            margin: 0;
            padding: 8px 7px 15px 7px;
        }

        .reb-delete-wrapper {
            width: 100%;
            max-width: 100%;
            margin: 0;
            padding: 0;
        }

        .reb-delete-card {
            width: 100%;
            max-width: 100%;
            margin: 0;
            border-radius: 8px;
        }

            .reb-delete-card .card-header {
                padding: 8px 11px;
            }

                .reb-delete-card .card-header h5 {
                    font-size: 14px;
                }

            .reb-delete-card .card-body {
                padding: 11px 9px !important;
            }

        .reb-delete-warning {
            padding: 4px 2px;
        }

            .reb-delete-warning .warning-icon {
                font-size: 1.9rem;
            }

            .reb-delete-warning h5 {
                margin-top: 6px;
                font-size: 12px;
            }

        .reb-delete-actions {
            flex-direction: column;
            align-items: stretch;
            gap: 6px;
            margin-top: 10px;
        }

            .reb-delete-actions .btn {
                width: 100%;
                min-width: 0;
                min-height: 35px;
                padding: 6px 8px;
                font-size: 11px;
            }
    }


    /* =========================================================
           SMALL MOBILE
        ========================================================== */

    @@media screen and (max-width: 400px) {

        .reb-delete-page {
            padding: 5px;
        }

        .reb-delete-card {
            border-radius: 7px;
        }

            .reb-delete-card .card-header {
                padding: 7px 9px;
            }

                .reb-delete-card .card-header h5 {
                    font-size: 13px;
                }

            .reb-delete-card .card-body {
                padding: 9px 7px !important;
            }

        .reb-delete-warning {
            padding: 3px 2px;
        }

            .reb-delete-warning .warning-icon {
                font-size: 1.7rem;
            }

            .reb-delete-warning h5 {
                margin-top: 5px;
                font-size: 11px;
            }

        .reb-delete-actions {
            margin-top: 8px;
            gap: 5px;
        }

            .reb-delete-actions .btn {
                min-height: 33px;
                font-size: 10px;
            }
    }


    /* =========================================================
           MOBILE LANDSCAPE

           IMPORTANT:
           NO negative top.
           NO translate.
           NO artificial margin.

           Layout already gives 22px top space.
           Delete page starts immediately there.
        ========================================================== */

    @@media screen and (max-width: 768px) and (orientation: landscape) {

        .reb-delete-page {
            width: 100% !important;
            max-width: 100% !important;
            margin: 0 !important;
            padding: 0 !important;
            position: static !important;
            top: auto !important;
            transform: none !important;
        }


        .reb-delete-wrapper {
            width: 100% !important;
            max-width: 100% !important;
            margin: 0 !important;
            padding: 0 !important;
        }


        .reb-delete-card {
            width: 100% !important;
            max-width: 400px !important;
            margin: 0 auto !important;
            padding: 0 !important;
            border-radius: 4px !important;
            min-height: 0 !important;
        }
            /* -----------------------------------------------------
               HEADER
            ------------------------------------------------------ */

            .reb-delete-card .card-header {
                margin: 0 !important;
                padding: 2px 6px !important;
                height: 17px !important;
                min-height: 17px !important;
            }

                .reb-delete-card .card-header h5 {
                    margin: 0 !important;
                    padding: 0 !important;
                    font-size: 8px !important;
                    line-height: 1 !important;
                }
            /* -----------------------------------------------------
               BODY
            ------------------------------------------------------ */

            .reb-delete-card .card-body {
                margin: 0 !important;
                padding: 2px 6px !important;
                min-height: 0 !important;
            }
        /* -----------------------------------------------------
               WARNING
            ------------------------------------------------------ */

        .reb-delete-warning {
            width: 100% !important;
            margin: 0 !important;
            padding: 0 !important;
            text-align: center !important;
            line-height: 1 !important;
        }

            .reb-delete-warning .warning-icon {
                display: block !important;
                width: fit-content !important;
                margin: 0 auto !important;
                padding: 0 !important;
                font-size: 0.7rem !important;
                line-height: 1 !important;
            }

            .reb-delete-warning h5 {
                margin: 1px 0 0 0 !important;
                padding: 0 !important;
                font-size: 6px !important;
                line-height: 1 !important;
            }
        /* -----------------------------------------------------
               FORM
            ------------------------------------------------------ */

        .reb-delete-card form {
            width: 100% !important;
            margin: 0 !important;
            padding: 0 !important;
            min-height: 0 !important;
        }
        /* -----------------------------------------------------
               ACTIONS
            ------------------------------------------------------ */

        .reb-delete-actions {
            width: 100% !important;
            display: flex !important;
            flex-direction: row !important;
            justify-content: space-between !important;
            align-items: center !important;
            gap: 2px !important;
            margin: 1px 0 0 0 !important;
            padding: 0 !important;
        }
            /* -----------------------------------------------------
               BUTTONS
            ------------------------------------------------------ */

            .reb-delete-actions .btn {
                display: inline-flex !important;
                justify-content: center !important;
                align-items: center !important;
                text-align: center !important;
                width: 48px !important;
                min-width: 48px !important;
                max-width: 48px !important;
                height: 17px !important;
                min-height: 17px !important;
                max-height: 17px !important;
                margin: 0 !important;
                padding: 0 !important;
                font-size: 6px !important;
                font-weight: 500 !important;
                line-height: 1 !important;
                border-radius: 3px !important;
            }

        .reb-delete-no-btn,
        .reb-delete-yes-btn {
            width: 48px !important;
            min-width: 48px !important;
            max-width: 48px !important;
            height: 17px !important;
            min-height: 17px !important;
            max-height: 17px !important;
            margin: 0 !important;
            padding: 0 !important;
        }
    }


    /* =========================================================
           SHORT LANDSCAPE
           <= 380px HEIGHT
        ========================================================== */

    @@media screen and (max-width: 768px) and (orientation: landscape) and (max-height: 380px) {

        .reb-delete-page {
            padding: 0 !important;
            margin: 0 !important;
            position: static !important;
            top: auto !important;
            transform: none !important;
        }

        .reb-delete-card {
            max-width: 380px !important;
            border-radius: 3px !important;
        }

            .reb-delete-card .card-header {
                padding: 1px 5px !important;
                height: 15px !important;
                min-height: 15px !important;
            }

                .reb-delete-card .card-header h5 {
                    font-size: 7px !important;
                }

            .reb-delete-card .card-body {
                padding: 1px 5px !important;
            }

        .reb-delete-warning .warning-icon {
            font-size: 0.6rem !important;
        }

        .reb-delete-warning h5 {
            margin: 0 !important;
            font-size: 5px !important;
            line-height: 1 !important;
        }

        .reb-delete-actions {
            margin: 0 !important;
            gap: 2px !important;
        }

            .reb-delete-actions .btn {
                width: 44px !important;
                min-width: 44px !important;
                max-width: 44px !important;
                height: 15px !important;
                min-height: 15px !important;
                max-height: 15px !important;
                padding: 0 !important;
                font-size: 5.5px !important;
            }

        .reb-delete-no-btn,
        .reb-delete-yes-btn {
            width: 44px !important;
            min-width: 44px !important;
            max-width: 44px !important;
            height: 15px !important;
            min-height: 15px !important;
            max-height: 15px !important;
        }
    }


    /* =========================================================
           VERY SHORT LANDSCAPE
           <= 320px HEIGHT
        ========================================================== */

    @@media screen and (max-width: 768px) and (orientation: landscape) and (max-height: 320px) {

        .reb-delete-page {
            padding: 0 !important;
            margin: 0 !important;
            position: static !important;
            top: auto !important;
            transform: none !important;
        }

        .reb-delete-card {
            max-width: 360px !important;
            border-radius: 2px !important;
        }

            .reb-delete-card .card-header {
                padding: 1px 4px !important;
                height: 13px !important;
                min-height: 13px !important;
            }

                .reb-delete-card .card-header h5 {
                    font-size: 6px !important;
                }

            .reb-delete-card .card-body {
                padding: 1px 4px !important;
            }

        .reb-delete-warning .warning-icon {
            font-size: 0.5rem !important;
        }

        .reb-delete-warning h5 {
            margin: 0 !important;
            font-size: 5px !important;
            line-height: 1 !important;
        }

        .reb-delete-actions {
            margin: 0 !important;
            gap: 1px !important;
        }

            .reb-delete-actions .btn {
                width: 40px !important;
                min-width: 40px !important;
                max-width: 40px !important;
                height: 13px !important;
                min-height: 13px !important;
                max-height: 13px !important;
                padding: 0 !important;
                font-size: 5px !important;
                line-height: 1 !important;
                border-radius: 2px !important;
            }

        .reb-delete-no-btn,
        .reb-delete-yes-btn {
            width: 40px !important;
            min-width: 40px !important;
            max-width: 40px !important;
            height: 13px !important;
            min-height: 13px !important;
            max-height: 13px !important;
        }
    }


    /* =========================================================
           TOUCH
        ========================================================== */

    @@media screen and (pointer: coarse) and (hover: none) {

        .reb-delete-actions .btn {
            touch-action: manipulation;
        }
    }


    /* =========================================================
           FINAL
        ========================================================== */

    .reb-delete-page,
    .reb-delete-wrapper,
    .reb-delete-card,
    .reb-delete-card .card-body,
    .reb-delete-card form {
        box-sizing: border-box;
    }

</style>


<!-- =========================================================
     DELETE PAGE
========================================================== -->

<div class="reb-delete-page">

    <div class="reb-delete-wrapper">

        <div class="card shadow border-danger reb-delete-card">


            <!-- =================================================
                 HEADER
            ================================================== -->

            <div class="card-header bg-danger text-white">

                <h5>
                    Delete Confirmation
                </h5>

            </div>


            <!-- =================================================
                 BODY
            ================================================== -->

            <div class="card-body">


                <!-- =================================================
                     WARNING
                ================================================== -->

                <div class="reb-delete-warning">

                    <i class="bi bi-exclamation-triangle-fill text-danger warning-icon"></i>

                    <h5 class="text-danger">
                        Are you sure you want to delete this record?
                    </h5>

                </div>


                <!-- =================================================
                     FORM
                ================================================== -->

                <form asp-action="Delete"
                      method="post">

                    <input type="hidden"
                           asp-for="Trid" />


                    <!-- =================================================
                         ACTION BUTTONS
                    ================================================== -->

                    <div class="reb-delete-actions">


                        <!-- NO -->

                        <a asp-action="RebReadingInfoList"
                           class="btn btn-secondary reb-delete-no-btn">

                            No

                        </a>


                        <!-- YES -->

                        <button type="submit"
                                class="btn btn-danger reb-delete-yes-btn">

                            Yes

                        </button>


                    </div>

                </form>

            </div>

        </div>

    </div>

</div>
