@model UtilityManagement.Models.TblRebReadingInfo

@{
    ViewData["Title"] = "Delete Reading";
}

<style>

    /* =========================================================
           GLOBAL
        ========================================================== */

    *,
    *::before,
    *::after {
        box-sizing: border-box;
    }

    html,
    body {
        width: 100%;
        max-width: 100%;
        margin: 0;
        padding: 0;
        overflow-x: hidden;
    }


    /* =========================================================
           MAIN CONTAINER
        ========================================================== */

    .reb-delete-page {
        width: 100%;
        max-width: 100%;
        padding: 25px 20px 40px 20px;
    }


    .reb-delete-wrapper {
        width: 100%;
        max-width: 1000px;
        margin: 0 auto;
    }


    /* =========================================================
           DELETE CARD
        ========================================================== */

    .reb-delete-card {
        width: 100%;
        max-width: 700px;
        margin: 0 auto;
        border-radius: 14px;
        overflow: hidden;
    }


        /* =========================================================
           HEADER
        ========================================================== */

        .reb-delete-card .card-header {
            padding: 16px 20px;
        }


            .reb-delete-card .card-header h5 {
                margin: 0;
                font-size: 20px;
                font-weight: 600;
            }


        /* =========================================================
           BODY
        ========================================================== */

        .reb-delete-card .card-body {
            padding: 30px !important;
        }


    /* =========================================================
           WARNING AREA
        ========================================================== */

    .reb-delete-warning {
        text-align: center;
        padding: 15px 10px;
    }


        .reb-delete-warning .warning-icon {
            font-size: 3rem;
            line-height: 1;
        }


        .reb-delete-warning h5 {
            margin-top: 18px;
            margin-bottom: 0;
            font-size: 18px;
            line-height: 1.4;
            font-weight: 600;
        }


    /* =========================================================
           BUTTON AREA
        ========================================================== */

    .reb-delete-actions {
        width: 100%;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
        margin-top: 25px;
    }


        .reb-delete-actions .btn {
            min-height: 42px;
            border-radius: 6px;
            font-size: 14px;
            font-weight: 500;
            padding: 8px 20px;
        }


    .reb-delete-no-btn {
        min-width: 100px;
    }


    .reb-delete-yes-btn {
        min-width: 100px;
    }


    /* =========================================================
           LARGE DESKTOP
           1600px+
        ========================================================== */

    @@media screen and (min-width: 1600px) {

        .reb-delete-page {
            padding: 35px 30px 50px 30px;
        }


        .reb-delete-wrapper {
            max-width: 1050px;
        }


        .reb-delete-card {
            max-width: 720px;
        }


            .reb-delete-card .card-header {
                padding: 18px 25px;
            }


                .reb-delete-card .card-header h5 {
                    font-size: 21px;
                }


            .reb-delete-card .card-body {
                padding: 35px !important;
            }


        .reb-delete-warning .warning-icon {
            font-size: 3.2rem;
        }


        .reb-delete-warning h5 {
            font-size: 19px;
        }
    }


    /* =========================================================
           LAPTOP
           1200px - 1599px
        ========================================================== */

    @@media screen and (min-width: 1200px) and (max-width: 1599px) {

        .reb-delete-page {
            padding: 25px 25px 40px 25px;
        }


        .reb-delete-wrapper {
            max-width: 1000px;
        }


        .reb-delete-card {
            max-width: 700px;
        }


            .reb-delete-card .card-body {
                padding: 28px !important;
            }
    }


    /* =========================================================
           SMALL LAPTOP / TABLET LANDSCAPE
           992px - 1199px
        ========================================================== */

    @@media screen and (min-width: 992px) and (max-width: 1199px) {

        .reb-delete-page {
            padding: 20px 18px 35px 18px;
        }


        .reb-delete-wrapper {
            max-width: 900px;
        }


        .reb-delete-card {
            max-width: 650px;
        }


            .reb-delete-card .card-body {
                padding: 25px !important;
            }


            .reb-delete-card .card-header {
                padding: 15px 18px;
            }


                .reb-delete-card .card-header h5 {
                    font-size: 18px;
                }


        .reb-delete-warning h5 {
            font-size: 17px;
        }
    }


    /* =========================================================
           TABLET
           768px - 991px
        ========================================================== */

    @@media screen and (min-width: 768px) and (max-width: 991px) {

        .reb-delete-page {
            padding: 18px 15px 30px 15px;
        }


        .reb-delete-wrapper {
            max-width: 750px;
        }


        .reb-delete-card {
            max-width: 600px;
            border-radius: 12px;
        }


            .reb-delete-card .card-header {
                padding: 14px 18px;
            }


                .reb-delete-card .card-header h5 {
                    font-size: 18px;
                }


            .reb-delete-card .card-body {
                padding: 22px !important;
            }


        .reb-delete-warning {
            padding: 12px 8px;
        }


            .reb-delete-warning .warning-icon {
                font-size: 2.8rem;
            }


            .reb-delete-warning h5 {
                margin-top: 15px;
                font-size: 16px;
            }


        .reb-delete-actions {
            margin-top: 22px;
        }
    }


    /* =========================================================
           MOBILE
           767px and below
        ========================================================== */

    @@media screen and (max-width: 767px) {

        .reb-delete-page {
            width: 100%;
            max-width: 100%;
            padding: 12px 10px 25px 10px;
        }


        .reb-delete-wrapper {
            width: 100%;
            max-width: 100%;
        }


        .reb-delete-card {
            width: 100%;
            max-width: 100%;
            border-radius: 12px;
        }


            .reb-delete-card .card-header {
                padding: 13px 15px;
            }


                .reb-delete-card .card-header h5 {
                    font-size: 17px;
                    line-height: 1.3;
                }


            .reb-delete-card .card-body {
                padding: 18px 15px !important;
            }
        /* =====================================================
               WARNING
            ====================================================== */

        .reb-delete-warning {
            padding: 10px 5px;
        }


            .reb-delete-warning .warning-icon {
                font-size: 2.6rem;
            }


            .reb-delete-warning h5 {
                margin-top: 14px;
                font-size: 15px;
                line-height: 1.4;
            }
        /* =====================================================
               BUTTONS
            ====================================================== */

        .reb-delete-actions {
            flex-direction: column;
            align-items: stretch;
            gap: 10px;
            margin-top: 20px;
        }


            .reb-delete-actions .btn {
                width: 100%;
                min-width: 0;
                min-height: 42px;
                font-size: 13px;
                padding: 8px 14px;
            }
    }


    /* =========================================================
           SMALL MOBILE
           400px and below
        ========================================================== */

    @@media screen and (max-width: 400px) {

        .reb-delete-page {
            padding: 8px 7px 20px 7px;
        }


        .reb-delete-card {
            border-radius: 10px;
        }


            .reb-delete-card .card-header {
                padding: 11px 13px;
            }


                .reb-delete-card .card-header h5 {
                    font-size: 16px;
                }


            .reb-delete-card .card-body {
                padding: 15px 12px !important;
            }


        .reb-delete-warning {
            padding: 8px 4px;
        }


            .reb-delete-warning .warning-icon {
                font-size: 2.3rem;
            }


            .reb-delete-warning h5 {
                margin-top: 12px;
                font-size: 14px;
            }


        .reb-delete-actions {
            margin-top: 18px;
            gap: 8px;
        }


            .reb-delete-actions .btn {
                min-height: 40px;
                font-size: 12px;
                padding: 7px 10px;
            }
    }


    /* =========================================================
           MOBILE LANDSCAPE
           Same responsive spacing pattern as CREATE/EDIT
        ========================================================== */

    @@media screen and (max-width: 767px) and (orientation: landscape) {

        .reb-delete-page {
            padding: 10px 12px 20px 12px;
        }


        .reb-delete-wrapper {
            max-width: 100%;
        }


        .reb-delete-card {
            max-width: 100%;
            border-radius: 10px;
        }


            .reb-delete-card .card-header {
                padding: 9px 14px;
            }


                .reb-delete-card .card-header h5 {
                    font-size: 15px;
                    line-height: 1.2;
                }


            .reb-delete-card .card-body {
                padding: 13px 14px !important;
            }


        .reb-delete-warning {
            padding: 6px 5px;
        }


            .reb-delete-warning .warning-icon {
                font-size: 2.1rem;
            }


            .reb-delete-warning h5 {
                margin-top: 10px;
                font-size: 13px;
            }
        /* =====================================================
               LANDSCAPE BUTTONS
            ====================================================== */

        .reb-delete-actions {
            flex-direction: row;
            align-items: center;
            justify-content: space-between;
            margin-top: 12px;
            gap: 8px;
        }


            .reb-delete-actions .btn {
                width: auto;
                min-height: 34px;
                font-size: 11px;
                padding: 5px 12px;
            }


        .reb-delete-no-btn,
        .reb-delete-yes-btn {
            min-width: 90px;
        }
    }


    /* =========================================================
           VERY SHORT LANDSCAPE
           max-height: 380px
        ========================================================== */

    @@media screen and (max-width: 767px) and (orientation: landscape) and (max-height: 380px) {

        .reb-delete-page {
            padding: 5px 9px 12px 9px;
        }


        .reb-delete-card .card-header {
            padding: 7px 12px;
        }


            .reb-delete-card .card-header h5 {
                font-size: 13px;
            }


        .reb-delete-card .card-body {
            padding: 10px 12px !important;
        }


        .reb-delete-warning {
            padding: 4px;
        }


            .reb-delete-warning .warning-icon {
                font-size: 1.8rem;
            }


            .reb-delete-warning h5 {
                margin-top: 7px;
                font-size: 11px;
                line-height: 1.3;
            }


        .reb-delete-actions {
            margin-top: 8px;
            gap: 8px;
        }


            .reb-delete-actions .btn {
                min-height: 30px;
                font-size: 10px;
                padding: 4px 10px;
            }


        .reb-delete-no-btn,
        .reb-delete-yes-btn {
            min-width: 80px;
        }
    }


    /* =========================================================
           TOUCH DEVICE
        ========================================================== */

    @@media screen and (pointer: coarse) and (hover: none) {

        .reb-delete-actions .btn {
            touch-action: manipulation;
        }
    }


    /* =========================================================
           SAFE AREA
        ========================================================== */

    @@media screen and (max-width: 768px) {

        .reb-delete-page {
            padding-top: max(12px, env(safe-area-inset-top));
        }
    }


    /* =========================================================
           PREVENT HORIZONTAL OVERFLOW
        ========================================================== */

    .reb-delete-page,
    .reb-delete-wrapper,
    .reb-delete-card,
    .reb-delete-card .card-body,
    .reb-delete-card form {
        max-width: 100%;
        box-sizing: border-box;
    }

</style>


<div class="reb-delete-page">

    <div class="reb-delete-wrapper">

        <div class="card shadow border-danger reb-delete-card">

            <div class="card-header bg-danger text-white">
                <h5>Delete Confirmation</h5>
            </div>


            <div class="card-body">

                <div class="reb-delete-warning">

                    <i class="bi bi-exclamation-triangle-fill text-danger warning-icon"></i>

                    <h5 class="text-danger">
                        Are you sure you want to delete this record?
                    </h5>

                </div>


                <form asp-action="Delete" method="post">

                    <input type="hidden" asp-for="Trid" />

                    <div class="reb-delete-actions">

                        <a asp-action="RebReadingInfoList"
                           class="btn btn-secondary reb-delete-no-btn">
                            No
                        </a>


                        <button type="submit"
                                class="btn btn-danger reb-delete-yes-btn">
                            Yes
                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>
