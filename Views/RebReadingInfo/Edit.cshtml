@model UtilityManagement.Models.TblRebReadingInfo

@{
    ViewData["Title"] = "Edit REB Reading";
}


<link rel="stylesheet" href="~/css/edit-responsive.css"asp-append-version="true" />

<div class="container-fluid edit-page">
    <div class="row justify-content-center">
        <div class="col-12 col-xl-10 edit-wrapper">
            <div class="card shadow-lg border-0 edit-card">
                <div class="card-header bg-success text-dark">
                    <h5 class="mb-0">
                        Edit REB Reading
                    </h5>

                </div>


                <!-- =====================================================
                     BODY
                ====================================================== -->

                <div class="card-body edit-body">

                    <form asp-action="Edit"method="post"class="edit-form">
                        <input type="hidden" asp-for="Trid" />
                        <!-- =================================================
                             VALIDATION SUMMARY
                        ================================================== -->

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>


                        <!-- =================================================
                             FORM FIELDS
                        ================================================== -->

                        <div class="row g-3">


                            <!-- =================================================
                                 DATE
                            ================================================== -->

                            <div class="col-lg-3 col-md-6 col-sm-12">

                                <div class="reb-field">

                                    <label asp-for="Trdate"
                                           class="form-label">

                                        Date
                                        <span class="text-danger">*</span>

                                    </label>


                                    <input asp-for="Trdate"
                                           type="date"
                                           class="form-control" />


                                    <span asp-validation-for="Trdate"
                                          class="text-danger">
                                    </span>

                                </div>

                            </div>


                            <!-- =================================================
                                 EQUIPMENT
                            ================================================== -->

                            <div class="col-lg-3 col-md-6 col-sm-12">

                                <div class="reb-field">

                                    <label asp-for="Eqid"
                                           class="form-label">

                                        Equipment
                                        <span class="text-danger">*</span>

                                    </label>


                                    <select asp-for="Eqid"
                                            asp-items="ViewBag.EquipmentList"
                                            class="form-select">

                                        <option value="">
                                            -- Select Equipment --
                                        </option>

                                    </select>


                                    <span asp-validation-for="Eqid"
                                          class="text-danger">
                                    </span>

                                </div>

                            </div>


                            <!-- =================================================
                                 ELECTRICITY GENERATION
                            ================================================== -->

                            <div class="col-lg-3 col-md-6 col-sm-12">

                                <div class="reb-field">

                                    <label asp-for="ElecGen"
                                           class="form-label">

                                        Electricity Generation (Kwh)
                                        <span class="text-danger">*</span>

                                    </label>


                                    <input asp-for="ElecGen"
                                           class="form-control" />


                                    <span asp-validation-for="ElecGen"
                                          class="text-danger">
                                    </span>

                                </div>

                            </div>


                            <!-- =================================================
                                 RUNNING HOUR
                            ================================================== -->

                            <div class="col-lg-3 col-md-6 col-sm-12">

                                <div class="reb-field">

                                    <label asp-for="RunHr"
                                           class="form-label">

                                        Running Hr
                                        <span class="text-danger">*</span>

                                    </label>


                                    <input asp-for="RunHr"
                                           class="form-control" />


                                    <span asp-validation-for="RunHr"
                                          class="text-danger">
                                    </span>

                                </div>

                            </div>


                            <!-- =================================================
                                 BDT/KWH
                            ================================================== -->

                            <div class="col-lg-3 col-md-6 col-sm-12">

                                <div class="reb-field">

                                    <label asp-for="BdtKwh"
                                           class="form-label">

                                        BDT (tk/kwh)
                                        <span class="text-danger">*</span>

                                    </label>


                                    <input asp-for="BdtKwh"
                                           class="form-control" />


                                    <span asp-validation-for="BdtKwh"
                                          class="text-danger">
                                    </span>

                                </div>

                            </div>


                            <!-- =================================================
                                 OTHER CONSUMABLE
                            ================================================== -->

                            <div class="col-lg-3 col-md-6 col-sm-12">

                                <div class="reb-field">

                                    <label asp-for="OtConsumable"
                                           class="form-label">

                                        Others Consumable (TK)
                                        <span class="text-danger">*</span>

                                    </label>


                                    <input asp-for="OtConsumable"
                                           class="form-control" />


                                    <span asp-validation-for="OtConsumable"
                                          class="text-danger">
                                    </span>

                                </div>

                            </div>


                            <!-- =================================================
                                 TROUBLESHOOTING
                            ================================================== -->

                            <div class="col-lg-3 col-md-6 col-sm-12">

                                <div class="reb-field">

                                    <label asp-for="Troubleshoot"
                                           class="form-label">

                                        Troubleshooting (Tk)
                                        <span class="text-danger">*</span>

                                    </label>


                                    <input asp-for="Troubleshoot"
                                           class="form-control" />


                                    <span asp-validation-for="Troubleshoot"
                                          class="text-danger">
                                    </span>

                                </div>

                            </div>


                            <!-- =================================================
                                 SERVICE CHARGE
                            ================================================== -->

                            <div class="col-lg-3 col-md-6 col-sm-12">

                                <div class="reb-field">

                                    <label asp-for="ServiceCharge"
                                           class="form-label">

                                        Service Charge
                                        <span class="text-danger">*</span>

                                    </label>


                                    <input asp-for="ServiceCharge"
                                           class="form-control" />


                                    <span asp-validation-for="ServiceCharge"
                                          class="text-danger">
                                    </span>

                                </div>

                            </div>


                            <!-- =================================================
                                 REPAIR CHARGE
                            ================================================== -->

                            <div class="col-lg-3 col-md-6 col-sm-12">

                                <div class="reb-field">

                                    <label asp-for="RepairCharge"
                                           class="form-label">

                                        Repair Charge
                                        <span class="text-danger">*</span>

                                    </label>


                                    <input asp-for="RepairCharge"
                                           class="form-control" />


                                    <span asp-validation-for="RepairCharge"
                                          class="text-danger">
                                    </span>

                                </div>

                            </div>


                            <!-- =================================================
                                 TOTAL
                            ================================================== -->

                            <div class="col-lg-3 col-md-6 col-sm-12">

                                <div class="reb-field">

                                    <label asp-for="Total"
                                           class="form-label">

                                        Total
                                        <span class="text-danger">*</span>

                                    </label>


                                    <input asp-for="Total"
                                           class="form-control"
                                           readonly />


                                    <span asp-validation-for="Total"
                                          class="text-danger">
                                    </span>

                                </div>

                            </div>


                            <!-- =================================================
                                 TK/KWH
                            ================================================== -->

                            <div class="col-lg-3 col-md-6 col-sm-12">

                                <div class="reb-field">

                                    <label asp-for="TkKwh"
                                           class="form-label">

                                        Tk/Kwh
                                        <span class="text-danger">*</span>

                                    </label>


                                    <input asp-for="TkKwh"
                                           class="form-control"
                                           readonly />


                                    <span asp-validation-for="TkKwh"
                                          class="text-danger">
                                    </span>

                                </div>

                            </div>

                        </div>


                        <!-- =================================================
                             ACTION BUTTONS
                        ================================================== -->

                        <div class="edit-form-buttons">

                            <a asp-action="RebReadingInfoList"
                               class="btn btn-secondary">
                                <i class="bi bi-arrow-left"></i>&nbsp; Back
                            </a>

                            <button type="submit"
                                    class="btn btn-success px-4">
                                <i class="bi bi-check-circle"></i>&nbsp; Update
                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>
    </div>
</div>


    <!-- =========================================================
         CALCULATION SCRIPT
    ========================================================== -->

    <script>

        document.addEventListener("DOMContentLoaded", function () {

            const elecGen = document.getElementById("ElecGen");
            const bdtKwh = document.getElementById("BdtKwh");
            const otConsumable = document.getElementById("OtConsumable");
            const troubleshoot = document.getElementById("Troubleshoot");
            const serviceCharge = document.getElementById("ServiceCharge");
            const repairCharge = document.getElementById("RepairCharge");

            const total = document.getElementById("Total");
            const tkKwh = document.getElementById("TkKwh");


            /* =====================================================
               CALCULATE VALUES
            ====================================================== */

            function calculateValues() {

                let totalValue =
                    (parseFloat(bdtKwh?.value) || 0) +
                    (parseFloat(otConsumable?.value) || 0) +
                    (parseFloat(troubleshoot?.value) || 0) +
                    (parseFloat(serviceCharge?.value) || 0) +
                    (parseFloat(repairCharge?.value) || 0);


                /* =================================================
                   TOTAL
                ================================================== */

                if (total) {
                    total.value = totalValue.toFixed(2);
                }


                /* =================================================
                   GENERATION
                ================================================== */

                let generation =
                    parseFloat(elecGen?.value) || 0;


                /* =================================================
                   TK/KWH
                ================================================== */

                if (tkKwh) {

                    tkKwh.value =
                        generation > 0
                            ? (totalValue / generation).toFixed(2)
                            : "0.00";

                }
            }


            /* =====================================================
               CHANGE EVENTS ONLY
            ====================================================== */

            [
                elecGen,
                bdtKwh,
                otConsumable,
                troubleshoot,
                serviceCharge,
                repairCharge
            ].forEach(function (element) {

                if (!element) {
                    return;
                }

                element.addEventListener("change", calculateValues);

            });

            // NO INITIAL CALCULATION
            // calculateValues();

        });

    </script>



@section Scripts {

    @{
        await Html.RenderPartialAsync(
        "_ValidationScriptsPartial"
        );
    }

}
