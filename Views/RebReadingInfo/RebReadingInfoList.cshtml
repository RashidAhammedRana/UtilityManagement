@model IEnumerable<UtilityManagement.Models.TblRebReadingInfo>

@{
    ViewData["Title"] = "REB Reading Info List";

    int currentPage = ViewBag.CurrentPage;
    int totalPages = ViewBag.TotalPages;

    int pageSize = 30;
    int sl = (currentPage - 1) * pageSize;

    int startPage = Math.Max(1, currentPage - 2);
    int endPage = Math.Min(totalPages, currentPage + 2);

    bool canCreate = ViewBag.CanCreate ?? false;
    bool canEdit = ViewBag.CanEdit ?? false;
    bool canDelete = ViewBag.CanDelete ?? false;

    string search = ViewBag.SearchString ?? "";
}

<h2 class="text-center daily-list-title">
    REB Reading Info List
</h2>

<p class="text-muted text-center daily-list-total">
    Total Readings: <strong>@ViewBag.totalRebReadings</strong>
</p>



<div class="d-flex justify-content-between mb-3 align-items-center daily-list-toolbar">

    <!-- LEFT: SEARCH -->
    <form method="get"
          asp-action="RebReadingInfoList"
          class="d-flex gap-2 align-items-center daily-list-search-form"
          id="searchForm">

        <input type="text"
               name="searchString"
               id="searchBox"
               value="@ViewBag.SearchString"
               class="form-control daily-list-search-box"
               placeholder="Search here..."
               style="width: 300px;" />

    </form>


    <!-- RIGHT: ACTION BUTTONS -->
    <div class="d-flex gap-2 daily-list-actions">

        @if (canCreate)
        {
            <a asp-action="Create"
               class="btn btn-primary daily-create-btn">
                + Create
            </a>
        }

        <button type="button"
                class="btn btn-secondary daily-back-btn"
                onclick="window.history.back();">
            Back
        </button>

    </div>

</div>



<!-- =====================================================
     TABLE
====================================================== -->

<div class="table-responsive">
    <table class="table table-bordered table-hover" id="rebTable">

        <thead class="table-dark">
            <tr class="text-center align-text-top">
                <th>SL</th>
                <th style="width: 10%;">Date</th>
                <th>Equipment</th>
                <th>Company</th>
                <th>Elec Gen (Kwh)</th>
                <th>Running Hr</th>
                <th>BDT(Tk/Kwh)</th>
                <th>Others</th>
                <th>Troubleshooting(Tk)</th>
                <th>Service Charge(Tk)</th>
                <th>Repair Charge(Tk)</th>
                <th>Total(Tk)</th>
                <th>Tk/Kwh</th>
                <th>Actions</th>
            </tr>
        </thead>


        <tbody>

            @foreach (var item in Model)
            {
                sl++;

                <tr>
                    <td class="text-center">@sl</td>
                    <td class="text-center">@item.Trdate?.ToString("dd-MM-yyyy")</td>
                    <td class="text-center">@item.Eq?.EquipmentName</td>
                    <td class="text-center">@item.Eq?.CurrentLocation</td>
                    <td class="text-center">@item.ElecGen</td>
                    <td class="text-center">@item.RunHr</td>
                    <td class="text-center">@item.BdtKwh</td>
                    <td class="text-center">@item.OtConsumable</td>
                    <td class="text-center">@item.Troubleshoot</td>
                    <td class="text-center">@item.ServiceCharge</td>
                    <td class="text-center">@item.RepairCharge</td>
                    <td class="text-center">@item.Total</td>
                    <td class="text-center">@item.TkKwh</td>
                    <!-- ACTIONS -->
                    <td class="text-center">
                        <div class="reb-table-actions">
                            @if (canEdit)
                            {
                                <a asp-action="Edit" asp-route-id="@item.Trid" class="btn btn-success btn-sm">
                                    Edit
                                </a>
                            }

                            @if (canDelete)
                            {
                                <a asp-action="Delete" asp-route-id="@item.Trid" class="btn btn-danger btn-sm">
                                    Delete
                                </a>
                            }

                        </div>

                    </td>

                </tr>
            }

        </tbody>

    </table>

</div>


<!-- PAGINATION -->
<nav>
    <ul class="pagination justify-content-center flex-wrap">

        <li class="page-item @(currentPage == 1 ? "disabled" : "")">
            <a class="page-link"
               href="@Url.Action("RebReadingInfoList", new { page = currentPage - 1, searchString = search })">
                Prev
            </a>
        </li>

        @for (int i = startPage; i <= endPage; i++)
        {
            <li class="page-item @(i == currentPage ? "active" : "")">
                <a class="page-link"
                   href="@Url.Action("RebReadingInfoList", new { page = i, searchString = search })">
                    @i
                </a>
            </li>
        }

        <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
            <a class="page-link"
               href="@Url.Action("RebReadingInfoList", new { page = currentPage + 1, searchString = search })">
                Next
            </a>
        </li>

    </ul>
</nav>

<!-- =========================================================
     SEARCH SCRIPT
========================================================== -->

<script>

    document.addEventListener("DOMContentLoaded", function () {

        const searchBox =
            document.getElementById("searchBox");

        const searchForm =
            document.getElementById("searchForm");


        if (!searchBox || !searchForm) {
            return;
        }


        /* =====================================================
           AUTO SEARCH WITH DEBOUNCE
        ====================================================== */

        let searchDelay;


        searchBox.addEventListener("input", function () {

            clearTimeout(searchDelay);


            searchDelay = setTimeout(function () {

                searchForm.submit();

            }, 1000);

        });


        /* =====================================================
           KEEP SEARCH BOX FOCUSED
        ====================================================== */

        searchBox.focus();


        /*
         * Move cursor to the end
         */

        const value =
            searchBox.value;

        searchBox.value = "";

        searchBox.value = value;

    });

</script>
