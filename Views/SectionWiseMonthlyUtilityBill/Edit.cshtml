@model UtilityManagement.Models.TblSectionWiseMonthlyUtilityCost

@{
    ViewData["Title"] = "Edit Section Wise Monthly Utility Cost";
}

<div class="container-fluid utility-page">

    <!-- ========================================================= -->
    <!-- PAGE HEADER -->
    <!-- ========================================================= -->

    <div class="page-header mb-3">

        <div class="row align-items-center g-2">

            <div class="col-12 col-md">

                <div class="d-flex align-items-center">

                    <div class="page-icon me-2">
                        <i class="bi bi-pencil-square"></i>
                    </div>

                    <div>

                        <h4 class="page-title mb-0">
                            Edit Section Wise Monthly Utility Cost
                        </h4>

                        <div class="page-subtitle">
                            Update monthly utility cost by section
                        </div>

                    </div>

                </div>

            </div>


            <div class="col-12 col-md-auto">

                <a asp-action="SectionWiseMonthlyUtilityBillList"
                   class="btn btn-light border shadow-sm back-btn">

                    <i class="bi bi-arrow-left me-1"></i>
                    Back to List

                </a>

            </div>

        </div>

    </div>


    <form asp-action="Edit"
          method="post"
          autocomplete="off"
          id="utilityCostForm">

        @Html.AntiForgeryToken()

        <!-- Hidden ID -->

        <input type="hidden"
               asp-for="Trid" />

        <input type="hidden"
               asp-for="Comid" />


        <!-- ===================================================== -->
        <!-- VALIDATION -->
        <!-- ===================================================== -->

        <div asp-validation-summary="ModelOnly"
             class="alert alert-danger validation-summary">
        </div>


        <!-- ===================================================== -->
        <!-- BASIC INFORMATION -->
        <!-- ===================================================== -->

        <div class="form-card mb-3">

            <div class="form-card-header">

                <div class="section-icon basic-icon">
                    <i class="bi bi-info-circle-fill"></i>
                </div>

                <div>

                    <div class="section-title">
                        Basic Information
                    </div>

                    <div class="section-description">
                        Update company, section and billing period
                    </div>

                </div>

            </div>


            <div class="form-card-body">

                <div class="row g-3">


                    <!-- COMPANY -->

                    <div class="col-12 col-lg-5">

                        <label class="form-label custom-label">

                            <i class="bi bi-building text-primary"></i>
                            Company

                        </label>

                        <div class="input-group custom-input-group">

                            <span class="input-group-text">
                                <i class="bi bi-building"></i>
                            </span>

                            <input type="text"
                                   class="form-control bg-light"
                                   value="@ViewBag.CompanyName"
                                   readonly />

                        </div>

                        <span asp-validation-for="Comid"
                              class="field-validation">
                        </span>

                    </div>


                    <!-- SECTION -->

                    <div class="col-12 col-lg-3">

                        <label asp-for="Depid"
                               class="form-label custom-label">

                            <i class="bi bi-diagram-3-fill text-primary"></i>
                            Section

                        </label>

                        <select asp-for="Depid"
                                class="form-select custom-control">

                            <option value="">
                                -- Select Section --
                            </option>

                            @if (ViewBag.Departments != null)
                            {
                                foreach (var department in ViewBag.Departments)
                                {
                                    <option value="@department.Depid">
                                        @department.DepartmentName
                                    </option>
                                }
                            }

                        </select>

                        <span asp-validation-for="Depid"
                              class="field-validation">
                        </span>

                    </div>


                    <!-- MONTH -->

                    <div class="col-12 col-sm-6 col-lg-2">

                        <label asp-for="Month"
                               class="form-label custom-label">

                            <i class="bi bi-calendar-month text-primary"></i>
                            Month

                        </label>

                        <select asp-for="Month"
                                class="form-select custom-control">

                            <option value="">
                                -- Month --
                            </option>

                            <option value="January">January</option>
                            <option value="February">February</option>
                            <option value="March">March</option>
                            <option value="April">April</option>
                            <option value="May">May</option>
                            <option value="June">June</option>
                            <option value="July">July</option>
                            <option value="August">August</option>
                            <option value="September">September</option>
                            <option value="October">October</option>
                            <option value="November">November</option>
                            <option value="December">December</option>

                        </select>

                        <span asp-validation-for="Month"
                              class="field-validation">
                        </span>

                    </div>


                    <!-- YEAR -->

                    <div class="col-12 col-sm-6 col-lg-2">

                        <label asp-for="Year"
                               class="form-label custom-label">

                            <i class="bi bi-calendar-event text-primary"></i>
                            Year

                        </label>

                        <select asp-for="Year"
                                class="form-select custom-control">

                            <option value="">
                                -- Year --
                            </option>

                            @for (int year = 2026; year <= 2035; year++)
                            {
                                <option value="@year">
                                    @year
                                </option>
                            }

                        </select>

                        <span asp-validation-for="Year"
                              class="field-validation">
                        </span>

                    </div>

                </div>

            </div>

        </div>


        <!-- ===================================================== -->
        <!-- UTILITY COST -->
        <!-- ===================================================== -->

        <div class="form-card mb-3">

            <div class="form-card-header">

                <div class="section-icon utility-icon">
                    <i class="bi bi-lightning-charge-fill"></i>
                </div>

                <div>

                    <div class="section-title">
                        Utility Costs
                    </div>

                    <div class="section-description">
                        Update monthly utility expenses
                    </div>

                </div>

            </div>


            <div class="form-card-body">

                <div class="row g-3">


                    <!-- ELECTRICITY -->

                    <div class="col-12 col-sm-6 col-md-4 col-lg">

                        <div class="utility-box electricity-box">

                            <div class="utility-title">

                                <span class="utility-symbol electricity-symbol">
                                    <i class="bi bi-lightning-fill"></i>
                                </span>

                                <span>
                                    Electricity
                                </span>

                            </div>

                            <div class="input-group cost-group">

                                <span class="input-group-text">
                                    ৳
                                </span>

                                <input asp-for="ElectricityCost"
                                       type="number"
                                       step="0.01"
                                       min="0"
                                       class="form-control cost-input"
                                       placeholder="0.00" />

                            </div>

                            <span asp-validation-for="ElectricityCost"
                                  class="field-validation">
                            </span>

                        </div>

                    </div>


                    <!-- STEAM -->

                    <div class="col-12 col-sm-6 col-md-4 col-lg">

                        <div class="utility-box steam-box">

                            <div class="utility-title">

                                <span class="utility-symbol steam-symbol">
                                    <i class="bi bi-cloud-fill"></i>
                                </span>

                                <span>
                                    Steam
                                </span>

                            </div>

                            <div class="input-group cost-group">

                                <span class="input-group-text">
                                    ৳
                                </span>

                                <input asp-for="SteamCost"
                                       type="number"
                                       step="0.01"
                                       min="0"
                                       class="form-control cost-input"
                                       placeholder="0.00" />

                            </div>

                            <span asp-validation-for="SteamCost"
                                  class="field-validation">
                            </span>

                        </div>

                    </div>


                    <!-- ETP -->

                    <div class="col-12 col-sm-6 col-md-4 col-lg">

                        <div class="utility-box etp-box">

                            <div class="utility-title">

                                <span class="utility-symbol etp-symbol">
                                    <i class="bi bi-droplet-fill"></i>
                                </span>

                                <span>
                                    ETP
                                </span>

                            </div>

                            <div class="input-group cost-group">

                                <span class="input-group-text">
                                    ৳
                                </span>

                                <input asp-for="EtpCost"
                                       type="number"
                                       step="0.01"
                                       min="0"
                                       class="form-control cost-input"
                                       placeholder="0.00" />

                            </div>

                            <span asp-validation-for="EtpCost"
                                  class="field-validation">
                            </span>

                        </div>

                    </div>


                    <!-- WTP -->

                    <div class="col-12 col-sm-6 col-md-4 col-lg">

                        <div class="utility-box wtp-box">

                            <div class="utility-title">

                                <span class="utility-symbol wtp-symbol">
                                    <i class="bi bi-water"></i>
                                </span>

                                <span>
                                    WTP
                                </span>

                            </div>

                            <div class="input-group cost-group">

                                <span class="input-group-text">
                                    ৳
                                </span>

                                <input asp-for="WtpCost"
                                       type="number"
                                       step="0.01"
                                       min="0"
                                       class="form-control cost-input"
                                       placeholder="0.00" />

                            </div>

                            <span asp-validation-for="WtpCost"
                                  class="field-validation">
                            </span>

                        </div>

                    </div>


                    <!-- AC -->

                    <div class="col-12 col-sm-6 col-md-4 col-lg">

                        <div class="utility-box ac-box">

                            <div class="utility-title">

                                <span class="utility-symbol ac-symbol">
                                    <i class="bi bi-snow2"></i>
                                </span>

                                <span>
                                    Air compressor
                                </span>

                            </div>

                            <div class="input-group cost-group">

                                <span class="input-group-text">
                                    ৳
                                </span>

                                <input asp-for="AcCost"
                                       type="number"
                                       step="0.01"
                                       min="0"
                                       class="form-control cost-input"
                                       placeholder="0.00" />

                            </div>

                            <span asp-validation-for="AcCost"
                                  class="field-validation">
                            </span>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- ===================================================== -->
        <!-- PRODUCTION & COST ANALYSIS -->
        <!-- ===================================================== -->

        <div class="form-card mb-3">

            <div class="form-card-header">

                <div class="section-icon analysis-icon">
                    <i class="bi bi-graph-up-arrow"></i>
                </div>

                <div>

                    <div class="section-title">
                        Production & Cost Analysis
                    </div>

                    <div class="section-description">
                        Update production and automatically calculated costs
                    </div>

                </div>

            </div>


            <div class="form-card-body">

                <div class="row g-3">


                    <!-- PRODUCTION -->

                    <div class="col-12 col-md-4">

                        <div class="analysis-box production-box">

                            <label asp-for="Production"
                                   class="form-label custom-label">

                                <i class="bi bi-box-seam text-success"></i>
                                Production

                            </label>

                            <div class="input-group">

                                <span class="input-group-text">
                                    <i class="bi bi-box-seam"></i>
                                </span>

                                <input asp-for="Production"
                                       type="number"
                                       step="0.01"
                                       min="0"
                                       class="form-control"
                                       id="production"
                                       placeholder="Enter production" />

                            </div>

                            <span asp-validation-for="Production"
                                  class="field-validation">
                            </span>

                        </div>

                    </div>


                    <!-- TOTAL COST -->

                    <div class="col-12 col-md-4">

                        <div class="analysis-box total-box">

                            <label asp-for="TotalCost"
                                   class="form-label custom-label">

                                <i class="bi bi-calculator-fill text-danger"></i>
                                Total Cost

                            </label>

                            <div class="input-group">

                                <span class="input-group-text total-symbol">
                                    ৳
                                </span>

                                <input asp-for="TotalCost"
                                       type="number"
                                       step="0.01"
                                       class="form-control calculated-field"
                                       id="totalCost"
                                       placeholder="0.00"
                                       readonly />

                            </div>

                            <div class="calculation-note">

                                <i class="bi bi-info-circle me-1"></i>
                                Automatically calculated

                            </div>

                            <span asp-validation-for="TotalCost"
                                  class="field-validation">
                            </span>

                        </div>

                    </div>


                    <!-- PER UNIT -->

                    <div class="col-12 col-md-4">

                        <div class="analysis-box per-unit-box">

                            <label asp-for="PerUnitProductionCost"
                                   class="form-label custom-label">

                                <i class="bi bi-pie-chart-fill text-primary"></i>
                                Per Unit Production Cost

                            </label>

                            <div class="input-group">

                                <span class="input-group-text per-unit-symbol">
                                    ৳
                                </span>

                                <input asp-for="PerUnitProductionCost"
                                       type="number"
                                       step="0.0001"
                                       class="form-control calculated-field"
                                       id="perUnitCost"
                                       placeholder="0.0000"
                                       readonly />

                            </div>

                            <div class="calculation-note">

                                <i class="bi bi-info-circle me-1"></i>
                                Total Cost ÷ Production

                            </div>

                            <span asp-validation-for="PerUnitProductionCost"
                                  class="field-validation">
                            </span>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- ===================================================== -->
        <!-- ACTION BUTTONS -->
        <!-- ===================================================== -->

        <div class="action-area">

            <a asp-action="SectionWiseMonthlyUtilityBillList"
               class="btn btn-light border action-btn">

                <i class="bi bi-x-circle me-1"></i>
                Cancel

            </a>

            <button type="submit"
                    class="btn btn-primary action-btn save-btn">

                <i class="bi bi-check-circle-fill me-1"></i>
                Update Record

            </button>

        </div>

    </form>

</div>


<!-- ============================================================= -->
<!-- STYLES -->
<!-- ============================================================= -->

<style>

    /* ========================================================= */
    /* PAGE */
    /* ========================================================= */

    .utility-page {
        max-width: 1600px;
        margin: 0 auto;
        padding-top: 10px;
        padding-bottom: 30px;
    }


    /* ========================================================= */
    /* HEADER */
    /* ========================================================= */

    .page-icon {
        width: 42px;
        height: 42px;
        min-width: 42px;
        border-radius: 11px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(13, 110, 253, 0.10);
        color: #0d6efd;
        font-size: 20px;
    }

    .page-title {
        font-size: 1.35rem;
        font-weight: 700;
        color: #1f2937;
    }

    .page-subtitle {
        color: #6b7280;
        font-size: 0.78rem;
        margin-top: 2px;
    }

    .back-btn {
        min-height: 38px;
        border-radius: 8px;
        white-space: nowrap;
    }


    /* ========================================================= */
    /* FORM CARD */
    /* ========================================================= */

    .form-card {
        background: #ffffff;
        border: 1px solid #e8ebf0;
        border-radius: 14px;
        box-shadow: 0 3px 12px rgba(0, 0, 0, 0.035);
        overflow: hidden;
    }

    .form-card-header {
        display: flex;
        align-items: center;
        padding: 14px 18px;
        background: #ffffff;
        border-bottom: 1px solid #edf0f4;
    }

    .form-card-body {
        padding: 18px;
    }

    .section-icon {
        width: 38px;
        height: 38px;
        min-width: 38px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-right: 11px;
        font-size: 17px;
    }

    .basic-icon {
        background: rgba(13, 110, 253, 0.10);
        color: #0d6efd;
    }

    .utility-icon {
        background: rgba(255, 193, 7, 0.12);
        color: #d99a00;
    }

    .analysis-icon {
        background: rgba(25, 135, 84, 0.10);
        color: #198754;
    }

    .section-title {
        font-size: 0.95rem;
        font-weight: 700;
        color: #1f2937;
    }

    .section-description {
        font-size: 0.73rem;
        color: #8a93a2;
        margin-top: 1px;
    }


    /* ========================================================= */
    /* LABELS / INPUT */
    /* ========================================================= */

    .custom-label {
        font-size: 0.82rem;
        font-weight: 600;
        color: #344054;
        margin-bottom: 6px;
    }

        .custom-label i {
            margin-right: 4px;
        }

    .custom-control,
    .form-control,
    .form-select {
        min-height: 40px;
        border-radius: 8px;
        border-color: #dfe3e8;
        font-size: 0.85rem;
    }

        .form-control:focus,
        .form-select:focus {
            border-color: #86b7fe;
            box-shadow: 0 0 0 0.15rem rgba(13, 110, 253, 0.10);
        }

    .input-group-text {
        min-height: 40px;
        background: #f8f9fa;
        border-color: #dfe3e8;
        color: #667085;
        font-size: 0.84rem;
    }

    .custom-input-group .form-control {
        border-left: 0;
    }


    /* ========================================================= */
    /* UTILITY BOX */
    /* ========================================================= */

    .utility-box {
        height: 100%;
        padding: 14px;
        border: 1px solid #e7eaf0;
        border-radius: 11px;
        background: #fafbfc;
        transition: border-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
    }

        .utility-box:hover {
            border-color: #cbd5e1;
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.05);
            transform: translateY(-1px);
        }

    .utility-title {
        display: flex;
        align-items: center;
        font-size: 0.82rem;
        font-weight: 600;
        color: #344054;
        margin-bottom: 10px;
    }

    .utility-symbol {
        width: 28px;
        height: 28px;
        min-width: 28px;
        border-radius: 7px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        margin-right: 7px;
        font-size: 13px;
    }

    .electricity-symbol {
        color: #d99a00;
        background: rgba(255, 193, 7, 0.13);
    }

    .steam-symbol {
        color: #0dcaf0;
        background: rgba(13, 202, 240, 0.12);
    }

    .etp-symbol {
        color: #198754;
        background: rgba(25, 135, 84, 0.11);
    }

    .wtp-symbol {
        color: #0d6efd;
        background: rgba(13, 110, 253, 0.10);
    }

    .ac-symbol {
        color: #087990;
        background: rgba(13, 202, 240, 0.12);
    }

    .cost-group .input-group-text {
        font-weight: 600;
        color: #475467;
    }

    .cost-input {
        font-weight: 500;
    }


    /* ========================================================= */
    /* ANALYSIS */
    /* ========================================================= */

    .analysis-box {
        height: 100%;
        padding: 15px;
        border-radius: 11px;
        border: 1px solid #e7eaf0;
        background: #ffffff;
    }

    .production-box {
        background: #f8fffb;
        border-color: #d8f0e3;
    }

    .total-box {
        background: #fff9f9;
        border-color: #f4d7d7;
    }

    .per-unit-box {
        background: #f8faff;
        border-color: #d9e5fb;
    }

    .calculated-field {
        background: #f3f4f6 !important;
        font-weight: 700;
        color: #1f2937;
        cursor: not-allowed;
    }

    .total-symbol {
        background: #dc3545 !important;
        color: white !important;
        border-color: #dc3545 !important;
        font-weight: 700;
    }

    .per-unit-symbol {
        background: #0d6efd !important;
        color: white !important;
        border-color: #0d6efd !important;
        font-weight: 700;
    }

    .calculation-note {
        margin-top: 6px;
        color: #98a2b3;
        font-size: 0.68rem;
    }


    /* ========================================================= */
    /* VALIDATION */
    /* ========================================================= */

    .field-validation {
        display: block;
        color: #dc3545;
        font-size: 0.72rem;
        margin-top: 4px;
    }

    .validation-summary:empty {
        display: none;
    }

    .validation-summary {
        border-radius: 10px;
        font-size: 0.82rem;
    }


    /* ========================================================= */
    /* ACTION */
    /* ========================================================= */

    .action-area {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        gap: 8px;
        padding-top: 3px;
    }

    .action-btn {
        min-height: 40px;
        border-radius: 8px;
        padding-left: 20px;
        padding-right: 20px;
        font-size: 0.84rem;
        white-space: nowrap;
    }

    .save-btn {
        box-shadow: 0 3px 8px rgba(13, 110, 253, 0.18);
    }


    /* ========================================================= */
    /* TABLET */
    /* ========================================================= */

    @@media (max-width: 991.98px) {

        .utility-page {
            padding-left: 12px;
            padding-right: 12px;
        }

        .form-card-body {
            padding: 15px;
        }

        .page-title {
            font-size: 1.2rem;
        }
    }


    /* ========================================================= */
    /* MOBILE */
    /* ========================================================= */

    @@media (max-width: 767.98px) {

        .utility-page {
            padding-left: 8px;
            padding-right: 8px;
            padding-top: 5px;
        }

        .page-header {
            margin-bottom: 12px !important;
        }

        .page-icon {
            width: 38px;
            height: 38px;
            min-width: 38px;
            font-size: 17px;
        }

        .page-title {
            font-size: 1.05rem;
        }

        .page-subtitle {
            font-size: 0.7rem;
        }

        .back-btn {
            width: 100%;
        }

        .form-card {
            border-radius: 11px;
        }

        .form-card-header {
            padding: 12px 13px;
        }

        .form-card-body {
            padding: 13px;
        }

        .section-icon {
            width: 34px;
            height: 34px;
            min-width: 34px;
            font-size: 15px;
        }

        .section-title {
            font-size: 0.88rem;
        }

        .section-description {
            font-size: 0.67rem;
        }

        .utility-box {
            padding: 12px;
        }

        .analysis-box {
            padding: 13px;
        }

        .action-area {
            justify-content: stretch;
        }

        .action-btn {
            flex: 1;
            padding-left: 10px;
            padding-right: 10px;
        }
    }


    /* ========================================================= */
    /* SMALL MOBILE */
    /* ========================================================= */

    @@media (max-width: 399.98px) {

        .page-title {
            font-size: 0.98rem;
        }

        .page-subtitle {
            display: none;
        }

        .form-card-body {
            padding: 11px;
        }

        .form-card-header {
            padding: 11px;
        }

        .custom-label {
            font-size: 0.78rem;
        }

        .form-control,
        .form-select,
        .input-group-text {
            font-size: 0.8rem;
        }

        .action-btn {
            font-size: 0.78rem;
        }
    }


    /* ========================================================= */
    /* WIDE SCREEN */
    /* ========================================================= */

    @@media (min-width: 1600px) {

        .utility-page {
            max-width: 1650px;
        }
    }

</style>


<!-- ============================================================= -->
<!-- JAVASCRIPT -->
<!-- ============================================================= -->
@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>

        $(document).ready(function () {

            // =====================================================
            // CALCULATE TOTAL + PER UNIT COST
            // =====================================================

            function calculateCosts() {

                let totalCost = 0;

                // -------------------------------------------------
                // Utility Costs
                // -------------------------------------------------

                $('.cost-input').each(function () {

                    let value = parseFloat($(this).val());

                    if (!isNaN(value)) {

                        totalCost += value;

                    }

                });


                // -------------------------------------------------
                // Total Cost
                // -------------------------------------------------

                $('#totalCost').val(
                    totalCost.toFixed(2)
                );


                // -------------------------------------------------
                // Production
                // -------------------------------------------------

                let production =
                    parseFloat($('#production').val());


                // -------------------------------------------------
                // Per Unit Cost
                // -------------------------------------------------

                let perUnitCost = 0;

                if (!isNaN(production) &&
                    production > 0) {

                    perUnitCost =
                        totalCost / production;

                }


                $('#perUnitCost').val(
                    perUnitCost.toFixed(4)
                );

            }


            // =====================================================
            // UTILITY COST CHANGE
            // =====================================================

            $('.cost-input').on(
                'input',
                function () {

                    calculateCosts();

                }
            );


            // =====================================================
            // PRODUCTION CHANGE
            // =====================================================

            $('#production').on(
                'input',
                function () {

                    calculateCosts();

                }
            );


            // =====================================================
            // PREVENT NEGATIVE VALUES
            // =====================================================

            $('.cost-input, #production').on(
                'input',
                function () {

                    if (parseFloat($(this).val()) < 0) {

                        $(this).val(0);

                    }

                }
            );


            // =====================================================
            // INITIAL CALCULATION
            // =====================================================

            calculateCosts();

        });

    </script>

}
