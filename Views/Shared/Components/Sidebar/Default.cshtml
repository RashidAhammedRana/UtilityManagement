@model List<UtilityManagement.ViewModels.SidebarViewModel>

<style>

    /* =========================================================
           SIDEBAR
        ========================================================== */

    .sidebar {
        width: 250px;
        height: 100vh;
        height: 100dvh;
        position: fixed;
        top: 0;
        left: 0;
        background: #212529;
        display: flex;
        flex-direction: column;
        z-index: 1051;
        overflow: hidden;
    }


    /* =========================================================
           BRAND
        ========================================================== */

    .brand {
        text-align: center;
        padding: 15px;
        color: white;
        border-bottom: 1px solid #444;
        flex: 0 0 auto;
    }

        .brand img {
            width: 160px;
            height: 40px;
            object-fit: fill;
            max-width: 100%;
        }

    .brand-title {
        margin-top: 6px;
        font-weight: 600;
        font-size: 15px;
    }


    /* =========================================================
           MENU CONTAINER
        ========================================================== */

    .menu-container {
        flex: 1 1 auto;
        min-height: 0;
        overflow-y: auto;
        overflow-x: hidden;
    }

        .menu-container::-webkit-scrollbar {
            width: 5px;
        }

        .menu-container::-webkit-scrollbar-track {
            background: #212529;
        }

        .menu-container::-webkit-scrollbar-thumb {
            background: #495057;
            border-radius: 10px;
        }


    /* =========================================================
           MODULE HEADER
        ========================================================== */

    .module-header {
        color: #ddd;
        padding: 12px 18px;
        cursor: pointer;
        font-size: 14px;
        font-weight: 600;
        border-bottom: 1px solid #343a40;
        display: flex;
        justify-content: space-between;
        align-items: center;
        transition: background .3s ease, color .3s ease;
    }

        .module-header:hover {
            background: #343a40;
            color: #fff;
        }

        .module-header.active {
            background: #0d6efd;
            color: #fff;
        }


    /* =========================================================
           ARROW
        ========================================================== */

    .module-arrow {
        transition: transform .3s ease;
    }

    .module-header.active .module-arrow {
        transform: rotate(90deg);
    }


    /* =========================================================
           MODULE MENU
        ========================================================== */

    .module-menu {
        display: none;
        background: #2b3035;
    }

        .module-menu.show {
            display: block;
        }


    /* =========================================================
           MENU LINK
        ========================================================== */

    .menu-link {
        display: block;
        color: #ddd;
        padding: 10px 35px;
        text-decoration: none;
        font-size: 14px;
        transition: background .3s ease, color .3s ease;
    }

        .menu-link:hover {
            background: #495057;
            color: #fff;
        }

    .menu-icon {
        margin-right: 8px;
    }


    /* =========================================================
           LOGOUT
        ========================================================== */

    .logout-section {
        width: 100%;
        background: #212529;
        border-top: 1px solid #444;
        flex: 0 0 auto;
        display: block;
        position: relative;
        z-index: 2000;
    }

        .logout-section form {
            width: 100%;
            margin: 0;
            padding: 0;
        }

    .logout-btn {
        display: flex;
        align-items: center;
        width: 100%;
        height: 54px;
        min-height: 54px;
        padding: 14px 20px;
        background: #212529;
        color: #dc3545;
        border: none;
        outline: none;
        font-weight: 500;
        font-size: 14px;
        text-align: left;
        cursor: pointer;
    }

        .logout-btn:hover {
            background: #dc3545;
            color: #fff;
        }


    /* =========================================================
           MOBILE

           Mobile device হলে sidebar normal থাকবে।
           Hide/show control হবে _Layout.cshtml থেকে।
        ========================================================== */

    @@media screen and (max-width: 768px), screen and (pointer: coarse) and (hover: none) {

        .sidebar {
            width: 250px;
            height: 100vh;
            height: 100dvh;
            min-height: 100vh;
            min-height: 100dvh;
        }

        .brand {
            padding: 13px 10px;
        }

            .brand img {
                width: 145px;
                height: 36px;
            }

        .brand-title {
            font-size: 14px;
        }

        .module-header {
            padding: 11px 16px;
            font-size: 14px;
        }

        .menu-link {
            padding: 10px 30px;
            font-size: 13px;
        }

        .logout-section {
            display: block !important;
            visibility: visible !important;
            opacity: 1 !important;
            width: 100% !important;
            height: 54px !important;
            min-height: 54px !important;
            max-height: 54px !important;
            flex: 0 0 54px !important;
            overflow: visible !important;
            position: relative !important;
            z-index: 9999 !important;
            background: #212529 !important;
        }

            .logout-section form {
                display: block !important;
                width: 100% !important;
                height: 54px !important;
            }

        .logout-btn {
            display: flex !important;
            visibility: visible !important;
            opacity: 1 !important;
            width: 100% !important;
            height: 54px !important;
            min-height: 54px !important;
            max-height: 54px !important;
            color: #dc3545 !important;
            background: #212529 !important;
        }
    }


    /* =========================================================
           SMALL PORTRAIT
        ========================================================== */

    @@media screen and (max-width: 400px) and (orientation: portrait) {

        .sidebar {
            width: 240px;
        }

        .brand {
            padding: 10px 8px;
        }

            .brand img {
                width: 130px;
                height: 33px;
            }

        .brand-title {
            font-size: 13px;
        }

        .module-header {
            padding: 9px 14px;
            font-size: 13px;
        }

        .menu-link {
            padding: 8px 26px;
            font-size: 12px;
        }

        .logout-section {
            height: 52px !important;
            min-height: 52px !important;
            max-height: 52px !important;
            flex: 0 0 52px !important;
        }

            .logout-section form {
                height: 52px !important;
            }

        .logout-btn {
            height: 52px !important;
            min-height: 52px !important;
            max-height: 52px !important;
            padding: 12px 17px !important;
            font-size: 13px !important;
        }
    }


    /* =========================================================
           MOBILE LANDSCAPE

           Width 768px এর বেশি হলেও touch mobile device হলে
           এই styling কাজ করবে।
        ========================================================== */

    @@media screen and (orientation: landscape) and (pointer: coarse) and (hover: none) {

        .sidebar {
            width: 240px;
            height: 100vh;
            height: 100dvh;
            min-height: 100vh;
            min-height: 100dvh;
        }

        .brand {
            padding: 7px 10px;
        }

            .brand img {
                width: 125px;
                height: 30px;
            }

        .brand-title {
            margin-top: 3px;
            font-size: 12px;
        }

        .module-header {
            padding: 8px 15px;
            font-size: 13px;
        }

        .menu-link {
            padding: 7px 27px;
            font-size: 12px;
        }

        .logout-section {
            height: 46px !important;
            min-height: 46px !important;
            max-height: 46px !important;
            flex: 0 0 46px !important;
        }

            .logout-section form {
                height: 46px !important;
            }

        .logout-btn {
            height: 46px !important;
            min-height: 46px !important;
            max-height: 46px !important;
            padding: 10px 18px !important;
            font-size: 13px !important;
        }
    }


    /* =========================================================
           VERY SHORT LANDSCAPE
        ========================================================== */

    @@media screen and (orientation: landscape) and (pointer: coarse) and (hover: none) and (max-height: 380px) {

        .sidebar {
            width: 235px;
        }

        .brand {
            padding: 5px 8px;
        }

            .brand img {
                width: 115px;
                height: 27px;
            }

        .brand-title {
            font-size: 11px;
            margin-top: 2px;
        }

        .module-header {
            padding: 6px 13px;
            font-size: 12px;
        }

        .menu-link {
            padding: 6px 24px;
            font-size: 11px;
        }

        .logout-section {
            height: 42px !important;
            min-height: 42px !important;
            max-height: 42px !important;
            flex: 0 0 42px !important;
        }

            .logout-section form {
                height: 42px !important;
            }

        .logout-btn {
            height: 42px !important;
            min-height: 42px !important;
            max-height: 42px !important;
            padding: 8px 15px !important;
            font-size: 12px !important;
        }
    }

</style>


<!-- =========================================================
     SIDEBAR
========================================================== -->

<div class="sidebar"
     id="sidebar">


    <!-- =====================================================
         BRAND
    ====================================================== -->

    <div class="brand">

        <img src="@Url.Content("~/images/cotton_logo.png")"
             alt="Cotton Club BD Ltd" />

        <div class="brand-title">
            Utility Management
        </div>

    </div>


    <!-- =====================================================
         MENU
    ====================================================== -->

    <div class="menu-container">

        @{
            int i = 0;
        }

        @foreach (var module in Model.GroupBy(x => x.ModuleName))
        {
            var id = "module_" + i;

            <div class="module-header"
                 onclick="toggleModule('@id', this)">

                <span>
                    @module.Key
                </span>

                <i class="bi bi-chevron-right module-arrow"></i>

            </div>


            <div id="@id"
                 class="module-menu">

                @foreach (var menu in module)
                {
                    <a class="menu-link"
                       href="@Url.Content(menu.Url)">

                        <i class="bi bi-chevron-right menu-icon"></i>

                        @menu.MenuName

                    </a>
                }

            </div>

            i++;
        }

    </div>


    <!-- =====================================================
         LOGOUT
    ====================================================== -->
    @if (User.Identity?.IsAuthenticated == true)
    {
        <div class="logout-section">

            <form method="post"
                  asp-controller="Account"
                  asp-action="Logout">

                <button type="submit"
                        class="logout-btn">

                    <i class="bi bi-box-arrow-right menu-icon"></i>

                    <span>
                        Logout
                    </span>

                </button>

            </form>

        </div>
    }

</div>


<script>

    function toggleModule(id, element) {

        const menus =
            document.querySelectorAll(".module-menu");

        const headers =
            document.querySelectorAll(".module-header");

        const currentMenu =
            document.getElementById(id);


        if (!currentMenu) {
            return;
        }


        const isOpen =
            currentMenu.classList.contains("show");


        menus.forEach(function (menu) {

            menu.classList.remove("show");

        });


        headers.forEach(function (header) {

            header.classList.remove("active");

        });


        if (!isOpen) {

            currentMenu.classList.add("show");

            element.classList.add("active");

        }

    }

</script>
