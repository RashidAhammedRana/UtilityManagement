<!DOCTYPE html>
<html>

<head>

    <meta name="viewport"
          content="width=device-width, initial-scale=1" />

    <title>@ViewBag.Title</title>


    <!-- =====================================================
         jQuery
    ====================================================== -->

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>


    <!-- =====================================================
         Bootstrap
    ====================================================== -->

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
          rel="stylesheet">


    <!-- =====================================================
         DevExpress WebDocumentViewer
    ====================================================== -->

    <link rel="stylesheet"
          href="~/css/thirdparty.bundle.css" />

    <script src="~/js/thirdparty.bundle.js"></script>


    <!-- =====================================================
         Bootstrap Icons
    ====================================================== -->

    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
          rel="stylesheet">


    <!-- =====================================================
         Toastr
    ====================================================== -->

    <link href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css"
          rel="stylesheet" />

    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>


    <style>

        /* =====================================================
                   GLOBAL
                ====================================================== */

        *,
        *::before,
        *::after {
            box-sizing: border-box;
        }


        html,
        body {
            width: 100%;
            min-width: 0;
            margin: 0;
            padding: 0;
            overflow-x: hidden;
        }


        body {
            background: #f4f6f9;
        }


        /* =====================================================
                   SIDEBAR
                ====================================================== */

        .sidebar-wrapper {
            width: 250px;
            height: 100vh;
            height: 100dvh;
            position: fixed;
            top: 0;
            left: 0;
            z-index: 1050;
            transform: translateX(0);
            transition: transform 0.3s ease;
            overflow: visible;
        }


            .sidebar-wrapper.hidden {
                transform: translateX(-250px) !important;
            }


        /* =====================================================
                   MAIN CONTENT - DESKTOP
                ====================================================== */

        .main-content {
            width: calc(100% - 250px);
            min-height: 100vh;
            margin-left: 250px;
            padding: 20px;
            box-sizing: border-box;
            transition: margin-left 0.3s ease, width 0.3s ease;
        }


            .main-content.full {
                width: 100% !important;
                margin-left: 0 !important;
            }


        /* =====================================================
                   TOGGLE BUTTON
                ====================================================== */

        .toggle-btn {
            position: fixed;
            top: 4px;
            left: 0;
            width: 30px;
            height: 30px;
            margin: 0;
            padding: 0;
            display: flex;
            justify-content: center;
            align-items: center;
            background: transparent;
            border: none;
            color: #0d6efd;
            font-size: 19px;
            line-height: 1;
            cursor: pointer;
            z-index: 11000;
        }


            .toggle-btn:hover {
                background: transparent;
                color: #0b5ed7;
            }


            .toggle-btn:focus,
            .toggle-btn:active {
                outline: none !important;
                box-shadow: none !important;
            }


            .toggle-btn i {
                pointer-events: none;
                line-height: 1;
            }


        /* =====================================================
                   READONLY INPUT
                ====================================================== */

        input[readonly] {
            background-color: #e9ecef !important;
            color: #495057 !important;
            border: 1px solid #ced4da !important;
            cursor: not-allowed;
        }


            input[readonly]:focus {
                outline: none !important;
                box-shadow: none !important;
            }


        /* =====================================================
                   MOBILE
                   Portrait
                ====================================================== */

        @@media screen and (max-width: 768px), screen and (pointer: coarse) and (hover: none) {

            .sidebar-wrapper {
                width: 250px;
                height: 100vh;
                height: 100dvh;
                top: 0;
                left: 0;
                transform: translateX(-250px) !important;
                z-index: 1050;
            }


                .sidebar-wrapper.mobile-open {
                    transform: translateX(0) !important;
                }
            /* -----------------------------------------------
                       MOBILE MAIN CONTENT

                       Very small top gap
                    ------------------------------------------------ */

            .main-content {
                width: 100% !important;
                min-height: 100vh;
                margin-left: 0 !important;
                padding: 15px 10px 10px 10px !important;
                box-sizing: border-box;
                transition: none;
            }


                .main-content.full {
                    width: 100% !important;
                    margin-left: 0 !important;
                }
            /* -----------------------------------------------
                       TOGGLE
                    ------------------------------------------------ */

            .toggle-btn {
                top: 2px;
                left: 0;
                width: 27px;
                height: 27px;
                font-size: 17px;
            }
        }


        /* =====================================================
                   SMALL MOBILE
                ====================================================== */

        @@media screen and (max-width: 400px) {

            .sidebar-wrapper {
                width: 240px;
                transform: translateX(-240px) !important;
            }


                .sidebar-wrapper.mobile-open {
                    transform: translateX(0) !important;
                }


            .main-content {
                padding: 13px 7px 7px 7px !important;
            }


            .toggle-btn {
                top: 1px;
                left: 0;
                width: 25px;
                height: 25px;
                font-size: 16px;
            }
        }


        /* =====================================================
                   MOBILE LANDSCAPE

                   IMPORTANT:
                   Toggle button height ≈ 25px

                   Main content starts with ONLY 10px
                   top padding.

                   Delete page will therefore appear
                   very close to toggle button.

                   No negative top required.
                ====================================================== */

        @@media screen and (max-width: 768px) and (orientation: landscape) {

            .sidebar-wrapper {
                width: 240px;
                height: 100vh;
                height: 100dvh;
                position: fixed;
                top: 0;
                left: 0;
                transform: translateX(-240px) !important;
                z-index: 1050;
            }


                .sidebar-wrapper.mobile-open {
                    transform: translateX(0) !important;
                }
            /* =================================================
                       MAIN CONTENT

                       BEFORE:
                       padding-top: 22px

                       NOW:
                       padding-top: 10px

                       This is the main gap reduction.
                    ================================================== */

            .main-content {
                width: 100% !important;
                min-height: 100vh;
                margin-left: 0 !important;
                padding: 10px 8px 4px 8px !important;
                box-sizing: border-box;
                transition: none;
            }


                .main-content.full {
                    width: 100% !important;
                    margin-left: 0 !important;
                }
            /* =================================================
                       TOGGLE BUTTON
                    ================================================== */

            .toggle-btn {
                top: 0;
                left: 0;
                width: 25px;
                height: 25px;
                font-size: 16px;
            }
        }


        /* =====================================================
                   SHORT LANDSCAPE

                   max-height: 380px
                ====================================================== */

        @@media screen and (max-width: 768px) and (orientation: landscape) and (max-height: 380px) {

            .sidebar-wrapper {
                width: 235px;
                height: 100vh;
                height: 100dvh;
                transform: translateX(-235px) !important;
            }


                .sidebar-wrapper.mobile-open {
                    transform: translateX(0) !important;
                }


            .main-content {
                width: 100% !important;
                min-height: 100vh;
                margin-left: 0 !important;
                /*
                           ONLY 10px TOP SPACE
                        */

                padding: 10px 6px 3px 6px !important;
                box-sizing: border-box;
            }


            .toggle-btn {
                top: 0;
                left: 0;
                width: 24px;
                height: 24px;
                font-size: 15px;
            }
        }


        /* =====================================================
                   EXTREMELY SHORT LANDSCAPE

                   max-height: 320px
                ====================================================== */

        @@media screen and (max-width: 768px) and (orientation: landscape) and (max-height: 320px) {

            .sidebar-wrapper {
                width: 230px;
                height: 100vh;
                height: 100dvh;
                transform: translateX(-230px) !important;
            }


                .sidebar-wrapper.mobile-open {
                    transform: translateX(0) !important;
                }


            .main-content {
                width: 100% !important;
                min-height: 100vh;
                margin-left: 0 !important;
                /*
                           STILL 10px
                        */

                padding: 10px 5px 2px 5px !important;
                box-sizing: border-box;
            }


            .toggle-btn {
                top: 0;
                left: 0;
                width: 23px;
                height: 23px;
                font-size: 14px;
            }
        }


        /* =====================================================
                   TABLET
                ====================================================== */

        @@media screen and (min-width: 769px) and (max-width: 1199px) {

            .main-content {
                padding: 18px;
            }
        }


        /* =====================================================
                   TOUCH DEVICE
                ====================================================== */

        @@media screen and (pointer: coarse) and (hover: none) {

            .toggle-btn {
                touch-action: manipulation;
            }


            .main-content {
                box-sizing: border-box;
            }
        }


        /* =====================================================
                   MOBILE BODY SAFETY
                ====================================================== */

        @@media screen and (max-width: 768px) {

            html,
            body {
                width: 100%;
                max-width: 100%;
                margin: 0 !important;
                padding: 0 !important;
                overflow-x: hidden !important;
            }
        }

    </style>

</head>


<body>


    <!-- =====================================================
         TOGGLE BUTTON
    ====================================================== -->

    <button id="sidebarToggle"
            class="toggle-btn"
            type="button"
            aria-label="Toggle Sidebar"
            aria-controls="sidebarWrapper"
            aria-expanded="false">

        <i class="bi bi-list"></i>

    </button>


    <!-- =====================================================
         SIDEBAR
    ====================================================== -->

    <div id="sidebarWrapper"
         class="sidebar-wrapper">

        @await Component.InvokeAsync("Sidebar")

    </div>


    <!-- =====================================================
         MAIN CONTENT
    ====================================================== -->

    <main id="mainContent"
          class="main-content">

        @RenderBody()

    </main>


    <!-- =====================================================
         BOOTSTRAP JS
    ====================================================== -->

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js">
    </script>


    <!-- =====================================================
         SIDEBAR SCRIPT
    ====================================================== -->

    <script>

        document.addEventListener(
            "DOMContentLoaded",
            function () {

                const sidebar =
                    document.getElementById(
                        "sidebarWrapper"
                    );

                const mainContent =
                    document.getElementById(
                        "mainContent"
                    );

                const toggleButton =
                    document.getElementById(
                        "sidebarToggle"
                    );


                if (!sidebar || !toggleButton) {
                    return;
                }


                /* =================================================
                   MOBILE DETECTION
                ================================================== */

                function isMobileDevice() {

                    const smallScreen =
                        window.matchMedia(
                            "(max-width: 768px)"
                        ).matches;


                    const touchDevice =
                        navigator.maxTouchPoints > 0;


                    const coarsePointer =
                        window.matchMedia(
                            "(pointer: coarse)"
                        ).matches;


                    const noHover =
                        window.matchMedia(
                            "(hover: none)"
                        ).matches;


                    return (
                        smallScreen ||
                        (
                            touchDevice &&
                            coarsePointer &&
                            noHover
                        )
                    );
                }


                /* =================================================
                   CLOSE MOBILE SIDEBAR
                ================================================== */

                function closeMobileSidebar() {

                    sidebar.classList.remove(
                        "mobile-open"
                    );

                    sidebar.classList.add(
                        "hidden"
                    );


                    toggleButton.setAttribute(
                        "aria-expanded",
                        "false"
                    );


                    if (mainContent) {

                        mainContent.classList.add(
                            "full"
                        );
                    }
                }


                /* =================================================
                   OPEN MOBILE SIDEBAR
                ================================================== */

                function openMobileSidebar() {

                    sidebar.classList.remove(
                        "hidden"
                    );

                    sidebar.classList.add(
                        "mobile-open"
                    );


                    toggleButton.setAttribute(
                        "aria-expanded",
                        "true"
                    );


                    if (mainContent) {

                        mainContent.classList.add(
                            "full"
                        );
                    }
                }


                /* =================================================
                   DESKTOP STATE
                ================================================== */

                function setDesktopState() {

                    sidebar.classList.remove(
                        "hidden"
                    );

                    sidebar.classList.remove(
                        "mobile-open"
                    );


                    toggleButton.setAttribute(
                        "aria-expanded",
                        "true"
                    );


                    if (mainContent) {

                        mainContent.classList.remove(
                            "full"
                        );
                    }
                }


                /* =================================================
                   INITIALIZE
                ================================================== */

                function initializeSidebar() {

                    if (isMobileDevice()) {

                        closeMobileSidebar();

                    }
                    else {

                        setDesktopState();

                    }
                }


                /* =================================================
                   TOGGLE
                ================================================== */

                toggleButton.addEventListener(
                    "click",
                    function () {

                        if (isMobileDevice()) {

                            const isOpen =
                                sidebar.classList.contains(
                                    "mobile-open"
                                );


                            if (isOpen) {

                                closeMobileSidebar();

                            }
                            else {

                                openMobileSidebar();

                            }

                        }
                        else {

                            const isHidden =
                                sidebar.classList.contains(
                                    "hidden"
                                );


                            if (isHidden) {

                                sidebar.classList.remove(
                                    "hidden"
                                );


                                if (mainContent) {

                                    mainContent.classList.remove(
                                        "full"
                                    );
                                }


                                toggleButton.setAttribute(
                                    "aria-expanded",
                                    "true"
                                );

                            }
                            else {

                                sidebar.classList.add(
                                    "hidden"
                                );


                                if (mainContent) {

                                    mainContent.classList.add(
                                        "full"
                                    );
                                }


                                toggleButton.setAttribute(
                                    "aria-expanded",
                                    "false"
                                );
                            }
                        }
                    }
                );


                /* =================================================
                   RESIZE
                ================================================== */

                let previousMobileState =
                    isMobileDevice();


                let resizeTimer = null;


                window.addEventListener(
                    "resize",
                    function () {

                        clearTimeout(
                            resizeTimer
                        );


                        resizeTimer =
                            setTimeout(
                                function () {

                                    const currentMobileState =
                                        isMobileDevice();


                                    if (
                                        currentMobileState !==
                                        previousMobileState
                                    ) {

                                        if (
                                            currentMobileState
                                        ) {

                                            closeMobileSidebar();

                                        }
                                        else {

                                            setDesktopState();

                                        }


                                        previousMobileState =
                                            currentMobileState;

                                    }
                                    else if (
                                        currentMobileState
                                    ) {

                                        closeMobileSidebar();

                                    }

                                },
                                100
                            );
                    }
                );


                /* =================================================
                   ORIENTATION CHANGE
                ================================================== */

                window.addEventListener(
                    "orientationchange",
                    function () {

                        setTimeout(
                            function () {

                                if (
                                    isMobileDevice()
                                ) {

                                    closeMobileSidebar();

                                }

                            },
                            100
                        );

                    }
                );


                /* =================================================
                   INITIALIZE ON LOAD
                ================================================== */

                initializeSidebar();

            }
        );


        /* =====================================================
           TOASTR
        ====================================================== */

        $(document).ready(function () {

            var successMessage =
                '@(TempData["SuccessMessage"] ?? "")';


            var errorMessage =
                '@(TempData["ErrorMessage"] ?? "")';


            toastr.options = {

                closeButton: true,

                progressBar: true,

                positionClass:
                    "toast-top-right",

                timeOut: 1000

            };


            if (
                successMessage.trim().length > 0
            ) {

                toastr.success(
                    successMessage,
                    "Success"
                );
            }


            if (
                errorMessage.trim().length > 0
            ) {

                toastr.error(
                    errorMessage,
                    "Error"
                );
            }

        });

    </script>


    @RenderSection(
    "Scripts",
        required: false
        )

</body>

</html>
