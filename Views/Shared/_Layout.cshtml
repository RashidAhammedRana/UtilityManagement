<!DOCTYPE html>
<html>

<head>

    <meta name="viewport"
          content="width=device-width, initial-scale=1" />

    <title>@ViewBag.Title</title>


    <!-- =====================================================
         jQuery
    ====================================================== -->

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>


    <!-- =====================================================
         Bootstrap
    ====================================================== -->

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
          rel="stylesheet">


    <!-- =====================================================
         DevExpress WebDocumentViewer
    ====================================================== -->

    <link rel="stylesheet"
          href="~/css/thirdparty.bundle.css" />

    <script src="~/js/thirdparty.bundle.js"></script>


    <!-- =====================================================
         Bootstrap Icons
    ====================================================== -->

    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
          rel="stylesheet">


    <!-- =====================================================
         Toastr
    ====================================================== -->

    <link href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css"
          rel="stylesheet" />

    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>


    <!-- =====================================================
         SITE CSS
    ====================================================== -->

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />


    <!-- =====================================================
         COMMON FORM RESPONSIVE CSS
         সব Create / Edit / Delete form-এর common responsive
    ====================================================== -->

    <link rel="stylesheet"
          href="~/css/form-responsive.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/list-responsive.css"
          asp-append-version="true" />
    <!-- =====================================================
         PAGE-SPECIFIC CSS
         Create / Edit / Delete page চাইলে নিচের section
         দিয়ে নিজের CSS load করবে
    ====================================================== -->
    @RenderSection("Styles", required: false)


    <!-- =====================================================
         LAYOUT-SPECIFIC CSS
    ====================================================== -->

    <style>

        /* =====================================================
               GLOBAL
            ====================================================== */

        *,
        *::before,
        *::after {
            box-sizing: border-box;
        }


        html,
        body {
            width: 100%;
            max-width: 100%;
            min-width: 0;
            margin: 0;
            padding: 0;
            overflow-x: hidden !important;
        }


        body {
            background: #f4f6f9;
        }


        /* =====================================================
               SIDEBAR
            ====================================================== */

        .sidebar-wrapper {
            width: 250px;
            height: 100vh;
            height: 100dvh;
            position: fixed;
            top: 0;
            left: 0;
            z-index: 1050;
            transform: translateX(0);
            transition: transform 0.3s ease;
            overflow: visible;
        }


            .sidebar-wrapper.hidden {
                transform: translateX(-250px) !important;
            }


        /* =====================================================
               MAIN CONTENT - DESKTOP
            ====================================================== */

        .main-content {
            width: calc(100% - 250px);
            min-height: 100vh;
            margin-left: 250px;
            padding: 20px;
            box-sizing: border-box;
            transition: margin-left 0.3s ease, width 0.3s ease;
            min-width: 0;
            overflow-x: hidden;
        }


            .main-content.full {
                width: 100% !important;
                margin-left: 0 !important;
            }


        /* =====================================================
               TOGGLE BUTTON
            ====================================================== */

        .toggle-btn {
            position: fixed;
            top: 4px;
            left: 0;
            width: 30px;
            height: 30px;
            margin: 0;
            padding: 0;
            display: flex;
            justify-content: center;
            align-items: center;
            background: transparent;
            border: none;
            color: #0d6efd;
            font-size: 19px;
            line-height: 1;
            cursor: pointer;
            z-index: 11000;
        }


            .toggle-btn:hover {
                background: transparent;
                color: #0b5ed7;
            }


            .toggle-btn:focus,
            .toggle-btn:active {
                outline: none !important;
                box-shadow: none !important;
            }


            .toggle-btn i {
                pointer-events: none;
                line-height: 1;
            }


        /* =====================================================
               READONLY
            ====================================================== */

        input[readonly] {
            background-color: #e9ecef !important;
            color: #495057 !important;
            border: 1px solid #ced4da !important;
            cursor: not-allowed;
        }


            input[readonly]:focus {
                outline: none !important;
                box-shadow: none !important;
            }


        /* =====================================================
               TABLET
            ====================================================== */

        @@media screen and (max-width: 991.98px) {
            .main-content

        {
            width: calc(100% - 250px);
            margin-left: 250px;
            padding: 15px;
        }

        }


        /* =====================================================
               MOBILE PORTRAIT + LANDSCAPE
               IMPORTANT
            ====================================================== */

        @@media screen and (max-width: 768px) {
            html, body

        {
            width: 100% !important;
            max-width: 100% !important;
            min-width: 0 !important;
            overflow-x: hidden !important;
        }


        /* -------------------------------------------------
                   SIDEBAR
                ------------------------------------------------- */

        .sidebar-wrapper {
            width: 250px !important;
            max-width: 85vw;
            transform: translateX(-250px);
            box-shadow: 4px 0 15px rgba(0, 0, 0, 0.15);
        }


            .sidebar-wrapper.hidden {
                transform: translateX(-250px) !important;
            }


            .sidebar-wrapper.mobile-open {
                transform: translateX(0) !important;
            }


        /* -------------------------------------------------
                   MAIN CONTENT

                   THIS FIXES YOUR SCREENSHOT
                ------------------------------------------------- */

        .main-content {
            display: block;
            width: 100% !important;
            max-width: 100% !important;
            min-width: 0 !important;
            margin-left: 0 !important;
            padding: 10px !important;
            overflow-x: hidden !important;
        }


            .main-content.full {
                width: 100% !important;
                max-width: 100% !important;
                margin-left: 0 !important;
            }


        /* -------------------------------------------------
                   TOGGLE
                ------------------------------------------------- */

        .toggle-btn {
            top: 5px;
            left: 3px;
            width: 30px;
            height: 30px;
            font-size: 18px;
        }

        }


        /* =====================================================
               MOBILE PORTRAIT
            ====================================================== */

        @@media screen and (max-width: 768px)
        and (orientation: portrait) {
            .main-content

        {
            width: 100vw !important;
            max-width: 100vw !important;
            margin-left: 0 !important;
            padding: 8px !important;
            overflow-x: hidden !important;
        }


        /*
                   Prevent Bootstrap .row negative margin
                   from creating horizontal overflow.
                */

        .main-content > .row {
            width: 100% !important;
            max-width: 100% !important;
            margin-left: 0 !important;
            margin-right: 0 !important;
        }


            .main-content > .row > [class*="col-"] {
                width: 100% !important;
                max-width: 100% !important;
                padding-left: 0 !important;
                padding-right: 0 !important;
            }

        }


        /* =====================================================
               MOBILE LANDSCAPE
            ====================================================== */

        @@media screen and (max-width: 768px)
        and (orientation: landscape) {
            .main-content

        {
            width: 100vw !important;
            max-width: 100vw !important;
            margin-left: 0 !important;
            padding: 8px !important;
            overflow-x: hidden !important;
        }


        .main-content > .row {
            width: 100% !important;
            max-width: 100% !important;
            margin-left: 0 !important;
            margin-right: 0 !important;
        }


            .main-content > .row > [class*="col-"] {
                width: 100% !important;
                max-width: 100% !important;
                padding-left: 0 !important;
                padding-right: 0 !important;
            }

        }


        /* =====================================================
               VERY SMALL PHONE
            ====================================================== */

        @@media screen and (max-width: 380px) {
            .main-content

        {
            padding: 6px !important;
        }

        }
    </style>


</head>


<body>


    <!-- =====================================================
         TOGGLE BUTTON
    ====================================================== -->

    <button id="sidebarToggle"
            class="toggle-btn"
            type="button"
            aria-label="Toggle Sidebar"
            aria-controls="sidebarWrapper"
            aria-expanded="false">

        <i class="bi bi-list"></i>

    </button>


    <!-- =====================================================
         SIDEBAR
    ====================================================== -->

    <div id="sidebarWrapper"
         class="sidebar-wrapper">

        @await Component.InvokeAsync("Sidebar")

    </div>


    <!-- =====================================================
         MAIN CONTENT
    ====================================================== -->

    <main id="mainContent"
          class="main-content">

        @RenderBody()

    </main>


    <!-- =====================================================
         BOOTSTRAP JS
    ====================================================== -->

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js">
    </script>


    <!-- =====================================================
         SIDEBAR SCRIPT
    ====================================================== -->

    <script>

        document.addEventListener(
            "DOMContentLoaded",
            function () {

                const sidebar =
                    document.getElementById(
                        "sidebarWrapper"
                    );

                const mainContent =
                    document.getElementById(
                        "mainContent"
                    );

                const toggleButton =
                    document.getElementById(
                        "sidebarToggle"
                    );


                if (!sidebar || !toggleButton) {
                    return;
                }


                /* =================================================
                   MOBILE DETECTION
                ================================================== */

                function isMobileDevice() {

                    const smallScreen =
                        window.matchMedia(
                            "(max-width: 768px)"
                        ).matches;


                    const touchDevice =
                        navigator.maxTouchPoints > 0;


                    const coarsePointer =
                        window.matchMedia(
                            "(pointer: coarse)"
                        ).matches;


                    const noHover =
                        window.matchMedia(
                            "(hover: none)"
                        ).matches;


                    return (
                        smallScreen ||
                        (
                            touchDevice &&
                            coarsePointer &&
                            noHover
                        )
                    );
                }


                /* =================================================
                   CLOSE MOBILE SIDEBAR
                ================================================== */

                function closeMobileSidebar() {

                    sidebar.classList.remove(
                        "mobile-open"
                    );

                    sidebar.classList.add(
                        "hidden"
                    );


                    toggleButton.setAttribute(
                        "aria-expanded",
                        "false"
                    );


                    if (mainContent) {

                        mainContent.classList.add(
                            "full"
                        );
                    }
                }


                /* =================================================
                   OPEN MOBILE SIDEBAR
                ================================================== */

                function openMobileSidebar() {

                    sidebar.classList.remove(
                        "hidden"
                    );

                    sidebar.classList.add(
                        "mobile-open"
                    );


                    toggleButton.setAttribute(
                        "aria-expanded",
                        "true"
                    );


                    if (mainContent) {

                        mainContent.classList.add(
                            "full"
                        );
                    }
                }


                /* =================================================
                   DESKTOP STATE
                ================================================== */

                function setDesktopState() {

                    sidebar.classList.remove(
                        "hidden"
                    );

                    sidebar.classList.remove(
                        "mobile-open"
                    );


                    toggleButton.setAttribute(
                        "aria-expanded",
                        "true"
                    );


                    if (mainContent) {

                        mainContent.classList.remove(
                            "full"
                        );
                    }
                }


                /* =================================================
                   INITIALIZE
                ================================================== */

                function initializeSidebar() {

                    if (isMobileDevice()) {

                        closeMobileSidebar();

                    }
                    else {

                        setDesktopState();

                    }
                }


                /* =================================================
                   TOGGLE
                ================================================== */

                toggleButton.addEventListener(
                    "click",
                    function () {

                        if (isMobileDevice()) {

                            const isOpen =
                                sidebar.classList.contains(
                                    "mobile-open"
                                );


                            if (isOpen) {

                                closeMobileSidebar();

                            }
                            else {

                                openMobileSidebar();

                            }

                        }
                        else {

                            const isHidden =
                                sidebar.classList.contains(
                                    "hidden"
                                );


                            if (isHidden) {

                                sidebar.classList.remove(
                                    "hidden"
                                );


                                if (mainContent) {

                                    mainContent.classList.remove(
                                        "full"
                                    );
                                }


                                toggleButton.setAttribute(
                                    "aria-expanded",
                                    "true"
                                );

                            }
                            else {

                                sidebar.classList.add(
                                    "hidden"
                                );


                                if (mainContent) {

                                    mainContent.classList.add(
                                        "full"
                                    );
                                }


                                toggleButton.setAttribute(
                                    "aria-expanded",
                                    "false"
                                );
                            }
                        }
                    }
                );


                /* =================================================
                   RESIZE
                ================================================== */

                let previousMobileState =
                    isMobileDevice();


                let resizeTimer = null;


                window.addEventListener(
                    "resize",
                    function () {

                        clearTimeout(
                            resizeTimer
                        );


                        resizeTimer =
                            setTimeout(
                                function () {

                                    const currentMobileState =
                                        isMobileDevice();


                                    if (
                                        currentMobileState !==
                                        previousMobileState
                                    ) {

                                        if (
                                            currentMobileState
                                        ) {

                                            closeMobileSidebar();

                                        }
                                        else {

                                            setDesktopState();

                                        }


                                        previousMobileState =
                                            currentMobileState;

                                    }
                                    else if (
                                        currentMobileState
                                    ) {

                                        closeMobileSidebar();

                                    }

                                },
                                100
                            );
                    }
                );


                /* =================================================
                   ORIENTATION CHANGE
                ================================================== */

                window.addEventListener(
                    "orientationchange",
                    function () {

                        setTimeout(
                            function () {

                                if (
                                    isMobileDevice()
                                ) {

                                    closeMobileSidebar();

                                }

                            },
                            100
                        );

                    }
                );


                /* =================================================
                   INITIALIZE ON LOAD
                ================================================== */

                initializeSidebar();

            }
        );


        /* =====================================================
           TOASTR
        ====================================================== */

        $(document).ready(function () {

            var successMessage =
                '@(TempData["SuccessMessage"] ?? "")';


            var errorMessage =
                '@(TempData["ErrorMessage"] ?? "")';


            toastr.options = {

                closeButton: true,

                progressBar: true,

                positionClass:
                    "toast-top-right",

                timeOut: 1000

            };


            if (
                successMessage.trim().length > 0
            ) {

                toastr.success(
                    successMessage,
                    "Success"
                );
            }


            if (
                errorMessage.trim().length > 0
            ) {

                toastr.error(
                    errorMessage,
                    "Error"
                );
            }

        });

    </script>


    @RenderSection(
    "Scripts",
        required: false
        )

</body>

</html>
