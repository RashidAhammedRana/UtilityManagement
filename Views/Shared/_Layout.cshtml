<!DOCTYPE html>
<html>

<head>

    <meta name="viewport"
          content="width=device-width, initial-scale=1" />

    <title>@ViewBag.Title</title>


    <!-- =====================================================
         jQuery
    ====================================================== -->

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>


    <!-- =====================================================
         Bootstrap
    ====================================================== -->

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
          rel="stylesheet">


    <!-- =====================================================
         DevExpress WebDocumentViewer
    ====================================================== -->

    <link rel="stylesheet"
          href="~/css/thirdparty.bundle.css" />

    <script src="~/js/thirdparty.bundle.js"></script>


    <!-- =====================================================
         Bootstrap Icons
    ====================================================== -->

    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
          rel="stylesheet">


    <!-- =====================================================
         Toastr
    ====================================================== -->

    <link href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css"
          rel="stylesheet" />

    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js">
    </script>


    <style>

        /* =====================================================
                   GLOBAL
                ====================================================== */

        html,
        body {
            margin: 0;
            padding: 0;
            width: 100%;
            min-height: 100%;
        }

        body {
            background: #f4f6f9;
            overflow-x: hidden;
        }


        /* =====================================================
                   SIDEBAR WRAPPER
                ====================================================== */

        .sidebar-wrapper {
            width: 250px;
            height: 100vh;
            height: 100dvh;
            position: fixed;
            top: 0;
            left: 0;
            z-index: 1050;
            transform: translateX(0);
            transition: transform 0.3s ease;
            overflow: visible;
        }


            /* =====================================================
                   HIDDEN
                ====================================================== */

            .sidebar-wrapper.hidden {
                transform: translateX(-250px) !important;
            }


        /* =====================================================
                   MAIN CONTENT
                ====================================================== */

        .main-content {
            margin-left: 250px;
            width: calc(100% - 250px);
            min-height: 100vh;
            padding: 20px;
            transition: margin-left 0.3s ease, width 0.3s ease;
        }

            .main-content.full {
                margin-left: 0 !important;
                width: 100% !important;
            }


        /* =====================================================
                   TOGGLE BUTTON
                ====================================================== */

        .toggle-btn {
            position: fixed;
            top: 8px;
            left: 5px;
            width: 40px;
            height: 40px;
            padding: 0;
            display: flex;
            justify-content: center;
            align-items: center;
            background: transparent;
            border: none;
            color: #0d6efd;
            font-size: 25px;
            cursor: pointer;
            z-index: 11000;
        }

            .toggle-btn:hover {
                background: transparent;
                color: #0b5ed7;
            }

            .toggle-btn:focus {
                outline: none;
                box-shadow: none;
            }

            .toggle-btn i {
                pointer-events: none;
            }


        /* =====================================================
                   READONLY INPUT
                ====================================================== */

        input[readonly] {
            background-color: #e9ecef !important;
            color: #495057 !important;
            border: 1px solid #ced4da !important;
            cursor: not-allowed;
        }

            input[readonly]:focus {
                box-shadow: none !important;
                outline: none !important;
            }


        /* =====================================================
                   MOBILE

                   IMPORTANT:
                   Mobile portrait + landscape দুই ক্ষেত্রেই
                   sidebar default hidden থাকবে।

                   max-width 768 এর পাশাপাশি touch device
                   detection করা হয়েছে।
                ====================================================== */

        @@media screen and (max-width: 768px), screen and (pointer: coarse) and (hover: none) {

            .sidebar-wrapper {
                width: 250px;
                height: 100vh;
                height: 100dvh;
                position: fixed;
                top: 0;
                left: 0;
                /*
                           MOBILE DEFAULT HIDDEN
                        */
                transform: translateX(-250px) !important;
                z-index: 1050;
                transition: transform 0.3s ease;
            }
                /* =================================================
                       MOBILE OPEN
                    ================================================== */

                .sidebar-wrapper.mobile-open {
                    transform: translateX(0) !important;
                }
            /* =================================================
                       MAIN CONTENT
                    ================================================== */

            .main-content {
                margin-left: 0 !important;
                width: 100% !important;
                min-height: 100vh;
                padding: 15px;
                transition: none;
            }

                .main-content.full {
                    margin-left: 0 !important;
                    width: 100% !important;
                }
            /* =================================================
                       TOGGLE BUTTON
                    ================================================== */

            .toggle-btn {
                position: fixed;
                top: 7px;
                left: 5px;
                width: 40px;
                height: 40px;
                z-index: 11000;
                background: transparent;
                border: none;
                font-size: 25px;
            }
        }


        /* =====================================================
                   SMALL MOBILE
                ====================================================== */

        @@media screen and (max-width: 400px) {

            .sidebar-wrapper {
                width: 240px;
                transform: translateX(-240px) !important;
            }

                .sidebar-wrapper.mobile-open {
                    transform: translateX(0) !important;
                }
        }


        /* =====================================================
                   MOBILE LANDSCAPE

                   IMPORTANT FIX

                   Width 768px ছাড়িয়ে গেলেও touch mobile device
                   হলে sidebar hidden থাকবে।
                ====================================================== */

        @@media screen and (orientation: landscape) and (pointer: coarse) and (hover: none) {

            .sidebar-wrapper {
                width: 240px;
                height: 100vh;
                height: 100dvh;
                position: fixed;
                top: 0;
                left: 0;
                /*
                           LANDSCAPE DEFAULT HIDDEN
                        */
                transform: translateX(-240px) !important;
                z-index: 1050;
                transition: transform 0.3s ease;
            }
                /* =================================================
                       MOBILE LANDSCAPE OPEN
                    ================================================== */

                .sidebar-wrapper.mobile-open {
                    transform: translateX(0) !important;
                }
            /* =================================================
                       MAIN CONTENT
                    ================================================== */

            .main-content {
                margin-left: 0 !important;
                width: 100% !important;
                padding: 12px;
            }
        }


        /* =====================================================
                   VERY SHORT LANDSCAPE
                ====================================================== */

        @@media screen and (orientation: landscape) and (pointer: coarse) and (hover: none) and (max-height: 380px) {

            .sidebar-wrapper {
                width: 235px;
                height: 100vh;
                height: 100dvh;
                transform: translateX(-235px) !important;
            }

                .sidebar-wrapper.mobile-open {
                    transform: translateX(0) !important;
                }

            .main-content {
                padding: 10px;
            }

            .toggle-btn {
                top: 5px;
                left: 4px;
                width: 36px;
                height: 36px;
                font-size: 23px;
            }
        }

    </style>

</head>


<body>


    <!-- =====================================================
         TOGGLE BUTTON
    ====================================================== -->

    <button id="sidebarToggle"
            class="toggle-btn"
            type="button"
            aria-label="Toggle Sidebar">

        <i class="bi bi-list"></i>

    </button>


    <!-- =====================================================
         SIDEBAR
    ====================================================== -->

    <div id="sidebarWrapper"
         class="sidebar-wrapper">

        @await Component.InvokeAsync("Sidebar")

    </div>


    <!-- =====================================================
         MAIN CONTENT
    ====================================================== -->

    <div id="mainContent"
         class="main-content">

        @RenderBody()

    </div>


    <!-- =====================================================
         BOOTSTRAP JS
    ====================================================== -->

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js">
    </script>


    <!-- =====================================================
         SIDEBAR SCRIPT
    ====================================================== -->

    <script>

        document.addEventListener(
            "DOMContentLoaded",
            function () {

                const sidebar =
                    document.getElementById(
                        "sidebarWrapper"
                    );

                const mainContent =
                    document.getElementById(
                        "mainContent"
                    );

                const toggleButton =
                    document.getElementById(
                        "sidebarToggle"
                    );


                if (!sidebar || !toggleButton) {
                    return;
                }


                /* =================================================
                   MOBILE DETECTION

                   শুধু width check করা হচ্ছে না।

                   Mobile landscape-এ width 768px-এর বেশি
                   হলেও touch device detect হবে।
                ================================================== */

                function isMobileDevice() {

                    const smallScreen =
                        window.matchMedia(
                            "(max-width: 768px)"
                        ).matches;


                    const touchDevice =
                        navigator.maxTouchPoints > 0;


                    const coarsePointer =
                        window.matchMedia(
                            "(pointer: coarse)"
                        ).matches;


                    const noHover =
                        window.matchMedia(
                            "(hover: none)"
                        ).matches;


                    return (
                        smallScreen ||
                        (
                            touchDevice &&
                            coarsePointer &&
                            noHover
                        )
                    );
                }


                /* =================================================
                   CLOSE MOBILE SIDEBAR
                ================================================== */

                function closeMobileSidebar() {

                    sidebar.classList.remove(
                        "mobile-open"
                    );

                    sidebar.classList.add(
                        "hidden"
                    );


                    if (mainContent) {

                        mainContent.classList.add(
                            "full"
                        );
                    }
                }


                /* =================================================
                   OPEN MOBILE SIDEBAR
                ================================================== */

                function openMobileSidebar() {

                    sidebar.classList.remove(
                        "hidden"
                    );

                    sidebar.classList.add(
                        "mobile-open"
                    );


                    if (mainContent) {

                        mainContent.classList.add(
                            "full"
                        );
                    }
                }


                /* =================================================
                   DESKTOP STATE
                ================================================== */

                function setDesktopState() {

                    sidebar.classList.remove(
                        "hidden"
                    );

                    sidebar.classList.remove(
                        "mobile-open"
                    );


                    if (mainContent) {

                        mainContent.classList.remove(
                            "full"
                        );
                    }
                }


                /* =================================================
                   INITIAL STATE
                ================================================== */

                function initializeSidebar() {

                    if (isMobileDevice()) {

                        /*
                           MOBILE

                           Portrait:
                           Hidden

                           Landscape:
                           Hidden
                        */

                        closeMobileSidebar();

                    }
                    else {

                        /*
                           DESKTOP

                           Visible
                        */

                        setDesktopState();
                    }
                }


                /* =================================================
                   TOGGLE BUTTON
                ================================================== */

                toggleButton.addEventListener(
                    "click",
                    function () {

                        if (isMobileDevice()) {

                            /*
                               MOBILE
                            */

                            const isOpen =
                                sidebar.classList.contains(
                                    "mobile-open"
                                );


                            if (isOpen) {

                                closeMobileSidebar();

                            }
                            else {

                                openMobileSidebar();

                            }

                        }
                        else {

                            /*
                               DESKTOP
                            */

                            sidebar.classList.toggle(
                                "hidden"
                            );


                            if (mainContent) {

                                mainContent.classList.toggle(
                                    "full"
                                );
                            }
                        }

                    }
                );


                /* =================================================
                   RESIZE / ORIENTATION
                ================================================== */

                let previousMobileState =
                    isMobileDevice();


                let resizeTimer = null;


                window.addEventListener(
                    "resize",
                    function () {

                        clearTimeout(
                            resizeTimer
                        );


                        resizeTimer =
                            setTimeout(
                                function () {

                                    const currentMobileState =
                                        isMobileDevice();


                                    /*
                                       DESKTOP -> MOBILE
                                    */

                                    if (
                                        currentMobileState !==
                                        previousMobileState
                                    ) {

                                        if (
                                            currentMobileState
                                        ) {

                                            /*
                                               Enter Mobile

                                               Always close.
                                            */

                                            closeMobileSidebar();

                                        }
                                        else {

                                            /*
                                               Enter Desktop

                                               Show sidebar.
                                            */

                                            setDesktopState();
                                        }


                                        previousMobileState =
                                            currentMobileState;

                                    }
                                    else {

                                        /*
                                           Mobile orientation
                                           change হলে sidebar
                                           closed রাখবে।
                                        */

                                        if (
                                            currentMobileState
                                        ) {

                                            closeMobileSidebar();

                                        }

                                    }

                                },
                                100
                            );

                    }
                );


                /* =================================================
                   ORIENTATION CHANGE
                ================================================== */

                window.addEventListener(
                    "orientationchange",
                    function () {

                        setTimeout(
                            function () {

                                if (
                                    isMobileDevice()
                                ) {

                                    closeMobileSidebar();

                                }

                            },
                            150
                        );

                    }
                );


                /* =================================================
                   INITIALIZE
                ================================================== */

                initializeSidebar();

            }
        );


        /* =====================================================
           TOASTR
        ====================================================== */

        $(document).ready(function () {

            var successMessage =
                '@(TempData["SuccessMessage"] ?? "")';

            var errorMessage =
                '@(TempData["ErrorMessage"] ?? "")';


            toastr.options = {

                closeButton: true,

                progressBar: true,

                positionClass:
                    "toast-top-right",

                timeOut: 1000
            };


            if (
                successMessage.trim().length > 0
            ) {

                toastr.success(
                    successMessage,
                    "Success"
                );
            }


            if (
                errorMessage.trim().length > 0
            ) {

                toastr.error(
                    errorMessage,
                    "Error"
                );
            }

        });

    </script>


    @RenderSection(
    "Scripts",
        required: false
        )

</body>

</html>
