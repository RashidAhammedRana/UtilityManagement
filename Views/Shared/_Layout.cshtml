<!DOCTYPE html>
<html>

<head>

    <meta name="viewport"
          content="width=device-width, initial-scale=1" />

    <title>@ViewBag.Title</title>


    <!-- =====================================================
         jQuery
    ====================================================== -->

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>


    <!-- =====================================================
         Bootstrap
    ====================================================== -->

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
          rel="stylesheet">


    <!-- =====================================================
         DevExpress WebDocumentViewer
    ====================================================== -->

    <link rel="stylesheet"
          href="~/css/thirdparty.bundle.css" />

    <script src="~/js/thirdparty.bundle.js"></script>


    <!-- =====================================================
         Bootstrap Icons
    ====================================================== -->

    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
          rel="stylesheet">


    <!-- =====================================================
         Toastr
    ====================================================== -->

    <link href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css"
          rel="stylesheet" />

    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js">
    </script>


    <style>

        /* =====================================================
                   GLOBAL
                ====================================================== */

        html,
        body {
            margin: 0;
            padding: 0;
            width: 100%;
            min-height: 100%;
            overflow-x: hidden;
        }

        body {
            background: #f4f6f9;
        }


        /* =====================================================
                   SIDEBAR WRAPPER
                ====================================================== */

        .sidebar-wrapper {
            width: 250px;
            height: 100vh;
            height: 100dvh;
            position: fixed;
            top: 0;
            left: 0;
            z-index: 1050;
            transform: translateX(0);
            transition: transform 0.3s ease;
            overflow: visible;
        }


            /* =====================================================
                   SIDEBAR HIDDEN
                ====================================================== */

            .sidebar-wrapper.hidden {
                transform: translateX(-250px) !important;
            }


        /* =====================================================
                   MAIN CONTENT - DESKTOP
                ====================================================== */

        .main-content {
            margin-left: 250px;
            width: calc(100% - 250px);
            min-height: 100vh;
            padding: 20px;
            box-sizing: border-box;
            transition: margin-left 0.3s ease, width 0.3s ease;
        }


            .main-content.full {
                margin-left: 0 !important;
                width: 100% !important;
            }


        /* =====================================================
                   TOGGLE BUTTON

                   Small + Left aligned
                ====================================================== */

        .toggle-btn {
            position: fixed;
            top: 4px;
            left: 0;
            width: 30px;
            height: 30px;
            padding: 0;
            margin: 0;
            display: flex;
            justify-content: center;
            align-items: center;
            background: transparent;
            border: none;
            color: #0d6efd;
            font-size: 19px;
            line-height: 1;
            cursor: pointer;
            z-index: 11000;
        }


            .toggle-btn:hover {
                background: transparent;
                color: #0b5ed7;
            }


            .toggle-btn:focus,
            .toggle-btn:active {
                outline: none !important;
                box-shadow: none !important;
            }


            .toggle-btn i {
                pointer-events: none;
                line-height: 1;
            }


        /* =====================================================
                   READONLY INPUT
                ====================================================== */

        input[readonly] {
            background-color: #e9ecef !important;
            color: #495057 !important;
            border: 1px solid #ced4da !important;
            cursor: not-allowed;
        }


            input[readonly]:focus {
                box-shadow: none !important;
                outline: none !important;
            }


        /* =====================================================
                   MOBILE

                   Portrait + Landscape

                   Sidebar ALWAYS hidden initially.
                ====================================================== */

        @@media screen and (max-width: 768px), screen and (pointer: coarse) and (hover: none) {
            /* =================================================
                       SIDEBAR
                    ================================================== */

            .sidebar-wrapper {
                width: 250px;
                height: 100vh;
                height: 100dvh;
                position: fixed;
                top: 0;
                left: 0;
                transform: translateX(-250px) !important;
                z-index: 1050;
                transition: transform 0.3s ease;
            }
                /* =================================================
                       MOBILE SIDEBAR OPEN
                    ================================================== */

                .sidebar-wrapper.mobile-open {
                    transform: translateX(0) !important;
                }
            /* =================================================
                       MAIN CONTENT

                       Top padding বাড়ানো হয়েছে যাতে
                       toggle button input-এর উপর না পড়ে।
                    ================================================== */

            .main-content {
                margin-left: 0 !important;
                width: 100% !important;
                min-height: 100vh;
                /*
                           Toggle button থেকে content দূরে থাকবে
                        */
                padding: 45px 15px 15px 15px !important;
                box-sizing: border-box;
                transition: none;
            }


                .main-content.full {
                    margin-left: 0 !important;
                    width: 100% !important;
                }
            /* =================================================
                       TOGGLE BUTTON
                    ================================================== */

            .toggle-btn {
                top: 3px;
                left: 0;
                width: 28px;
                height: 28px;
                padding: 0;
                margin: 0;
                font-size: 18px;
                z-index: 11000;
            }
        }


        /* =====================================================
                   SMALL MOBILE
                ====================================================== */

        @@media screen and (max-width: 400px) {

            .sidebar-wrapper {
                width: 240px;
                transform: translateX(-240px) !important;
            }


                .sidebar-wrapper.mobile-open {
                    transform: translateX(0) !important;
                }


            .main-content {
                padding: 43px 12px 12px 12px !important;
            }


            .toggle-btn {
                top: 2px;
                left: 0;
                width: 26px;
                height: 26px;
                font-size: 17px;
            }
        }


        /* =====================================================
                   MOBILE LANDSCAPE
                ====================================================== */

        @@media screen and (max-width: 768px) and (orientation: landscape) {

            .sidebar-wrapper {
                width: 240px;
                height: 100vh;
                height: 100dvh;
                position: fixed;
                top: 0;
                left: 0;
                /*
                           Landscape-এও DEFAULT HIDDEN
                        */
                transform: translateX(-240px) !important;
                z-index: 1050;
                transition: transform 0.3s ease;
            }


                .sidebar-wrapper.mobile-open {
                    transform: translateX(0) !important;
                }
            /* =================================================
                       LANDSCAPE MAIN CONTENT
                    ================================================== */

            .main-content {
                margin-left: 0 !important;
                width: 100% !important;
                min-height: 100vh;
                /*
                           Button overlap prevent
                        */
                padding: 38px 12px 12px 12px !important;
                box-sizing: border-box;
            }
            /* =================================================
                       LANDSCAPE TOGGLE
                    ================================================== */

            .toggle-btn {
                top: 2px;
                left: 0;
                width: 27px;
                height: 27px;
                font-size: 17px;
            }
        }


        /* =====================================================
                   VERY SHORT MOBILE LANDSCAPE
                ====================================================== */

        @@media screen and (max-width: 768px) and (orientation: landscape) and (max-height: 380px) {

            .sidebar-wrapper {
                width: 235px;
                height: 100vh;
                height: 100dvh;
                transform: translateX(-235px) !important;
            }


                .sidebar-wrapper.mobile-open {
                    transform: translateX(0) !important;
                }


            .main-content {
                padding: 34px 10px 10px 10px !important;
            }


            .toggle-btn {
                top: 1px;
                left: 0;
                width: 25px;
                height: 25px;
                font-size: 16px;
            }
        }


        /* =====================================================
                   TABLET
                ====================================================== */

        @@media screen and (min-width: 769px) and (max-width: 1199px) {

            .main-content {
                padding: 18px;
            }
        }


        /* =====================================================
                   TOUCH DEVICE
                ====================================================== */

        @@media screen and (pointer: coarse) and (hover: none) {

            .toggle-btn {
                touch-action: manipulation;
            }

            .main-content {
                box-sizing: border-box;
            }
        }

    </style>

</head>


<body>


    <!-- =====================================================
         SIDEBAR TOGGLE BUTTON

         Small 3-line icon
         Left aligned
    ====================================================== -->

    <button id="sidebarToggle"
            class="toggle-btn"
            type="button"
            aria-label="Toggle Sidebar"
            aria-controls="sidebarWrapper"
            aria-expanded="false">

        <i class="bi bi-list"></i>

    </button>


    <!-- =====================================================
         SIDEBAR
    ====================================================== -->

    <div id="sidebarWrapper"
         class="sidebar-wrapper">

        @await Component.InvokeAsync("Sidebar")

    </div>


    <!-- =====================================================
         MAIN CONTENT
    ====================================================== -->

    <main id="mainContent"
          class="main-content">

        @RenderBody()

    </main>


    <!-- =====================================================
         BOOTSTRAP JS
    ====================================================== -->

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js">
    </script>


    <!-- =====================================================
         SIDEBAR SCRIPT
    ====================================================== -->

    <script>

        document.addEventListener(
            "DOMContentLoaded",
            function () {

                const sidebar =
                    document.getElementById(
                        "sidebarWrapper"
                    );

                const mainContent =
                    document.getElementById(
                        "mainContent"
                    );

                const toggleButton =
                    document.getElementById(
                        "sidebarToggle"
                    );


                if (!sidebar || !toggleButton) {
                    return;
                }


                /* =================================================
                   MOBILE DETECTION
                ================================================== */

                function isMobileDevice() {

                    const smallScreen =
                        window.matchMedia(
                            "(max-width: 768px)"
                        ).matches;


                    const touchDevice =
                        navigator.maxTouchPoints > 0;


                    const coarsePointer =
                        window.matchMedia(
                            "(pointer: coarse)"
                        ).matches;


                    const noHover =
                        window.matchMedia(
                            "(hover: none)"
                        ).matches;


                    return (
                        smallScreen ||
                        (
                            touchDevice &&
                            coarsePointer &&
                            noHover
                        )
                    );
                }


                /* =================================================
                   CLOSE MOBILE SIDEBAR
                ================================================== */

                function closeMobileSidebar() {

                    sidebar.classList.remove(
                        "mobile-open"
                    );

                    sidebar.classList.add(
                        "hidden"
                    );


                    toggleButton.setAttribute(
                        "aria-expanded",
                        "false"
                    );


                    if (mainContent) {

                        mainContent.classList.add(
                            "full"
                        );
                    }
                }


                /* =================================================
                   OPEN MOBILE SIDEBAR
                ================================================== */

                function openMobileSidebar() {

                    sidebar.classList.remove(
                        "hidden"
                    );

                    sidebar.classList.add(
                        "mobile-open"
                    );


                    toggleButton.setAttribute(
                        "aria-expanded",
                        "true"
                    );


                    if (mainContent) {

                        mainContent.classList.add(
                            "full"
                        );
                    }
                }


                /* =================================================
                   DESKTOP STATE
                ================================================== */

                function setDesktopState() {

                    sidebar.classList.remove(
                        "hidden"
                    );

                    sidebar.classList.remove(
                        "mobile-open"
                    );


                    toggleButton.setAttribute(
                        "aria-expanded",
                        "true"
                    );


                    if (mainContent) {

                        mainContent.classList.remove(
                            "full"
                        );
                    }
                }


                /* =================================================
                   INITIALIZE
                ================================================== */

                function initializeSidebar() {

                    if (isMobileDevice()) {

                        /*
                           MOBILE

                           Portrait:
                           Hidden

                           Landscape:
                           Hidden

                           Touch device:
                           Hidden
                        */

                        closeMobileSidebar();

                    }
                    else {

                        /*
                           DESKTOP

                           Sidebar visible
                        */

                        setDesktopState();
                    }

                }


                /* =================================================
                   TOGGLE BUTTON
                ================================================== */

                toggleButton.addEventListener(
                    "click",
                    function () {

                        if (isMobileDevice()) {

                            /*
                               MOBILE
                            */

                            const isOpen =
                                sidebar.classList.contains(
                                    "mobile-open"
                                );


                            if (isOpen) {

                                closeMobileSidebar();

                            }
                            else {

                                openMobileSidebar();

                            }

                        }
                        else {

                            /*
                               DESKTOP
                            */

                            const isHidden =
                                sidebar.classList.contains(
                                    "hidden"
                                );


                            if (isHidden) {

                                sidebar.classList.remove(
                                    "hidden"
                                );

                                if (mainContent) {

                                    mainContent.classList.remove(
                                        "full"
                                    );
                                }

                                toggleButton.setAttribute(
                                    "aria-expanded",
                                    "true"
                                );

                            }
                            else {

                                sidebar.classList.add(
                                    "hidden"
                                );

                                if (mainContent) {

                                    mainContent.classList.add(
                                        "full"
                                    );
                                }

                                toggleButton.setAttribute(
                                    "aria-expanded",
                                    "false"
                                );

                            }

                        }

                    }
                );


                /* =================================================
                   RESIZE HANDLING
                ================================================== */

                let previousMobileState =
                    isMobileDevice();


                let resizeTimer = null;


                window.addEventListener(
                    "resize",
                    function () {

                        clearTimeout(
                            resizeTimer
                        );


                        resizeTimer =
                            setTimeout(
                                function () {

                                    const currentMobileState =
                                        isMobileDevice();


                                    /*
                                       DESKTOP -> MOBILE
                                    */

                                    if (
                                        currentMobileState !==
                                        previousMobileState
                                    ) {

                                        if (
                                            currentMobileState
                                        ) {

                                            /*
                                               Enter mobile

                                               ALWAYS HIDDEN
                                            */

                                            closeMobileSidebar();

                                        }
                                        else {

                                            /*
                                               Enter desktop

                                               ALWAYS VISIBLE
                                            */

                                            setDesktopState();
                                        }


                                        previousMobileState =
                                            currentMobileState;

                                    }
                                    else {

                                        /*
                                           Orientation change
                                           within mobile

                                           Sidebar stays closed.
                                        */

                                        if (
                                            currentMobileState
                                        ) {

                                            closeMobileSidebar();

                                        }

                                    }

                                },
                                100
                            );

                    }
                );


                /* =================================================
                   ORIENTATION CHANGE
                ================================================== */

                window.addEventListener(
                    "orientationchange",
                    function () {

                        setTimeout(
                            function () {

                                if (
                                    isMobileDevice()
                                ) {

                                    closeMobileSidebar();

                                }

                            },
                            150
                        );

                    }
                );


                /* =================================================
                   INITIALIZE ON PAGE LOAD
                ================================================== */

                initializeSidebar();

            }
        );


        /* =====================================================
           TOASTR
        ====================================================== */

        $(document).ready(function () {

            var successMessage =
                '@(TempData["SuccessMessage"] ?? "")';


            var errorMessage =
                '@(TempData["ErrorMessage"] ?? "")';


            toastr.options = {

                closeButton: true,

                progressBar: true,

                positionClass:
                    "toast-top-right",

                timeOut: 1000

            };


            if (
                successMessage.trim().length > 0
            ) {

                toastr.success(
                    successMessage,
                    "Success"
                );

            }


            if (
                errorMessage.trim().length > 0
            ) {

                toastr.error(
                    errorMessage,
                    "Error"
                );

            }

        });

    </script>


    @RenderSection(
    "Scripts",
        required: false
        )

</body>

</html>
